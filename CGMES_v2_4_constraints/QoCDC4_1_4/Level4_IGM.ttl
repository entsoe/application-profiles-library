@base   <https://ap-con.cim4.eu/QoCDC-Level4-IGM/4.1.4> .
@prefix cim:    <http://iec.ch/TC57/2013/CIM-schema-cim16#> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix dm:     <http://iec.ch/TC57/61970-552/DifferenceModel/1#> .
@prefix entsoe: <http://entsoe.eu/CIM/SchemaExtension/3/1#> .
@prefix l4igm:  <https://ap-con.cim4.eu/QoCDC-Level4-IGM/4.1.4#> .
@prefix md:     <http://iec.ch/TC57/61970-552/ModelDescription/1#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

l4igm:TapChangerTablePoint.ratio-valueRange
        rdf:type         sh:PropertyShape;
        sh:description   "cim:TapChangerTablePoint.ratio shall be a positive value.";
        sh:group         l4igm:Level4-IGM;
        sh:message       "The cim: TapChangerTable [rdf: ID] has a cim: RatioTapChangerTablePoint with negative ratio.";
        sh:minExclusive  "0.0"^^xsd:float;
        sh:name          "InvalidTapChangerRatio";
        sh:order         1;
        sh:path          cim:TapChangerTablePoint.ratio;
        sh:severity      sh:Violation .

l4igm:EQDIFFOperationalLimit-node
        rdf:type             sh:NodeShape;
        sh:property          l4igm:EQDIFFOperationalLimit-property;
        sh:targetSubjectsOf  rdf:type .

l4igm:EQDIFFOperationalLimit-property
        rdf:type        sh:PropertyShape;
        sh:description  "An EQDIFF file is only allowed to contain subclasses of OperationalLimit (cim:VoltageLimit, cim:CurrentLimit, cim:ActivePowerLimit, cim:ApparentPowerLimit). This is a temporary solution for exchange of limit values in EQ that in the future will be in SSH.";
        sh:group        l4igm:Level4-IGM;
        sh:name         "EQDIFFOperationalLimit";
        sh:in           (dm:DifferenceModel cim:VoltageLimit cim:CurrentLimit cim:ActivePowerLimit cim:ApparentPowerLimit);
        sh:message      "Not allowed CIM class in EQDIFF file.";
        sh:order        2;
        sh:path         rdf:type;
        sh:severity     sh:Violation .


l4igm:MAS-IGM  rdf:type  sh:NodeShape;
        sh:property     l4igm:TapChangerTablePoint.ratio-valueRange;
        sh:targetClass  cim:RatioTapChangerTablePoint , cim:PhaseTapChangerTablePoint .

l4igm:Level4-IGM  rdf:type  sh:PropertyGroup;
        rdfs:label  "Level4-IGM";
        sh:order    0 .
