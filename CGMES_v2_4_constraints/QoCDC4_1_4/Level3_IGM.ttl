@base   <https://ap-con.cim4.eu/QoCDC-Level3-IGM/4.1.4> .
@prefix cim:    <http://iec.ch/TC57/2013/CIM-schema-cim16#> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix dm:     <http://iec.ch/TC57/61970-552/DifferenceModel/1#> .
@prefix entsoe: <http://entsoe.eu/CIM/SchemaExtension/3/1#> .
@prefix l3igm:  <https://ap-con.cim4.eu/QoCDC-Level3-IGM/4.1.4#> .
@prefix md:     <http://iec.ch/TC57/61970-552/ModelDescription/1#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

cim:    rdf:type     owl:Ontology;
        owl:imports  sh:;
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://iec.ch/TC57/2013/CIM-schema-cim16#"^^xsd:anyURI;
                       sh:prefix     "cim"
                     ];
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI;
                       sh:prefix     "rdf"
                     ];
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://iec.ch/TC57/61970-552/ModelDescription/1#"^^xsd:anyURI;
                       sh:prefix     "md"
                     ];
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://iec.ch/TC57/61970-552/DifferenceModel/1#"^^xsd:anyURI;
                       sh:prefix     "dm"
                     ];
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI;
                       sh:prefix     "xsd"
                     ];
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://entsoe.eu/CIM/SchemaExtension/3/1#"^^xsd:anyURI;
                       sh:prefix     "entsoe"
                     ] .

l3igm:OperationalLimitSetSeriesCompensator
        rdf:type        sh:NodeShape;
        sh:property     l3igm:OperationalLimitSet-PATL4 , l3igm:SeriesCompensator-operationalLimitSetPATL;
        sh:targetClass  cim:SeriesCompensator .

l3igm:CATieFlow  rdf:type  sh:NodeShape;
        sh:property     l3igm:CATieFlow-requiredTieFlow;
        sh:targetClass  cim:ControlArea .

l3igm:TopologicalNode.fromEndIsoCode-TNFromEndIsoCode
        rdf:type        sh:PropertyShape;
        sh:description  "In a TPBD document attribute value entsoe:TopologicalNode.fromEndIsoCode must be from the country code list – field ‘TsoCodeList’ in the QoCDC Reference Data document which is a subset of https://www.iso.org/iso-3166-country-codes.html.";
        sh:group        l3igm:Level3-IGM;
        sh:in           ( "DZ" "EG" "LY" "KS" "AD" "AL" "AM" "AT" "BA" "BE" "BG" "BY" "HR" "CY" "CZ" "DK" "EE" "FI" "FR" "DE" "GR" "HU" "IS" "IE" "IT" "LV" "LI" "LT" "LU" "MT" "MD" "ME" "NL" "NO" "PL" "PT" "RO" "RS" "SK" "SI" "SM" "ES" "SE" "CH" "TR" "UA" "MK" "GB" "GE" "TN" "MA" "RU" "XK" );
        sh:maxLength    2;
        sh:message      "Country code used that is not in the reference data.";
        sh:minLength    2;
        sh:name         "TNFromEndIsoCode";
        sh:order        3;
        sh:path         entsoe:TopologicalNode.fromEndIsoCode;
        sh:severity     sh:Violation .

l3igm:TopologicalNode.toEndNameTso-TNToEndNameTsoLength
        rdf:type        sh:PropertyShape;
        sh:description  "In every TPBD model instance, the length of all instances of entsoe:TopologicalNode.toEndNameTso shall not exceed 32 characters.";
        sh:group        l3igm:Level3-IGM;
        sh:maxLength    32;
        sh:message      "Length of name attribute exceeds 32 characters.";
        sh:minLength    1;
        sh:name         "TNToEndNameTsoLength";
        sh:order        12;
        sh:path         entsoe:TopologicalNode.toEndNameTso;
        sh:severity     sh:Violation .

l3igm:TopologicalNode.fromEndNameTso-TNFromEndNameTsoLength
        rdf:type        sh:PropertyShape;
        sh:description  "In every TPBD model instance, the length of all instances of entsoe:TopologicalNode.fromEndNameTso shall not exceed 32\tcharacters.";
        sh:group        l3igm:Level3-IGM;
        sh:maxLength    32;
        sh:message      "Length of name attribute exceeds 32 characters.";
        sh:minLength    1;
        sh:name         "TNFromEndNameTsoLength";
        sh:order        10;
        sh:path         entsoe:TopologicalNode.fromEndNameTso;
        sh:severity     sh:Violation .

l3igm:PowerTransformer
        rdf:type        sh:NodeShape;
        sh:property     l3igm:PowerTransformer-containment , l3igm:PowerTransformerEnd.x-PowerTransformerEndX , l3igm:PowerTransformerEnd.r-PowerTransformerEndR , l3igm:PowerTransformer-operationalLimitSetPATL, l3igm:PowerTransformerEnd.b-valueRange ;
        sh:targetClass  cim:PowerTransformer .

l3igm:EquipmentTerminals
        rdf:type        sh:NodeShape;
        sh:property     l3igm:EquipmentTerminals-ps;
        sh:targetClass  cim:ConnectivityNode .

l3igm:BusbarSectionContainment
        rdf:type        sh:NodeShape;
        sh:property     l3igm:BusbarSection-containment;
        sh:targetClass  cim:BusbarSection .

l3igm:StaticVarCompensator.slope-valueRange
        rdf:type         sh:PropertyShape;
        sh:description   "The cim:StaticVarCompensator.slope must be positive or zero.";
        sh:group         l3igm:Level3-IGM;
        sh:message       "cim:StaticVarCompensator.slope is not positive or zero.";
        sh:minInclusive  "0.0"^^xsd:float;
        sh:name          "SVCSlope";
        sh:order         80;
        sh:path          cim:StaticVarCompensator.slope;
        sh:severity      sh:Violation .

l3igm:OperationalLimitType
        rdf:type        sh:NodeShape;
        sh:property     l3igm:OperationalLimitType.direction-FlowLimitsDirectionConsistency;
        sh:targetClass  cim:CurrentLimit , cim:ApparentPowerLimit , cim:ActivePowerLimit .

l3igm:OperationalLimitType-durationNS
        rdf:type        sh:NodeShape;
        sh:property     l3igm:OperationalLimitType.acceptableDuration-usage ;
        sh:targetClass  cim:OperationalLimitType .

l3igm:RatioPhaseTapChangerTable-TablePointOutsideTapChangerLimits
        rdf:type        sh:PropertyShape;
        sh:description  "For every cim:RatioTapChangerTable and cim:PhaseTapChangerTable, all the associated cim:TapChangerTablePoint (cim:RatioTapChangerTablePoint, cim:PhaseTapChangerTablePoint) shall have cim:TapChangerTablePoint.step defined within limits of corresponding cim:TapChanger (cim:RatioTapChanger, cim:PhaseTapChangerTabular) [cim:TapChanger.lowStep; cim:TapChanger.highStep].";
        sh:group        l3igm:Level3-IGM;
        sh:name         "TablePointOutsideTapChangerLimits";
        sh:order        119;
        sh:path         rdf:type;
        sh:severity     sh:Violation;
        sh:sparql       l3igm:RatioPhaseTapChangerTable-TablePointOutsideTapChangerLimitsSparql .

l3igm:Junction  rdf:type  sh:NodeShape;
        sh:property     l3igm:JunctionContainment;
        sh:targetClass  cim:Junction .

l3igm:EquivalentBranch.r-AsymmetricalEquivalent
        rdf:type        sh:PropertyShape;
        sh:description  " cim: EquivalentBranch with EquivalentBranch. r not equal to EquivalentBranch. r21 or EquivalentBranch. x not equal to EquivalentBranch. x21 should not be used.";
        sh:group        l3igm:Level3-IGM;
        sh:name         "AsymmetricalEquivalent";
        sh:order        108;
        sh:path         rdf:type;
        sh:severity     sh:Warning;
        sh:sparql       l3igm:EquivalentBranch.r-AsymmetricalEquivalentSparql .

l3igm:TNISOname  rdf:type  sh:NodeShape;
        sh:property     l3igm:TopologicalNode.fromEndIsoCode-TNFromEndIsoCode , l3igm:TopologicalNode.toEndIsoCode-TNToEndIsoCode , l3igm:TopologicalNode.fromEndName-TNFromEndNameLength , l3igm:TopologicalNode.toEndName-TNToEndNameLength , l3igm:TopologicalNode.fromEndNameTso-TNFromEndNameTsoLength , l3igm:TopologicalNode.toEndNameTso-TNToEndNameTsoLength , l3igm:TopologicalNode-TNnotInIsland;
        sh:targetClass  cim:TopologicalNode .

l3igm:SwitchContainment
        rdf:type        sh:NodeShape;
        sh:property     l3igm:Switch-containment;
        sh:targetClass  cim:Disconnector , cim:GroundDisconnector , cim:Switch , cim:Breaker , cim:LoadBreakSwitch .

l3igm:LoadResponseCharacteristic-LCRCoefficientModelSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "Coefficients for ZIP load model is not specified but cim: LoadResponseCharacteristic. exponentModel is false.";
        sh:prefixes  cim:;
        sh:select    """
			SELECT  $this
			WHERE {
        $this $PATH false .
        
        OPTIONAL {$this cim:LoadResponseCharacteristic.pConstantCurrent ?pcc }.
        OPTIONAL {$this cim:LoadResponseCharacteristic.pConstantImpedance ?pci }.
        OPTIONAL {$this cim:LoadResponseCharacteristic.pConstantPower ?pcp }.
        OPTIONAL {$this cim:LoadResponseCharacteristic.qConstantCurrent ?qcc }.
        OPTIONAL {$this cim:LoadResponseCharacteristic.qConstantImpedance ?qci }.
        OPTIONAL {$this cim:LoadResponseCharacteristic.qConstantPower ?qcp }.
 
        FILTER (!bound(?pcc) || !bound(?pci) || !bound(?pcp) || !bound(?qcc) || !bound(?qci) || !bound(?qcp) ) .
			}""" .

l3igm:EnergySource-EnergySourcePQ
        rdf:type        sh:NodeShape;
        sh:and          ( [ sh:maxCount  0;
                            sh:minCount  0;
                            sh:path      cim:EnergySource.voltageMagnitude
                          ]
                          [ sh:maxCount  0;
                            sh:minCount  0;
                            sh:path      cim:EnergySource.voltageAngle
                          ]
                        );
        sh:description  "For cim:EnergySource the attributes voltageMagnitude and voltageAngle\tare optional to include in EQ. The attributes are intended for the case when a strong network is providing power to a weak distribution network. Hence it is wrong to use these attributes in transmission studies and they shall not at all be used.";
        sh:group        l3igm:Level3-IGM;
        sh:message      "cim:EnergySource.voltageMagnitude and/or cim:EnergySource.voltageAngle are present.";
        sh:name         "EnergySourceVoltage";
        sh:order        60;
        sh:severity     sh:Violation;
        sh:targetClass  cim:EnergySource .

l3igm:DCEQ-containment
        rdf:type        sh:PropertyShape;
        sh:class        cim:DCConverterUnit;
        sh:description  "For every instance of cim:DCSeriesDevice, cim:DCShunt, cim:DCBusbar, cim:DCGround, cim:DCChopper, cim:DCSwitch, cim:DCBreaker and cim:DCDisconnector, the cim:Equipment.EquipmentContainer referred to, must be of type cim:DCConverterUnit. Missing containment is not allowed.";
        sh:group        l3igm:Level3-IGM;
        sh:maxCount     1;
        sh:message      "A DC equipment is not contained in a cim:DCConverterUnit.";
        sh:minCount     1;
        sh:name         "DCEQContainment";
        sh:order        124;
        sh:path         cim:Equipment.EquipmentContainer;
        sh:severity     sh:Violation .

l3igm:EquivalentBranch
        rdf:type        sh:NodeShape;
        sh:property     l3igm:EquivalentBranch-EquivalentBranchX , l3igm:EquivalentBranch.r-AsymmetricalEquivalent , l3igm:EquivalentBranch.x-AsymmetricalEquivalent;
        sh:targetClass  cim:EquivalentBranch .

l3igm:LimitKind.patl-numberOfLimitTypeActivePowerLimitSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "Redundant PATL is present for a OperationalLimitSet.";
        sh:prefixes  cim:;
        sh:select    """
			SELECT  $this (COUNT(?ol) AS ?patls) ?value
			WHERE {      
#       $this ^cim:OperationalLimit.OperationalLimitSet/cim:OperationalLimit.OperationalLimitType/entsoe:OperationalLimitType.limitType entsoe:LimitTypeKind.patl .
		$this entsoe:OperationalLimitType.limitType entsoe:LimitTypeKind.patl .
        $this ^cim:OperationalLimit.OperationalLimitType ?ol .
        ?ol  rdf:type ?typeol .
        ?ol cim:OperationalLimit.OperationalLimitSet ?value .
        FILTER (?typeol IN (cim:ActivePowerLimit)) .
			}
      GROUP BY $this ?value
      HAVING (?patls>1)
      """ .

l3igm:TerminalSeqNum  rdf:type  sh:NodeShape;
        sh:property     l3igm:Terminal-TerminalSeqNum;
        sh:targetClass  cim:EquivalentBranch , cim:ACLineSegment .

l3igm:RatioPhaseTapChangerTable-TablePointOutsideTapChangerLimitsSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "cim:TapChangerTablePoint.step is outside [cim:TapChanger.lowStep; cim:TapChanger.highStep] of either cim:RatioTapChanger or cim:PhaseTapChangerTabular.";
        sh:prefixes  cim:;
        sh:select    """
	      SELECT $this ?value ?lowStep ?highStep
        WHERE {
          $this (^cim:RatioTapChanger.RatioTapChangerTable)|(^cim:PhaseTapChangerTabular.PhaseTapChangerTable) ?tc.
          ?tc cim:TapChanger.lowStep ?lowStep.
          ?tc cim:TapChanger.highStep ?highStep.
          $this ^cim:RatioTapChangerTablePoint.RatioTapChangerTable|^cim:PhaseTapChangerTablePoint.PhaseTapChangerTable ?tablePoint.
          ?tablePoint cim:TapChangerTablePoint.step ?value .

         FILTER (?value<?lowStep || ?value>?highStep).
        } """ .

l3igm:StaticVarCompensator-controlModeSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "cim:TapChangerControl or cim:RegulatingControl with invalid cim:RegulatingControl.mode.";
        sh:prefixes  cim:;
        sh:select    """
	      SELECT $this ?value 
        WHERE {
        $this cim:RegulatingCondEq.RegulatingControl/cim:RegulatingControl.mode ?value .
		FILTER ((?value!=cim:RegulatingControlModeKind.reactivePower && ?value!=cim:RegulatingControlModeKind.voltage) ).
        }""" .

l3igm:BusbarSection-controlModeSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "cim:TapChangerControl or cim:RegulatingControl with invalid cim:RegulatingControl.mode.";
        sh:prefixes  cim:;
        sh:select    """
	      SELECT $this ?value 
        WHERE {
        $this cim:RegulatingCondEq.RegulatingControl/cim:RegulatingControl.mode ?value .
        
        FILTER (?value!=cim:RegulatingControlModeKind.voltage).
        }""" .

l3igm:GeneratingUnit-GeneratingUnitSM
        rdf:type        sh:PropertyShape;
        sh:description  "A cim:GeneratingUnit or any of its subclasses is not allowed to have more than one cim:RotatingMachine.";
        sh:group        l3igm:Level3-IGM;
        sh:name         "GeneratingUnitSM";
        sh:order        113;
        sh:path         rdf:type;
        sh:severity     sh:Violation;
        sh:sparql       l3igm:GeneratingUnit-GeneratingUnitSMSparql .

l3igm:SubstationCountShape
       a sh:NodeShape ;
       sh:property   l3igm:Substation-count;
       sh:targetNode  cim:SubstationCount.

l3igm:Substation-count
        rdf:type         sh:PropertyShape ;
        sh:sparql        l3igm:Substation-countSparql ;
        sh:path         rdf:type ;
        sh:description  "An IGM should normally have a site with one or multiple substations. Each substation has its own voltage levels. Therefore, the number of cim:VoltageLevel objects should be greater than the number of cim:Substation objects. The number of cim:VoltageLevel objects could equal to the number of cim:Substation objects if there are less than 30 cim:Substation objects." ;
        sh:name         "NumberOfSubstations" ;
        sh:group        l3igm:Level3-IGM ;
        sh:order        14 ;
        sh:severity     sh:Warning .


l3igm:Substation-countSparql
		rdf:type    sh:SPARQLConstraint ;
		sh:message "The number of cim:Substation objects is outside defined limitations. Number of Substation-s: {?substations}. Number of VoltageLevel-s: {?voltagelevels}." ;
		sh:prefixes cim: ;
		sh:select """
	      SELECT $this  ?substations ?voltagelevels
        WHERE {
        {
          SELECT $this (COUNT(?ss) AS ?substations)
          WHERE {
            ?ss rdf:type cim:Substation .
          }
          GROUP BY $this
        }
        {
          SELECT $this (COUNT(?vl) AS ?voltagelevels)
          WHERE {
            ?vl rdf:type cim:VoltageLevel .
          }
          GROUP BY $this
        }

        FILTER ((?substations<30 && ?substations > ?voltagelevels) ||
                (?substations>=30 && ?substations >= ?voltagelevels)).
        }""" .

l3igm:PowerTransformer-TooManyTapChangersSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "More than allowed cim:TapChanger objects at a cim:PowerTransformerEnd or the two cim:TapChanger objects are regulating.";
        sh:prefixes  cim:;
        sh:select    """
            SELECT DISTINCT $this
            WHERE {
                {
                  SELECT $this (COUNT(?tc) AS ?tcCount)
                  WHERE {
                    $this (^cim:RatioTapChanger.TransformerEnd)|(^cim:PhaseTapChanger.TransformerEnd) ?tc.
                  }
                  GROUP BY $this
                }
                
                # Get the type of tap changers
                $this (^cim:RatioTapChanger.TransformerEnd)|(^cim:PhaseTapChanger.TransformerEnd) ?tc.
                ?tc rdf:type ?tctype .
                
                # Check if both are ratio tap changers (not allowed)
                BIND(EXISTS{$this ^cim:RatioTapChanger.TransformerEnd ?rtc1.
                            $this ^cim:RatioTapChanger.TransformerEnd ?rtc2.
                            FILTER(?rtc1 != ?rtc2)} AS ?twoRatio)
                
                # Check if both are phase tap changers (not allowed)
                BIND(EXISTS{$this ^cim:PhaseTapChanger.TransformerEnd ?ptc1.
                            $this ^cim:PhaseTapChanger.TransformerEnd ?ptc2.
                            FILTER(?ptc1 != ?ptc2)} AS ?twoPhase)
                
                # Check if both tap changers are regulating (when there are exactly 2)
                BIND(EXISTS{
                    $this ^cim:RatioTapChanger.TransformerEnd ?tcc1.
                    $this ^cim:PhaseTapChanger.TransformerEnd ?tcc2.
                    ?tcc1 cim:TapChanger.TapChangerControl/cim:RegulatingControl.enabled true.
                    ?tcc2 cim:TapChanger.TapChangerControl/cim:RegulatingControl.enabled true.
                    ?tcc1 cim:TapChanger.controlEnabled true.
                    ?tcc2 cim:TapChanger.controlEnabled true.
                } AS ?bothRegulating)
                
                FILTER (?tcCount > 2 || ?twoRatio || ?twoPhase || (?tcCount = 2 && ?bothRegulating))
            }
            """ .

