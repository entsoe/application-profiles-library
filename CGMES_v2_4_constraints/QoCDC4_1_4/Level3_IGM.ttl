        sh:path          cim:ACLineSegment.x;
        sh:severity      sh:Info .

l3igm:ConnectivityNode.toEndName-CNToEndNameLength
        rdf:type        sh:PropertyShape;
        sh:description  "In every EQBD model instance, the length of all instances of entsoe:ConnectivityNode.toEndName shall not exceed 32\tcharacters.";
        sh:group        l3igm:Level3-IGM;
        sh:maxLength    32;
        sh:message      "Length of name attribute exceeds 32 characters.";
        sh:minLength    1;
        sh:name         "CNToEndNameLength";
        sh:order        7;
        sh:path         entsoe:ConnectivityNode.toEndName;
        sh:severity     sh:Violation .

l3igm:EquivalentBranch.r-AsymmetricalEquivalentSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "cim:EquivalentBranch with asymmetrical impedances.";
        sh:prefixes  cim:;
        sh:select    """
	      SELECT $this   
        WHERE {
          $this cim:EquivalentBranch.r ?r .
          $this cim:EquivalentBranch.r21 ?r21 .
          FILTER (?r21!=?r).
        }
        """ .

l3igm:Terminal.phases-phaseCodeN
        rdf:type        sh:PropertyShape;
        sh:description  "Multiple cim:ConductingEquipment-s are typically connected to the same cim:TopologicalNode via their cim:Terminal-s. The phase codes of the cim:Terminal-s of the following grounding equipment shall be N:- cim:PetersenCoil\t- cim:Ground\t- cim:GroundingImpedance Note that cim:GroundDisconnector will have phase code N at the two sides.";
        sh:group        l3igm:Level3-IGM;
        sh:in           ( cim:PhaseCode.N );
        sh:message      "Grounding equipment does not have phase code N.";
        sh:name         "PhaseCodeGround";
        sh:order        98;
        sh:path         ( [ sh:inversePath  cim:Terminal.ConductingEquipment ]
                          cim:Terminal.phases
                        );
        sh:severity     sh:Violation .

l3igm:OperationalLimitType.acceptableDuration-usageSparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "cim:OperationalLimitType.acceptableDuration is not provided for TATL and TCT limit types.";
        sh:prefixes  cim:;
        sh:select    """
			SELECT  $this
			WHERE {
		$this entsoe:OperationalLimitType.limitType ?type .
        BIND(EXISTS{$this $PATH ?value } AS ?hasvalue).
        
        FILTER (?hasvalue=false && ?type IN (entsoe:LimitTypeKind.tatl, entsoe:LimitTypeKind.tct ) ) .
			}""" .

