        sh:group        l3igm:Level3-IGM;
        sh:in           ( cim:Substation cim:DCConverterUnit );
        sh:maxCount     1;
        sh:message      "A cim:PowerTransformer is not contained in either a cim:Substation or a cim:DCConverterUnit.";
