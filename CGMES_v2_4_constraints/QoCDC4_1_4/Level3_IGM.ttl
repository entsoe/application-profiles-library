        sh:targetClass  cim:RegulatingControl .

l3igm:ConnectivityNode.fromEndIsoCode-CNFromEndIsoCode
        rdf:type        sh:PropertyShape;
        sh:description  "In an EQBD document attribute value entsoe:ConnectivityNode.fromEndIsoCode\tmust be from the country code list – field ‘TsoCodeList’ in the QoCDC Reference Data document which is a subset of https://www.iso.org/iso-3166-country-codes.html.";
        sh:group        l3igm:Level3-IGM;
        sh:in           ( "DZ" "EG" "LY" "KS" "AD" "AL" "AM" "AT" "BA" "BE" "BG" "BY" "HR" "CY" "CZ" "DK" "EE" "FI" "FR" "DE" "GR" "HU" "IS" "IE" "IT" "LV" "LI" "LT" "LU" "MT" "MD" "ME" "NL" "NO" "PL" "PT" "RO" "RS" "SK" "SI" "SM" "ES" "SE" "CH" "TR" "UA" "MK" "GB" "GE" "TN" "MA" "RU" "XK" );
        sh:maxLength    2;
        sh:message      "Country code used that is not in the reference data.";
        sh:minLength    2;
        sh:name         "CNFromEndIsoCode";
        sh:order        1;
        sh:path         entsoe:ConnectivityNode.fromEndIsoCode;
        sh:severity     sh:Violation .

