l3igm:RotatingMachine.ratedS-required
        rdf:type         sh:PropertyShape;
        sh:description   "cim:RotatingMachine.ratedS is required and shall be greater than zero.\tcim:PowerTransfomerEnd.ratedS is required and shall be greater than zero.";
        sh:group         l3igm:Level3-IGM;
        sh:maxCount      1;
        sh:message       "cim:RotatingMachine.ratedS or cim:PowerTransfomerEnd.ratedS is either not provided or it is zero.";
