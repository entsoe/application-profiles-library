l3dcigm:ACDCConverter-containment
        a               sh:PropertyShape ;
        sh:class        cim:DCConverterUnit ;
        sh:description  "For ACDCConverter (CsConverter, VsConverter) the association Equipment.EquipmentContainer is required and shall point to DCEquipmentContainer of type DCConverterUnit. In this case the association DCConverterUnit.Substation is required." ;
        sh:message      "The containment is either missing or it is not DCConverterUnit." ;
        sh:name         "C:452:EQ:ACDCConverter:containment" ;
        sh:path         cim:Equipment.EquipmentContainer;
        sh:maxCount     1 ;
        sh:minCount     1 ;
        sh:order        28 ;
        sh:group        l3dcigm:Level3-DCIGM ;
        sh:severity     sh:Violation .  

l3dcigm:DCConverterUnit.Substation-containment
        a               sh:PropertyShape ;
        sh:in           (cim:Substation) ;
        sh:description  "For ACDCConverter (CsConverter, VsConverter) the association Equipment.EquipmentContainer is required and shall point to DCEquipmentContainer of type DCConverterUnit. In this case the association DCConverterUnit.Substation is required." ;
        sh:message      "The DCConverterUnit.Substation association is either missing or not pointing to a Substation." ;
        sh:name         "C:452:EQ:ACDCConverter:containment" ;
        sh:path         (cim:Equipment.EquipmentContainer cim:DCConverterUnit.Substation rdf:type) ;
        sh:maxCount     1 ;
        sh:minCount     1 ;
        sh:order        29 ;
        sh:group        l3dcigm:Level3-DCIGM ;
        sh:severity     sh:Violation .    

l3dcigm:VsCapabilityCurve-yvalues
        a               sh:PropertyShape ;
        sh:sparql       l3dcigm:VsCapabilityCurve-yvaluesSparql ;
        sh:path         rdf:type ;
        sh:description  "If CurveData.Curve is a VsCapabilityCurve, the CurveData.y2value shall be greater than CurveData.y1value." ;
        sh:name         "C:452:EQ:CurveData.Curve:VsCapabilityCurve" ;
        sh:group        l3dcigm:Level3-DCIGM ;
        sh:order        14 ;
        sh:severity     sh:Violation .

l3dcigm:VsCapabilityCurve-yvaluesSparql
		a         sh:SPARQLConstraint ;  
		sh:message "CurveData.y2value is not greater than CurveData.y1value" ;
		sh:prefixes cim: ;
		sh:select """
	      SELECT $this 
        WHERE {
        ?curvedata cim:CurveData.Curve $this .
        ?curvedata cim:CurveData.y1value ?y1value .
        ?curvedata cim:CurveData.y2value ?y2value .
        FILTER (?y2value<=?y1value).
        }""" .  

l3dcigm:VsCapabilityCurve-VsCapabilityCurveCount
        a               sh:PropertyShape ;
        sh:sparql       l3dcigm:VsCapabilityCurve-VsCapabilityCurveCountSparql ;
        sh:path         rdf:type ;
        sh:description  "If CurveData.Curve is a VsCapabilityCurve at least two CurveData shall be associated." ;
        sh:name         "C:452:EQ:CurveData.Curve:VsCapabilityCurveCount" ;
        sh:group        l3dcigm:Level3-DCIGM ;
        sh:order        12 ;
        sh:severity     sh:Violation .

l3dcigm:VsCapabilityCurve-VsCapabilityCurveCountSparql
		a         sh:SPARQLConstraint ;  
		sh:message "Less than two instances of CurveData are associated." ;
		sh:prefixes cim: ;
		sh:select """
	      SELECT $this (COUNT(?typecd) AS ?curvedatas)
        WHERE {
        ?curvedata cim:CurveData.Curve $this .
        ?curvedata rdf:type ?typecd .
        }
        GROUP BY $this ?typecd
        HAVING(?curvedatas<2)
      """ .  

l3dcigm:CsConverter.minAlpha-valueRangeTypical
        a                    sh:PropertyShape ;
        sh:description       "The attributes minAlpha and maxAlpha define the range of firing angles for rectifier operation between which no discrete tap changer action takes place. The range is typically 10-18 degrees." ;
        sh:group             l3dcigm:Level3-DCIGM ;
        sh:sparql            l3dcigm:CsConverter.minAlpha-valueRangeTypicalSparql ;
        sh:name              "C:301:EQ:CsConverter.minAlpha:valueRangeTypical" ;
        sh:order             18 ;
        sh:path              cim:CsConverter.minAlpha ;
        sh:severity          sh:Warning .

l3dcigm:CsConverter.minAlpha-valueRangeTypicalSparql
		a         sh:SPARQLConstraint ;
    sh:message           "The value is less than 10 or greater than CsConverter.maxAlpha." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this ?value
			WHERE {
        $this cim:CsConverter.operatingMode cim:CsOperatingModeKind.rectifier .
        $this $PATH ?value .
        OPTIONAL {$this cim:CsConverter.maxAlpha ?maxalpha} .
        FILTER (?value<10 || ?value>?maxalpha) .
			}""" .


l3dcigm:CsConverter.minGamma-valueRangeTypical
        a                    sh:PropertyShape ;
        sh:description       "The attributes minGamma and maxGamma define the range of extinction angles for inverter operation between which no discrete tap changer action takes place. The range is typically 17-20 degrees." ;
        sh:group             l3dcigm:Level3-DCIGM ;
        sh:sparql            l3dcigm:CsConverter.minGamma-valueRangeTypicalSparql ;
        sh:name              "C:301:EQ:CsConverter.minGamma:valueRangeTypical" ;
        sh:order             20 ;
        sh:path              cim:CsConverter.minGamma ;
        sh:severity          sh:Warning .

l3dcigm:CsConverter.minGamma-valueRangeTypicalSparql
		a         sh:SPARQLConstraint ;
    sh:message           "The value is less than 17 or greater than CsConverter.maxGamma." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this ?value
			WHERE {
        $this cim:CsConverter.operatingMode cim:CsOperatingModeKind.inverter .
        $this $PATH ?value .
        OPTIONAL {$this cim:CsConverter.maxGamma ?maxgamma} .
        FILTER (?value<17 || ?value>?maxgamma) .
			}""" .

l3dcigm:CsConverter.targetAlpha-valueRangePairFrom
        a                    sh:PropertyShape ;
        sh:description       "Allowed values are within the range minAlpha<=targetAlpha<=maxAlpha." ;
        sh:group             l3dcigm:Level3-DCIGM ;
        sh:lessThanOrEquals  cim:CsConverter.maxAlpha ;
        sh:message           "The value is greater than CsConverter.maxAlpha." ;
        sh:name              "C:301:SSH:CsConverter.targetAlpha:valueRangePairFrom" ;
        sh:order             2 ;
        sh:path              cim:CsConverter.targetAlpha ;
        sh:severity          sh:Violation .


l3dcigm:CsConverter.targetGamma-valueRangePairFrom
        a                    sh:PropertyShape ;
        sh:description       "Allowed values are within the range minGamma<=targetGamma<=maxGamma. " ;
        sh:group             l3dcigm:Level3-DCIGM ;
        sh:lessThanOrEquals  cim:CsConverter.maxGamma ;
        sh:message           "The value is greater than CsConverter.maxGamma." ;
        sh:name              "C:301:SSH:CsConverter.targetGamma:valueRangePairFrom" ;
        sh:order             4 ;
        sh:path              cim:CsConverter.targetGamma ;
        sh:severity          sh:Violation .

l3dcigm:DCboundary
    a               sh:NodeShape ;
    sh:name         "DCboundary" ;
    sh:description  "An IGM representing DC MAS shall have connection to even number of ConnectivityNode objects that are designated as BoundaryPoint. The minimum is connection to two BoundaryPoint objects." ;
    sh:targetNode   md:Dummy;
    sh:severity     sh:Violation ;
    sh:group        l3dcigm:Level3-DCIGM ;
    sh:order        6 ;
    sh:sparql       [
        a               sh:SPARQLConstraint ;
        sh:message      "DC IGM must connect to an even number of Boundary Points (minimum 2). Found {?ctn} connected boundary point(s): {?bpList}" ;
        sh:prefixes     cim: ;
        sh:select       """
            SELECT $this (COUNT(DISTINCT ?bp) AS ?ctn) (GROUP_CONCAT(DISTINCT ?bp; separator=", ") AS ?bpList)
            WHERE {
                ?bp entsoe:ConnectivityNode.boundaryPoint|entsoe:TopologicalNode.boundaryPoint true .

                # Check connection via Terminal to ACLineSegment
                ?terminal cim:Terminal.TopologicalNode|cim:Terminal.ConnectivityNode ?bp .
                ?terminal cim:Terminal.ConductingEquipment ?line .
                ?line rdf:type cim:ACLineSegment .
            }
            GROUP BY $this
            HAVING (?ctn < 2 || floor(?ctn/2) * 2 != ?ctn)
            """
    ] .

l3dcigm:DCEquipmentContainerMapping
    a               sh:NodeShape ;
    sh:property     l3dcigm:DCEquipmentContainerMapping-ps ;
    sh:targetClass  cim:DCConverterUnit , cim:DCLine
    .

l3dcigm:DCEquipmentContainerMapping-ps
    a               sh:PropertyShape ;
    sh:name         "DCEquipmentContainerMapping" ;
    sh:description  "For each cim:DCConverterUnit and cim:DCLine instance the attribute entsoe:IdentifiedObject.energyIdentCodeEic is required. The third character of the EIC code shall be 'T'." ;
    sh:group        l3dcigm:Level3-DCIGM ;
    sh:minCount     1 ;
    sh:maxCount     1 ;
    sh:order        3 ;
    sh:severity     sh:Violation ;
    sh:path         entsoe:IdentifiedObject.energyIdentCodeEic ;
    sh:sparql       l3dcigm:DCEquipmentContainerMappingSparql .

l3dcigm:DCEquipmentContainerMappingSparql
    a          sh:SPARQLConstraint ;
    sh:message "EIC code for cim:DCConverterUnit or cim:DCLine is either not provided or it is not a 'T' code." ;
    sh:prefixes cim:   ;
    sh:select """
        SELECT $this ?value
        WHERE {
          $this $PATH ?value .
          FILTER ((SUBSTR(?value, 3, 1)!="T" && STRLEN(?value)>=3) || STRLEN(?value)<3).
            }""" .




l3dcigm:DcIGMControlArea-count
    a               sh:NodeShape ;
    sh:property     l3dcigm:DcIGMControlArea-countPS ;
    sh:targetNode  cim:ControlArea
    .

l3dcigm:DcIGMControlArea-countPS
    a               sh:PropertyShape ;
    sh:name         "DcIGMControlAreaCount" ;
    sh:description  "A DC IGM shall have exactly one cim:ControlArea defined." ;
    sh:group        l3dcigm:Level3-DCIGM ;
    sh:minCount     1 ;
    sh:maxCount     1 ;
    sh:order        3 ;
    sh:severity     sh:Violation ;
    sh:path         [ sh:inversePath  rdf:type ]  
    .

l3dcigm:DcIGMControlArea
    a               sh:NodeShape ;
    sh:property     l3dcigm:DcIGMControlArea-ControlArea ;
    sh:targetClass  cim:ControlArea
    .

l3dcigm:DcIGMControlArea-ControlArea
    a               sh:PropertyShape ;
    sh:description  "A DC IGM shall have a cim:ControlArea with an entsoe:IdentifiedObject.energyIdentCodeEic which shall be one of the codes defined in the QoCDC Reference Data document in column “RegionEic” representing the Virtual Scheduling Area (VSA) and the HVDC Link losses (sum of the losses for the HVDC Poles in the HVDC Link)." ;
    sh:message      "A DC IGM either without a cim:ControlArea defined or the EIC is not matching the VirtualScheduling Area." ;
    sh:path         entsoe:IdentifiedObject.energyIdentCodeEic ;
    sh:in           ( "10Y1001C--00037Z" "10YDK-1--------W" "10YDK-2--------M" "10Y1001A1001A016" "10Y1001A1001A39I" "10Y1001A1001A49F" "10Y1001A1001A50U" "10Y1001A1001A51S" "10Y1001A1001A65H" "10Y1001C--00100H" "10YAL-KESH-----5" "10YAT-APG------L" "10YBA-JPCC-----D" "10YBE----------2" "10YCA-BULGARIA-R" "10YCH-SWISSGRIDZ" "10YCS-CG-TSO---S" "10YCS-SERBIATSOV" "10YCZ-CEPS-----N" "10YDE-ENBW-----N" "10YDE-EON------1" "10YDE-RWENET---I" "10YDE-VE-------2" "10YES-REE------0" "10YFI-1--------U" "10YFR-RTE------C" "10YGB----------A" "10YGR-HTSO-----Y" "10YHR-HEP------M" "10YHU-MAVIR----U" "10YIE-1001A00010" "10YIT-GRTN-----B" "10YLT-1001A0008Q" "10YLU-CEGEDEL-NQ" "10YLV-1001A00074" "10YMK-MEPSO----8" "10YNL----------L" "10YNO-0--------C" "10YPL-AREA-----S" "10YPT-REN------W" "10YRO-TEL------P" "10YSE-1--------K" "10YSI-ELES-----O" "10YSK-SEPS-----K" "10YTR-TEIAS----W" "10YUA-WEPS-----0" "10YMA-ONE------O" "10Y1001A1001A59C" "10Y1001A1001A91G" "10Y1001A1001A92E" "10Y1001A1001A94A" "10YEU-CONT-SYNC0") ;
    sh:name         "DcIGMControlArea" ;
    sh:group        l3dcigm:Level3-DCIGM ;
    sh:order        3 ;
    sh:severity     sh:Violation .


l3dcigm:DcIGMControlAreaForecast
    a               sh:NodeShape ;
    sh:property     l3dcigm:DcIGMControlAreaForecast-ps ;
    sh:targetClass  cim:ControlArea
    .

l3dcigm:DcIGMControlAreaForecast-ps
    a               sh:PropertyShape ;
    sh:name         "DcIGMControlAreaForecast" ;
    sh:description  "The cim:ControlArea in a DC IGM shall have the type set to Forecast. This is an identification of a VSA and is a temporary solution." ;
    sh:group        l3dcigm:Level3-DCIGM ;
    sh:in           (cim:ControlAreaTypeKind.Forecast) ;
    sh:order        3 ;
    sh:severity     sh:Violation ;
    sh:path         cim:ControlArea.type ;
    sh:message      "The cim:ControlArea in a DC IGM does not have the type set to Forecast."  .

l3dcigm:NumberOfValves-ps
    a               sh:PropertyShape ;
    sh:name         "NumberOfValves" ;
    sh:description  "cim:ACDCConverter.numberOfValves shall be a number divisible by 3. Note the value is 6 for a 6-pulse and 12 for a 12-pulse ACDCConverter." ;
    sh:group        l3dcigm:Level3-DCIGM ;
    sh:order        3 ;
    sh:severity     sh:Violation ;
    sh:path         cim:ACDCConverter.numberOfValves ;
    sh:sparql       l3dcigm:NumberOfValvesSparql   .

l3dcigm:NumberOfValvesSparql
    a          sh:SPARQLConstraint ;
    sh:message "The value of cim:ACDCConverter.numberOfValves is not divisible by 3." ;
    sh:prefixes cim:  ;
    sh:select """
        SELECT $this ?value
        WHERE {
          $this $PATH ?value .
          FILTER(floor(?value / 3)*3 != ?value).
        }""".

l3dcigm:PccTerminalBoundary-ps
    a               sh:PropertyShape ;
    sh:name         "PccTerminalBoundary" ;
    sh:description  "cim:ACDCConverter.PccTerminal shall be associated (connected) with the boundary point." ;
    sh:group        l3dcigm:Level3-DCIGM ;
    sh:order        3 ;
    sh:severity     sh:Violation ;
    sh:path         cim:ACDCConverter.PccTerminal ;
    sh:sparql       l3dcigm:PccTerminalBoundarySparql  .

l3dcigm:PccTerminalBoundarySparql
    a          sh:SPARQLConstraint ;
    sh:message "cim:ACDCConverter.PccTerminal is not associated (connected) with the boundary point." ;
    sh:prefixes cim:   ;
    sh:select """
        SELECT $this ?value
        WHERE {
          $this $PATH ?value .
          BIND(EXISTS{$this cim:ACDCConverter.PccTerminal/cim:Terminal.TopologicalNode/entsoe:TopologicalNode.boundaryPoint true } AS ?isBP).

         FILTER(?isBP=false).
        }""".

l3dcigm:VsConverter.pPccControl-targetValuephasePcc
        a               sh:PropertyShape ;
        sh:sparql       l3dcigm:VsConverter.pPccControl-targetValuephasePccSparql ;
        sh:description  "Control is phase at point of common coupling. Target is provided by VsConverter.targetPhasePcc." ;
        sh:name         "targetValuephasePcc" ;
        sh:path         cim:VsConverter.pPccControl ;
        sh:group        l3dcigm:Level3-DCIGM ;
        sh:order        27 ;
        sh:severity     sh:Violation .
        
    
l3dcigm:VsConverter.pPccControl-targetValuephasePccSparql
		a         sh:SPARQLConstraint ;  
		sh:message "VsConverter.targetPhasePcc is not provided for a converter with VsPpccControlKind.phasePcc." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this ?value
			WHERE {
        $this $PATH ?value .
        OPTIONAL {$this cim:VsConverter.targetPhasePcc ?targetphasepcc}.
        FILTER (!bound(?targetphasepcc) && ?value=cim:VsPpccControlKind.phasePcc) .        
			}""" .


l3dcigm:VsConverter.pPccControl-targetValuePpcc
        a               sh:PropertyShape ;
        sh:sparql       l3dcigm:VsConverter.pPccControl-targetValuePpccSparql ;
        sh:description  "Control is real power at point of common coupling. The target value is provided by ACDCConverter.targetPpcc." ;
        sh:name         "targetValuePpcc" ;
        sh:path         cim:VsConverter.pPccControl ;
        sh:group        l3dcigm:Level3-DCIGM ;
        sh:order        28 ;
        sh:severity     sh:Violation .
        
    
l3dcigm:VsConverter.pPccControl-targetValuePpccSparql
		a         sh:SPARQLConstraint ;  
		sh:message "ACDCConverter.targetPpcc is not provided for a converter with VsPpccControlKind.pPcc." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this ?value
			WHERE {
        $this $PATH ?value .
        OPTIONAL {$this cim:ACDCConverter.targetPpcc ?targetppcc}.
        FILTER (!bound(?targetppcc) && ?value=cim:VsPpccControlKind.pPcc) .        
			}""" . 


l3dcigm:VsConverter.pPccControl-targetValuepPccAndUdcDroop
        a               sh:PropertyShape ;
        sh:sparql       l3dcigm:VsConverter.pPccControl-targetValuepPccAndUdcDroopSparql ;
        sh:description  "Target values are provided by ACDCConverter.targetPpcc, ACDCConverter.targetUdc and VsConverter.droop." ;
        sh:name         "targetValuepPccAndUdcDroop" ;
        sh:path         cim:VsConverter.pPccControl ;
