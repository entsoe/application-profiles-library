l4com:DanglingReferences
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
		sh:prefixes cim: ;
        sh:select """
            SELECT DISTINCT ?this
            WHERE {
                ?subject ?predicate ?this .

                FILTER(?predicate != rdf:type)
                FILTER(isIRI(?this))

                FILTER(
                    STRSTARTS(STR(?this), "urn:uuid:")
                    || CONTAINS(STR(?this), "#_")
                    || STRENDS(STR(?this), "#")
                )

                FILTER NOT EXISTS {
                    ?this rdf:type ?type .
                }
            }
        """ ;
    ] ;

    sh:property l4com:All-DanglingReferences .

l4com:All-DanglingReferences
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:minCount 1 ;
	sh:order        10;
	sh:name         "DanglingReference";
	sh:severity     sh:Violation;
	sh:group        l4com:Level4-IGMCGM;
	sh:description  "For all references (part of the CGMES profiles and additional, if existing), the mRID specified in every rdf:resource in the assembly of cimxml instance files shall be defined in an existing rdf:ID and rdf:about part of the data exchange.";
    sh:message   "Dangling reference found." .

