        sh:description        "Checks if the dataset contains properties which are not defined in the profile to which this dataset conforms to.";
        sh:group              eq:ProfilePropertiesGroup;
        sh:ignoredProperties  ( rdf:type );
        sh:message            "This property is not part of the profile to which this dataset conforms to.";
        sh:name               "PropertyNotInProfile";
        sh:order              1;
        sh:property           [ sh:path  cim:DCLineSegment.PerLengthParameter ];
        sh:property           [ sh:path  cim:DCLineSegment.length ];
        sh:property           [ sh:path  cim:DCLineSegment.resistance ];
        sh:property           [ sh:path  cim:DCLineSegment.inductance ];
        sh:property           [ sh:path  cim:DCLineSegment.capacitance ];
        sh:property           [ sh:path  cim:Equipment.EquipmentContainer ];
        sh:property           [ sh:path  cim:Equipment.aggregate ];
        sh:property           [ sh:path  cim:IdentifiedObject.name ];
        sh:property           [ sh:path  cim:IdentifiedObject.description ];
        sh:property           [ sh:path  entsoe:IdentifiedObject.shortName ];
        sh:property           [ sh:path  entsoe:IdentifiedObject.energyIdentCodeEic ];
        sh:property           [ sh:path  cim:IdentifiedObject.mRID ];
        sh:severity           sh:Info;
        sh:targetClass        cim:DCLineSegment .

eq:DCLineSegment  rdf:type  sh:NodeShape;
        sh:property     ido:IdentifiedObject.mRID-datatype , ido:IdentifiedObject.mRID-cardinality , ido:IdentifiedObject.energyIdentCodeEic-datatype , ido:IdentifiedObject.energyIdentCodeEic-cardinality , ido:IdentifiedObject.shortName-datatype , ido:IdentifiedObject.shortName-cardinality , ido:IdentifiedObject.description-datatype , ido:IdentifiedObject.description-cardinality , ido:IdentifiedObject.name-datatype , eq:DCLineSegment.PerLengthParameter-cardinality , eq:DCLineSegment.PerLengthParameter-valueType , eq:DCLineSegment.length-cardinality , eq:DCLineSegment.length-datatype , eq:DCLineSegment.resistance-cardinality , eq:DCLineSegment.resistance-datatype , eq:DCLineSegment.inductance-cardinality , eq:DCLineSegment.inductance-datatype , eq:DCLineSegment.capacitance-cardinality , eq:DCLineSegment.capacitance-datatype , eq:Equipment.EquipmentContainer-cardinality , eq:Equipment.aggregate-cardinality , eq:Equipment.aggregate-datatype , ido:IdentifiedObject.name-cardinality;
        sh:targetClass  cim:DCLineSegment .

cc:     rdf:type     owl:Ontology;
        owl:imports  sh:;
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://www.w3.org/1999/02/22-rdf-syntax-ns#";
                       sh:prefix     "rdf"
                     ] .

cc:ClassCount-propertySparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "The class {?class} appears {?value} times in the data graph.";
        sh:prefixes  cc:;
        sh:select    """ 
            SELECT $this ?class (COUNT(?instance) AS ?value)
            WHERE {
                    ?instance rdf:type ?class .
                   }
            GROUP BY $this ?class
             """ .

cc:ClassCount-property
        rdf:type        sh:PropertyShape;
        sh:description  "Counts instance of classes present in the data graph.";
        sh:group        cc:ClassesCountGroup;
        sh:name         "ClassCount";
        sh:order        1;
        sh:path         rdf:type;
        sh:severity     sh:Info;
        sh:sparql       cc:ClassCount-propertySparql .

cc:ClassCount-node  rdf:type  sh:NodeShape;
        sh:property     cc:ClassCount-property;
        sh:targetClass  md:FullModel , dcat:Dataset .

cc:ClassesCountGroup  rdf:type  sh:PropertyGroup;
        rdfs:label  "ClassesCount";
        sh:order    1 .

eq:AllowedClasses-property
        rdf:type        sh:PropertyShape;
        sh:description  "Checks if the dataset contains classes which are not defined in the profile to which this dataset conforms to.";
        sh:group        eq:ProfileClassesGroup;
        sh:in           ( cim:DCLineSegment cim:Switch cim:EnergySource cim:FossilFuel cim:AsynchronousMachine cim:GeographicalRegion cim:DCDisconnector cim:PowerTransformerEnd cim:TapChangerControl cim:RegulatingControl cim:Breaker cim:LoadResponseCharacteristic cim:WindGeneratingUnit cim:DCTerminal cim:NuclearGeneratingUnit cim:ControlAreaGeneratingUnit cim:Line cim:RatioTapChanger cim:ACLineSegment cim:DCSeriesDevice cim:DCShunt cim:EnergyConsumer cim:ConformLoad cim:StaticVarCompensator cim:DCLine cim:PhaseTapChangerAsymmetrical cim:HydroPowerPlant cim:LinearShuntCompensator cim:BusbarSection cim:SolarGeneratingUnit cim:ControlArea cim:RatioTapChangerTablePoint cim:BaseVoltage cim:DCNode cim:SubGeographicalRegion cim:PowerTransformer cim:Terminal cim:PhaseTapChangerLinear entsoe:EnergySchedulingType cim:SeriesCompensator cim:VsCapabilityCurve cim:VoltageLevel cim:EquivalentNetwork cim:ConformLoadSchedule cim:CsConverter cim:HydroGeneratingUnit cim:DCBreaker cim:DCSwitch cim:RatioTapChangerTable cim:NonlinearShuntCompensatorPoint cim:ExternalNetworkInjection cim:PhaseTapChangerTable cim:PerLengthDCLineParameter cim:EquivalentBranch cim:TapChangerTablePoint cim:SynchronousMachine cim:Junction cim:DCChopper cim:ConformLoadGroup cim:PhaseTapChangerTablePoint cim:CurveData cim:GeneratingUnit cim:EquivalentShunt cim:NonConformLoadGroup cim:NonConformLoadSchedule cim:DCBusbar cim:CurrentLimit cim:PhaseTapChangerSymmetrical cim:OperationalLimitSet cim:ACDCConverterDCTerminal cim:VoltageLimit cim:VsConverter cim:PhaseTapChangerTabular cim:Disconnector cim:EquivalentInjection cim:BusNameMarker cim:NonlinearShuntCompensator cim:Substation cim:ReportingGroup cim:TieFlow cim:HydroPump cim:OperationalLimitType cim:ReactiveCapabilityCurve cim:ThermalGeneratingUnit cim:DCGround cim:DCEquipmentContainer cim:NonConformLoad cim:DCConverterUnit cim:LoadBreakSwitch md:FullModel dm:DifferenceModel dcat:Dataset );
        sh:message      "This class is not part of the profile to which this dataset conforms to.";
        sh:name         "ClassNotInProfile";
        sh:order        1;
        sh:path         rdf:type;
        sh:severity     sh:Info .

eq:AllowedClasses-node
        rdf:type             sh:NodeShape;
        sh:property          eq:AllowedClasses-property;
        sh:targetSubjectsOf  rdf:type .

eq:ProfilePropertiesGroup
        rdf:type    sh:PropertyGroup;
        rdfs:label  "ProfileProperties";
        sh:order    1 .

eq:AssociationsGroup  rdf:type  sh:PropertyGroup;
        rdfs:label  "Associations";
        sh:order    2 .

ido:DatatypesGroupIO  rdf:type  sh:PropertyGroup;
        rdfs:label  "DatatypesIO";
        sh:order    1 .

eq:ProfileClassesGroup
        rdf:type    sh:PropertyGroup;
        rdfs:label  "ProfileClasses";
        sh:order    1 .

eq:InverseAssociationsGroup
        rdf:type    sh:PropertyGroup;
        rdfs:label  "InverseAssociations";
        sh:order    1 .

eq:DatatypesGroup  rdf:type  sh:PropertyGroup;
        rdfs:label  "Datatypes";
        sh:order    1 .

ido:CardinalityGroup  rdf:type  sh:PropertyGroup;
        rdfs:label  "CardinalityIO";
