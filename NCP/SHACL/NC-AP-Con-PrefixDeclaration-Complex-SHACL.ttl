@base          <https://ap-con.cim4.eu/PrefixDeclaration-Complex/2.5> .
@prefix pd:  <https://ap-con.cim4.eu/PrefixDeclaration-Complex/2.5#> .
@prefix cim:     <https://cim.ucaiug.io/ns#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

pd:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:std:iec:61970-501:draft:ed-2" , "urn:iso:std:iec:61970-600-2:ed-1" , "urn:iso:std:iec:61970-301:ed-7:amd1" , "file://iec61970cim17v40_iec61968cim13v13a_iec62325cim03v17a.eap" ;
        dcterms:creator           "ENTSO-E CIM EG"@en ;
        dcterms:description       "Prefix declaration dataset."@en ;
        dcterms:identifier        "40ea268c-56ca-47c0-8484-2fec63f7d06e" ;
        dcterms:issued            "2026-08-09T12:09:21Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:modified          "2026-08-09"^^xsd:date ;
        dcterms:publisher         "ENTSO-E"@en ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "ENTSO-E"@en ;
        dcterms:title             "Prefix declaration"@en ;
        owl:versionIRI        <https://ap-con.cim4.eu/PrefixDeclaration-Complex/2.5> ;
        dcterms:license        "https://www.apache.org/licenses/LICENSE-2.0" ;
        owl:versionInfo       "2.5.0"@en ;
        dcat:landingPage      "https://www.entsoe.eu/digital/cim/cim-for-grid-models-exchange/" ;
        dcat:theme            "constraints"@en .


cim:
    a owl:Ontology ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "https://cim.ucaiug.io/ns#"^^xsd:anyURI ;
        sh:prefix "cim" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://iec.ch/TC57/2013/CIM-schema-cim16#"^^xsd:anyURI ;
        sh:prefix "cim16" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "https://cim4.eu/ns/nc#"^^xsd:anyURI ;
        sh:prefix "nc" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
        sh:prefix "rdf" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
        sh:prefix "xsd" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://iec.ch/TC57/CIM100#"^^xsd:anyURI ;
        sh:prefix "cim17" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "https://cim.ucaiug.io/ns/eu#"^^xsd:anyURI ;
        sh:prefix "eu" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ;
        sh:prefix "prov" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/ns/adms#"^^xsd:anyURI ;
        sh:prefix "adms" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/ns/dcat#"^^xsd:anyURI ;
        sh:prefix "dcat" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "https://cim4.eu/ns/dcatcim#"^^xsd:anyURI ;
        sh:prefix "dcatcim" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ;
        sh:prefix "dcterms" ;
    ] .
