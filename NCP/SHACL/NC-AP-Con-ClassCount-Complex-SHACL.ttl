@base          <https://ap-con.cim4.eu/ClassCount-Complex/2.5> .
@prefix cc:  <https://ap-con.cim4.eu/ClassCount-Complex/2.5#> .
@prefix cim:     <https://cim.ucaiug.io/ns#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

cc:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:std:iec:61970-501:draft:ed-2" , "urn:iso:std:iec:61970-600-2:ed-1" , "urn:iso:std:iec:61970-301:ed-7:amd1" , "file://iec61970cim17v40_iec61968cim13v13a_iec62325cim03v17a.eap" ;
        dcterms:creator           "ENTSO-E CIM EG"@en ;
        dcterms:description       "Class count constraints."@en ;
        dcterms:identifier        "05d79aa6-80b7-45de-96f0-534d4b89fba5" ;
        dcterms:issued            "2026-08-09T12:09:21Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:modified          "2026-08-09"^^xsd:date ;
        dcterms:publisher         "ENTSO-E"@en ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "ENTSO-E"@en ;
        dcterms:title             "Class count constraints"@en ;
        owl:versionIRI        <https://ap-con.cim4.eu/ClassCount-Complex/2.5> ;
        dcterms:license        "https://www.apache.org/licenses/LICENSE-2.0" ;
        owl:versionInfo       "2.5.0"@en ;
        dcat:landingPage      "https://www.entsoe.eu/digital/cim/cim-for-grid-models-exchange/" ;
        dcat:theme            "constraints"@en .


cc:ClassesCountGroup  rdf:type  sh:PropertyGroup;
        rdfs:label  "ClassesCount";
        sh:order    1 .

cc:ClassCount-node  rdf:type  sh:NodeShape;
        sh:property     cc:ClassCount-property;
        sh:targetClass  dcat:Dataset .	

cc:ClassCount-property
        rdf:type        sh:PropertyShape;
        sh:description  "Counts instance of classes present in the data graph.";
        sh:group        cc:ClassesCountGroup;
        sh:name         "ClassCount";
        sh:order        1;
        sh:path         rdf:type;
        sh:severity     sh:Info;
        sh:sparql       cc:ClassCount-propertySparql .		

cc:ClassCount-propertySparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "The class {?class} appears {?value} times in the data graph.";
        sh:prefixes  cim:;
        sh:select    """
          SELECT $this ?class (COUNT(?instance) AS ?value)
          WHERE {
            ?instance rdf:type ?class .
          }
          GROUP BY $this ?class
          """ .





