or:Designation.kind-datatype
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:in           ( nc:DesignationKind.uuid nc:DesignationKind.local nc:DesignationKind.label nc:DesignationKind.iec61850 nc:DesignationKind.alias nc:DesignationKind.device nc:DesignationKind.eic nc:DesignationKind.path nc:DesignationKind.urn nc:DesignationKind.rds );
