or:Ontology  rdf:type     owl:Ontology;
        dcterms:conformsTo    "urn:iso:std:iec:61970-600-2:ed-1" , "urn:iso:std:iec:61970-501:draft:ed-2" , "urn:iso:std:iec:61970-401:draft:ed-1" , "urn:iso:std:iec:61970-301:ed-7:amd1" , "file://iec61970cim17v40_iec61968cim13v13a_iec62325cim03v17a.eap" , "file://CIM17-2_CGMES31v01_PROF-20v03_NC25v25_MS10v12_DES10v01.eap";
        dcterms:description   "Describing constraints extracted from RDFS.";
        dcterms:identifier    "6fffc8f4-7982-4a65-a7bc-67a8476275ec";
        dcterms:issued        "2026-08-09T12:37:31.160938"^^xsd:dateTime;
        dcterms:language      "en-GB";
        dcterms:license       "https://www.apache.org/licenses/LICENSE-2.0"@en;
        dcterms:modified      "2026-08-05"^^xsd:date;
        dcterms:publisher     "ENTSO-E"@en;
        dcterms:rightsHolder  "ENTSO-E"@en;
        dcterms:title         "Object Registry vocabulary"@en;
        owl:versionIRI    <https://ap-con.cim4.eu/ObjectRegistry-Simple/3.0>;
        owl:versionInfo   "3.0.0"@en;
        dcat:keyword      "OR";
        dcat:theme        "constraint"@en .

or:Identity-AllowedProperties
        rdf:type              sh:NodeShape;
        sh:closed             true;
        sh:description        "Checks if the dataset contains properties which are not defined in the profile to which this dataset conforms to.";
        sh:group              or:ProfilePropertiesGroup;
        sh:ignoredProperties  ( rdf:type );
        sh:message            "This property is not part of the profile to which this dataset conforms to.";
        sh:name               "PropertyNotInProfile";
        sh:order              4;
        sh:property           [ sh:path  nc:Identity.identifier ];
        sh:severity           sh:Info;
        sh:targetClass        nc:Identity .

or:Identity  rdf:type   sh:NodeShape;
        sh:property     or:Identity.identifier-datatype , or:Identity.identifier-cardinality;
        sh:targetClass  nc:Identity .

or:DesignationType.DesignationAuthority-valueType
        rdf:type        sh:PropertyShape;
        sh:class        nc:DesignationAuthority;
        sh:description  "This constraint validates the value of the association at the used direction.";
        sh:group        or:AssociationsGroup;
        sh:message      "One of the following does not conform: 1) The value shall be IRI; 2) The value shall be an instance of the class: nc:DesignationAuthority";
        sh:name         "DesignationType.DesignationAuthority-valueType";
        sh:nodeKind     sh:IRI;
        sh:order        4;
        sh:path         nc:DesignationType.DesignationAuthority;
        sh:severity     sh:Violation .

or:DesignationType.DesignationAuthority-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the association at the used direction.";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.DesignationAuthority-cardinality";
        sh:order        22;
        sh:path         nc:DesignationType.DesignationAuthority;
        sh:severity     sh:Violation .

or:DesignationType.languageTag-datatype
        rdf:type        sh:PropertyShape;
        sh:datatype     rdf:langString ;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.languageTag-datatype";
        sh:nodeKind     sh:Literal;
        sh:order        13;
        sh:path         nc:DesignationType.languageTag;
        sh:severity     sh:Violation .

or:DesignationType.languageTag-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the property (attribute).";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.languageTag-cardinality";
        sh:order        21;
        sh:path         nc:DesignationType.languageTag;
        sh:severity     sh:Violation .

or:DesignationType.maxLength-datatype
        rdf:type        sh:PropertyShape;
        sh:datatype     xsd:integer;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:message      "The datatype is not literal or it violates the xsd datatype.";
        sh:name         "DesignationType.maxLength-datatype";
        sh:nodeKind     sh:Literal;
        sh:order        12;
        sh:path         nc:DesignationType.maxLength;
        sh:severity     sh:Violation .

or:DesignationType.maxLength-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the property (attribute).";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.maxLength-cardinality";
        sh:order        20;
        sh:path         nc:DesignationType.maxLength;
        sh:severity     sh:Violation .

or:DesignationType.uniquenessScope-datatype
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:in           ( nc:UniquenessScopeKind.unspecified nc:UniquenessScopeKind.exchangeContext nc:UniquenessScopeKind.authority nc:UniquenessScopeKind.global );
        sh:message      "The datatype is not IRI (Internationalized Resource Identifier) or it is enumerated value not part of the profile.";
        sh:name         "DesignationType.uniquenessScope-datatype";
        sh:nodeKind     sh:IRI;
        sh:order        11;
        sh:path         nc:DesignationType.uniquenessScope;
        sh:severity     sh:Violation .

or:DesignationType.uniquenessScope-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the property (attribute).";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.uniquenessScope-cardinality";
        sh:order        19;
        sh:path         nc:DesignationType.uniquenessScope;
        sh:severity     sh:Violation .

or:DesignationType.description-datatype
        rdf:type        sh:PropertyShape;
        sh:datatype     xsd:string;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:message      "The datatype is not literal or it violates the xsd datatype.";
        sh:name         "DesignationType.description-datatype";
        sh:nodeKind     sh:Literal;
        sh:order        10;
        sh:path         nc:DesignationType.description;
        sh:severity     sh:Violation .

or:DesignationType.description-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the property (attribute).";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.description-cardinality";
        sh:order        18;
        sh:path         nc:DesignationType.description;
        sh:severity     sh:Violation .

or:DesignationType.name-datatype
        rdf:type        sh:PropertyShape;
        sh:datatype     xsd:string;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:message      "The datatype is not literal or it violates the xsd datatype.";
        sh:name         "DesignationType.name-datatype";
        sh:nodeKind     sh:Literal;
        sh:order        9;
        sh:path         nc:DesignationType.name;
        sh:severity     sh:Violation .

or:DesignationType.name-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the property (attribute).";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Missing required property (attribute).";
        sh:minCount     1;
        sh:name         "DesignationType.name-cardinality";
        sh:order        17;
        sh:path         nc:DesignationType.name;
        sh:severity     sh:Violation .

or:DesignationType.Designation-propertyInverse
        rdf:type        sh:PropertyShape;
        sh:description  "Inverse associations shall not be instantiated.";
        sh:group        or:InverseAssociationsGroup;
        sh:maxCount     0;
        sh:message      "Inverse association is present.";
        sh:name         "InverseAssociationPresent";
        sh:order        3;
        sh:path         nc:DesignationType.Designation;
        sh:severity     sh:Violation .

or:DesignationType.Designation-inverseNodePresent
        rdf:type             sh:NodeShape;
        sh:property          or:DesignationType.Designation-propertyInverse;
        sh:targetSubjectsOf  nc:DesignationType.Designation .

or:DesignationType.regularExpression-datatype
        rdf:type        sh:PropertyShape;
        sh:datatype     xsd:string;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:message      "The datatype is not literal or it violates the xsd datatype.";
        sh:name         "DesignationType.regularExpression-datatype";
        sh:nodeKind     sh:Literal;
        sh:order        8;
        sh:path         nc:DesignationType.regularExpression;
        sh:severity     sh:Violation .

or:DesignationType.regularExpression-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the property (attribute).";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.regularExpression-cardinality";
        sh:order        15;
        sh:path         nc:DesignationType.regularExpression;
        sh:severity     sh:Violation .

or:DesignationType.typeRef-datatype
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the datatype of the property (attribute).";
        sh:group        or:DatatypesGroup;
        sh:message      "The datatype is not literal or it violates the xsd datatype.";
        sh:name         "DesignationType.typeRef-datatype";
        sh:nodeKind     sh:IRI;
        sh:order        7;
        sh:path         nc:DesignationType.typeRef;
        sh:severity     sh:Violation .

or:DesignationType.typeRef-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the property (attribute).";
        sh:group        or:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Cardinality violation. Upper bound shall be 1";
        sh:name         "DesignationType.typeRef-cardinality";
        sh:order        14;
        sh:path         nc:DesignationType.typeRef;
        sh:severity     sh:Violation .

or:DesignationType-AllowedProperties
        rdf:type              sh:NodeShape;
        sh:closed             true;
        sh:description        "Checks if the dataset contains properties which are not defined in the profile to which this dataset conforms to.";
        sh:group              or:ProfilePropertiesGroup;
        sh:ignoredProperties  ( rdf:type );
        sh:message            "This property is not part of the profile to which this dataset conforms to.";
        sh:name               "PropertyNotInProfile";
        sh:order              3;
        sh:property           [ sh:path  nc:DesignationType.typeRef ];
        sh:property           [ sh:path  nc:DesignationType.regularExpression ];
        sh:property           [ sh:path  nc:DesignationType.name ];
        sh:property           [ sh:path  nc:DesignationType.description ];
        sh:property           [ sh:path  nc:DesignationType.uniquenessScope ];
        sh:property           [ sh:path  nc:DesignationType.maxLength ];
        sh:property           [ sh:path  nc:DesignationType.languageTag ];
        sh:property           [ sh:path  nc:DesignationType.DesignationAuthority ];
        sh:property           [ sh:path  nc:Identity.identifier ];
        sh:severity           sh:Info;
        sh:targetClass        nc:DesignationType .

or:DesignationType  rdf:type  sh:NodeShape;
        sh:property     or:Identity.identifier-datatype , or:Identity.identifier-cardinality , or:DesignationType.DesignationAuthority-valueType , or:DesignationType.DesignationAuthority-cardinality , or:DesignationType.typeRef-cardinality , or:DesignationType.typeRef-datatype , or:DesignationType.regularExpression-cardinality , or:DesignationType.regularExpression-datatype , or:DesignationType.name-cardinality , or:DesignationType.name-datatype , or:DesignationType.description-cardinality , or:DesignationType.description-datatype , or:DesignationType.uniquenessScope-cardinality , or:DesignationType.uniquenessScope-datatype , or:DesignationType.maxLength-cardinality , or:DesignationType.maxLength-datatype , or:DesignationType.languageTag-cardinality , or:DesignationType.languageTag-datatype;
        sh:targetClass  nc:DesignationType .

