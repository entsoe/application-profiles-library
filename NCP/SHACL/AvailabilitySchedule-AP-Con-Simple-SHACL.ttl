as:AvailabilityContainer.EquipmentContainer-valueType
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the value of the association at the used direction.";
        sh:group        as:AssociationsGroup;
        sh:in           ( cim:Substation nc:SecondarySubstation cim17:Substation cim16:DCEquipmentContainer nc:DCSubstationBipole nc:DCSubstationPole cim16:DCConverterUnit cim17:DCConverterUnit cim16:DCLine cim:DCConverterUnit nc:DCSubstation cim17:DCLine cim16:Substation cim16:Line cim:Line cim17:Line cim16:Bay cim16:VoltageLevel cim17:Bay cim17:VoltageLevel );
        sh:message      "One of the following occurs: 1) The value is not IRI; 2) The value is not the right class.";
        sh:name         "AvailabilityContainer.EquipmentContainer-valueType";
        sh:nodeKind     sh:IRI;
        sh:order        38;
        sh:path         ( nc:AvailabilityContainer.EquipmentContainer rdf:type );
        sh:severity     sh:Violation .

as:AvailabilityContainer.EquipmentContainer-valueTypeNodeShape
        rdf:type        sh:NodeShape;
        sh:property     as:AvailabilityContainer.EquipmentContainer-valueType;
        sh:targetClass  nc:AvailabilityContainer .

as:AvailabilityContainer.EquipmentContainer-cardinality
        rdf:type        sh:PropertyShape;
        sh:description  "This constraint validates the cardinality of the association at the used direction.";
        sh:group        as:CardinalityGroup;
        sh:maxCount     1;
        sh:message      "Association with cardinality violation at the used direction.";
        sh:minCount     1;
        sh:name         "AvailabilityContainer.EquipmentContainer-cardinality";
        sh:order        139;
        sh:path         nc:AvailabilityContainer.EquipmentContainer;
        sh:severity     sh:Violation .

as:AvailabilityContainer-AllowedProperties
        rdf:type              sh:NodeShape;
        sh:closed             true;
        sh:description        "Checks if the dataset contains properties which are not defined in the profile to which this dataset conforms to.";
        sh:group              as:ProfilePropertiesGroup;
        sh:ignoredProperties  ( rdf:type );
        sh:message            "This property is not part of the profile to which this dataset conforms to.";
        sh:name               "PropertyNotInProfile";
        sh:order              16;
        sh:property           [ sh:path  nc:AvailabilityContainer.EquipmentContainer ];
        sh:property           [ sh:path  nc:AvailabilityPowerSystemFunction.AvailabilitySchedule ];
        sh:property           [ sh:path  nc:AvailabilityPowerSystemFunction.kind ];
        sh:property           [ sh:path  nc:AvailabilityPowerSystemFunction.AvailabilityGroup ];
