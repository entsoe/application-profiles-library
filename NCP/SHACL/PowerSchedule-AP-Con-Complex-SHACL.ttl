@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nc:      <https://cim4.eu/ns/nc#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


psc:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:std:iec:61970-501:draft:ed-2" , "urn:iso:std:iec:61970-600-2:ed-1" , "urn:iso:std:iec:61970-301:ed-7:amd1"  ;
        dcterms:creator           "ENTSO-E CIM WG"@en ;
        dcterms:description       "The custom constraints for power schedule profile."@en ;
        dcterms:identifier        "d3dd5fa4-e3f7-4498-81c0-03d1d8514d5c" ;
        dcterms:issued            "2026-08-09T12:09:21Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:modified          "2026-08-09"^^xsd:date ;
        dcterms:publisher         "ENTSO-E"@en ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "ENTSO-E"@en ;
        dcterms:title             "Power schedule profile custom constraints"@en ;
        owl:versionIRI        <https://ap-con.cim4.eu/PowerSchedule-Complex/2.5> ;
    dcterms:license        "https://www.apache.org/licenses/LICENSE-2.0" ;
        owl:versionInfo       "2.5.0"@en ;
        dcat:landingPage      "https://www.entsoe.eu/digital/cim/cim-for-grid-models-exchange/" ;
        dcat:theme            "constraints"@en .

psc:PSCustomGroup
        a           sh:PropertyGroup ;
        rdfs:label  "PowerScheduleGroup" ;
        sh:order    0 .


psc:PowerSchedule-dc-associations
        a               sh:NodeShape ;
        sh:targetClass  nc:DCTieCorridor ;
        sh:property     psc:DCTieCorridor-powerSchedule .

psc:DCTieCorridor-powerSchedule
        a               sh:PropertyShape ;
        sh:path         rdf:type ;
        sh:name         "C:NC:PS:PowerSchedule:dc-associations" ;
        sh:description  "The schedule for the DCTieCorridor is given by its SchedulingArea. Either the schedule of DCTieCorridor or the DCPole is provided." ;
        sh:group        psc:PSCustomGroup ;
        sh:order        1 ;
        sh:severity     sh:Violation ;
        sh:sparql       psc:DCTieCorridor-powerScheduleSparql .

psc:DCTieCorridor-powerScheduleSparql
    a sh:SPARQLConstraint ;
    sh:prefixes cim: ;
    sh:message "The PowerSchedule associated with the DCTieCorridor is not defined through its SchedulingArea or one of its DCPole instances." ;
    sh:select """
        SELECT DISTINCT $this
        WHERE {
            FILTER EXISTS {
                ?powerSchedule rdf:type nc:PowerSchedule .
            }
			
			BIND (
                EXISTS {
                    $this
                        nc:DCTieCorridor.SchedulingArea
                        ?schedulingArea .
        
                    ?powerSchedule
                        nc:PowerSchedule.SchedulingArea
                        ?schedulingArea .
                }
                AS ?hasSchedulingAreaSchedule
            )
        
            BIND (
                EXISTS {
                    ?dcPole
                        nc:DCPole.DCTieCorridor
                        $this .
        
                    ?powerSchedule
                        nc:PowerSchedule.DCPole
                        ?dcPole .
                }
                AS ?hasDCPoleSchedule
            )
        
            FILTER (
                ?hasSchedulingAreaSchedule
                &&
                ?hasDCPoleSchedule
            )
        }
    """ .	


psc:PowerSchedule-currency
        a               sh:NodeShape ;
        sh:targetClass  nc:PowerSchedule ;
        sh:property     psc:PowerSchedule-currency-property .

psc:PowerSchedule-currency-property
        a               sh:PropertyShape ;
        sh:path         nc:PowerSchedule.currency ;
        sh:name         "C:NC:RAS:PowerSchedule:currency" ;
        sh:description  "If PowerTimePoint.price is provided, PowerSchedule.currency is required." ;
        sh:group        psc:PSCustomGroup ;
        sh:order        2 ;
        sh:severity     sh:Violation ;
        sh:sparql       psc:PowerSchedule-currencySparql .

psc:PowerSchedule-currencySparql
        a               sh:SPARQLConstraint ;
        sh:prefixes     cim: ;
        sh:message      "PowerSchedule.currency is not provided but a PowerTimePoint.price is provided." ;
        sh:select       """
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this ^nc:PowerTimePoint.PowerSchedule/nc:PowerTimePoint.price ?price .
                }

                FILTER NOT EXISTS {
                    $this $PATH ?currency .
                }
            }
        """ .



