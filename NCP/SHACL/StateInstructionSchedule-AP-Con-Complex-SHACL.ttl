@base          <https://ap-con.cim4.eu/StateInstructionSchedule-Complex/2.5> .
@prefix sisc:  <https://ap-con.cim4.eu/StateInstructionSchedule-Complex/2.5#> .
@prefix cim:     <https://cim.ucaiug.io/ns#> .
@prefix cim16:   <http://iec.ch/TC57/2013/CIM-schema-cim16#> .
@prefix cim17:   <http://iec.ch/TC57/CIM100#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nc:      <https://cim4.eu/ns/nc#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


sisc:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:std:iec:61970-501:draft:ed-2" , "urn:iso:std:iec:61970-600-2:ed-1" , "urn:iso:std:iec:61970-301:ed-7:amd1"  ;
        dcterms:creator           "ENTSO-E CIM WG"@en ;
        dcterms:description       "The custom constraints for state instruction schedule profile."@en ;
        dcterms:identifier        "edc9759d-5a30-4b2c-9349-1b20faf8d920" ;
        dcterms:issued            "2026-08-09T12:09:21Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:modified          "2026-08-09"^^xsd:date ;
        dcterms:publisher         "ENTSO-E"@en ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "ENTSO-E"@en ;
        dcterms:title             "State instruction schedule profile custom constraints"@en ;
        owl:versionIRI        <https://ap-con.cim4.eu/StateInstructionSchedule-Complex/2.5> ;
        dcterms:license        "https://www.apache.org/licenses/LICENSE-2.0" ;
        owl:versionInfo       "2.5.0"@en ;
        dcat:landingPage      "https://www.entsoe.eu/digital/cim/cim-for-grid-models-exchange/" ;
        dcat:theme            "constraints"@en .

sisc:SISCustomGroup
        a           sh:PropertyGroup ;
        rdfs:label  "StateInstructionScheduleGroup" ;
        sh:order    0 .

sisc:PowerShiftKeySchedule  a          sh:NodeShape ;
        sh:property      sisc:PowerShiftKeySchedule.ParticipationFactorTimePoint-dependency, sisc:PowerShiftKeySchedule-associations;
        sh:targetClass  nc:PowerShiftKeySchedule .



sisc:PowerShiftKeySchedule.ParticipationFactorTimePoint-dependency
        a               sh:PropertyShape ;
        sh:description  "The multiplicity of the association end PowerShiftKeySchedule.ParticipationFactorTimePoint shall be 1..n for all cases except if the PowerShiftKeySchedule is associated with PowerShiftKeyDistribution." ;
        sh:sparql       sisc:PowerShiftKeySchedule.ParticipationFactorTimePoint-dependencySparql ;
        sh:path         rdf:type ;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PowerShiftKeySchedule.ParticipationFactorTimePoint:dependency" ;
        sh:order        1 ;
        sh:severity     sh:Violation .
        
sisc:PowerShiftKeySchedule.ParticipationFactorTimePoint-dependencySparql
    a         sh:SPARQLConstraint ;  
    sh:message      "The association end PowerShiftKeySchedule.ParticipationFactorTimePoint is not instantiated for PowerShiftKeySchedule that is not associated with PowerShiftKeyDistribution." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
    BIND(EXISTS{$this ^nc:PowerShiftKeyDistribution.PowerShiftKeySchedule ?pskd} AS ?valD).  
    BIND(EXISTS{$this nc:PowerShiftKeySchedule.ParticipationFactorTimePoint ?pftp} AS ?valP).
        FILTER (?valD="false"^^xsd:boolean && ?valP="false"^^xsd:boolean ).
      }""" .        



sisc:PowerShiftKeySchedule-associations
        a               sh:PropertyShape ;
        sh:description  "PowerShiftKeySchedule shall include one and only one association to ScheduleResource, PowerElectronicUnit, GeneratingUnit, DCPole, EnergyResourceGroupCapacity, EquivalentInjection, EnergyConsumer, EnergySource, ExternalNetworkInjection, SchedulingArea, DCEquivalentInjection, EnergyBlockOrder and HydroPump." ;
        sh:message      "PowerShiftKeySchedule has more than one associations to ScheduleResource, PowerElectronicUnit, GeneratingUnit, DCPole, EnergyResourceGroupCapacity, EquivalentInjection, EnergyConsumer, EnergySource, ExternalNetworkInjection, SchedulingArea, DCEquivalentInjection, EnergyBlockOrder and HydroPump." ;
        sh:path [sh:alternativePath (
        nc:PowerShiftKeySchedule.DCEquivalentInjection
        nc:PowerShiftKeySchedule.DCPole
        nc:PowerShiftKeySchedule.EnergyBlockOrder
        nc:PowerShiftKeySchedule.EnergyConsumer
        nc:PowerShiftKeySchedule.EnergyResourceGroupCapacity
        nc:PowerShiftKeySchedule.EnergySource
        nc:PowerShiftKeySchedule.EquivalentInjection
        nc:PowerShiftKeySchedule.ExternalNetworkInjection
        nc:PowerShiftKeySchedule.GeneratingUnit
        nc:PowerShiftKeySchedule.HydroPump
        nc:PowerShiftKeySchedule.PowerElectronicsUnit
        nc:PowerShiftKeySchedule.ScheduleResource
        nc:PowerShiftKeySchedule.SchedulingArea
                )];
        sh:minCount 1;
        sh:maxCount 1;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PowerShiftKeySchedule:associations" ;
        sh:order        2 ;
        sh:severity     sh:Violation .
        

sisc:PowerShiftKeyDistribution  a          sh:NodeShape ;
        sh:property      sisc:PowerShiftKeyDistribution-associations;
        sh:targetClass  nc:PowerShiftKeyDistribution .

sisc:PowerShiftKeyDistribution-associations
        a               sh:PropertyShape ;
        sh:description  "PowerShiftKeyDistribution shall include one and only one association to either PowerBidSchedule or PowerShiftKeyStrategy." ;
        sh:message      "PowerShiftKeyDistribution is not associated with either PowerBidSchedule or PowerShiftKeyStrategy or it is associated with both." ;
        sh:path [sh:alternativePath (
        nc:PowerShiftKeyDistribution.PowerBidSchedule
        nc:PowerShiftKeyDistribution.PowerShiftKeyStrategy
                )];
        sh:minCount 1;
        sh:maxCount 1;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PowerShiftKeyDistribution:associations" ;
        sh:order        3 ;
        sh:severity     sh:Violation .

sisc:GenericSequenceSchedule  a          sh:NodeShape ;
        sh:property      sisc:GenericSequenceSchedule-associations;
        sh:targetClass  nc:GenericSequenceSchedule .

sisc:GenericSequenceSchedule-associations
        a               sh:PropertyShape ;
        sh:description  "Association end GenericSequenceSchedule.EnergyBlockOrder is required." ;
    sh:message      "The association end GenericSequenceSchedule.EnergyBlockOrder is not provided." ;
        sh:path         nc:GenericSequenceSchedule.EnergyBlockOrder ;
    sh:minCount    1;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:GenericSequenceSchedule:associations" ;
        sh:order        4 ;
        sh:severity     sh:Violation .
    
sisc:PowerBidSchedule  a          sh:NodeShape ;
        sh:property      sisc:PowerBidSchedule-associations;
        sh:targetClass  nc:PowerBidSchedule .

sisc:PowerBidSchedule-associations
        a               sh:PropertyShape ;
        sh:description  "PowerBidSchedule shall include one and only one association to either ScheduleResource or PowerRemedialAction." ;
        sh:message      "PowerBidSchedule is not associated with either ScheduleResource or PowerRemedialAction or it is associated with both." ;
        sh:path [sh:alternativePath (
        nc:PowerBidSchedule.PowerRemedialAction
        nc:PowerBidSchedule.ScheduleResource
                )];
        sh:minCount 1;
        sh:maxCount 1;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PowerBidSchedule:associations" ;
        sh:order        5 ;
        sh:severity     sh:Violation .
      
sisc:PowerBidScheduleTimePoint  a          sh:NodeShape ;
        sh:property      sisc:PowerBidScheduleTimePoint-attributes;
        sh:targetClass  nc:PowerBidScheduleTimePoint .      

sisc:PowerBidScheduleTimePoint-attributes
        a               sh:PropertyShape ;
        sh:description  "PowerBidScheduleTimePoint can have the following combinations of optional attributes: 1) activationCost, 2) shutdownCost or 3) any of the following p, minimumActivationP, price, reservePrice, stepIncrementP." ;
        sh:sparql       sisc:PowerBidScheduleTimePoint-attributesSparql ;
        sh:path         rdf:type ;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PowerBidScheduleTimePoint:attributes" ;
        sh:order        6 ;
        sh:severity     sh:Violation .
        
sisc:PowerBidScheduleTimePoint-attributesSparql
    a         sh:SPARQLConstraint ;  
    sh:message      "PowerBidScheduleTimePoint does not have one of the following combinations of optional attributes: 1) activationCost, 2) shutdownCost or 3) any of the following p, minimumActivationP, price, reservePrice, stepIncrementP." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
    BIND(EXISTS{$this nc:PowerBidScheduleTimePoint.activationCost ?pac} AS ?vpac).  
    BIND(EXISTS{$this nc:PowerBidScheduleTimePoint.shutdownCost ?psc} AS ?vpsc).
    BIND(EXISTS{$this nc:PowerBidScheduleTimePoint.p ?pp} AS ?vpp).
    BIND(EXISTS{$this nc:PowerBidScheduleTimePoint.minimumActivationP ?pmap} AS ?vmap).
    BIND(EXISTS{$this nc:PowerBidScheduleTimePoint.price ?pprice} AS ?vpprice).
    BIND(EXISTS{$this nc:PowerBidScheduleTimePoint.reservePrice ?prp} AS ?vrp).
    BIND(EXISTS{$this nc:PowerBidScheduleTimePoint.stepIncrementP ?psip} AS ?vsip).

        FILTER (
      (?vpac="true"^^xsd:boolean && ?vpsc="true"^^xsd:boolean ) || 
      ((?vpac="true"^^xsd:boolean || ?vpsc="true"^^xsd:boolean) && (?vpp="true"^^xsd:boolean || ?vmap="true"^^xsd:boolean || ?vpprice="true"^^xsd:boolean || ?vrp="true"^^xsd:boolean || ?vsip="true"^^xsd:boolean))
    ).
      }""" .     
      
sisc:PowerBidDependency  a          sh:NodeShape ;
        sh:property      sisc:PeerTemporalDependency.finishToFinishLagKind-required, sisc:PeerTemporalDependency.finishToStartLagKind-required, sisc:PeerTemporalDependency.overlapKind-required, sisc:PeerTemporalDependency.startToStartLagKind-required, sisc:PeerTemporalDependency.constraintKind-exclusive;
        sh:targetClass  nc:PowerBidDependency .      

sisc:PeerTemporalDependency.finishToFinishLagKind-required
        a               sh:PropertyShape ;
        sh:description  "If PeerTemporalDependency.finishToFinishLag is present PeerTemporalDependency.finishToFinishLagKind is required." ;
        sh:sparql       sisc:PeerTemporalDependency.finishToFinishLagKind-requiredSparql ;
        sh:path         rdf:type ;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PeerTemporalDependency.finishToFinishLagKind:required" ;
        sh:order        7 ;
        sh:severity     sh:Violation .
        
sisc:PeerTemporalDependency.finishToFinishLagKind-requiredSparql
    a         sh:SPARQLConstraint ;  
    sh:message      "PeerTemporalDependency.finishToFinishLagKind is missing when PeerTemporalDependency.finishToFinishLag is present." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
     
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToFinishLag ?ftf} AS ?hasftf).  
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToFinishLagKind ?ftfk} AS ?hasftfk).
    
        FILTER (?hasftf="true"^^xsd:boolean && ?hasftfk="false"^^xsd:boolean).
      }""" .     

sisc:PeerTemporalDependency.finishToStartLagKind-required
        a               sh:PropertyShape ;
        sh:description  "If PeerTemporalDependency.finishToStartLag is present PeerTemporalDependency.finishToStartLagKind is required." ;
        sh:sparql       sisc:PeerTemporalDependency.finishToStartLagKind-requiredSparql ;
        sh:path         rdf:type ;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PeerTemporalDependency.finishToStartLagKind:required" ;
        sh:order        8 ;
        sh:severity     sh:Violation .
        
sisc:PeerTemporalDependency.finishToStartLagKind-requiredSparql
    a         sh:SPARQLConstraint ;  
    sh:message      "PeerTemporalDependency.finishToStartLagKind is missing when PeerTemporalDependency.finishToStartLag is present." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
     
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToStartLag ?fts} AS ?hasfts).  
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToStartLagKind ?ftsk} AS ?hasftsk).
    
        FILTER (?hasfts="true"^^xsd:boolean && ?hasftsk="false"^^xsd:boolean).
      }""" .       
      
sisc:PeerTemporalDependency.overlapKind-required
        a               sh:PropertyShape ;
        sh:description  "If PeerTemporalDependency.overlap is present PeerTemporalDependency.overlapKind is required." ;
        sh:sparql       sisc:PeerTemporalDependency.overlapKind-requiredSparql ;
        sh:path         rdf:type ;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PeerTemporalDependency.overlapKind:required" ;
        sh:order        9 ;
        sh:severity     sh:Violation .
        
sisc:PeerTemporalDependency.overlapKind-requiredSparql
    a         sh:SPARQLConstraint ;  
    sh:message      "PeerTemporalDependency.overlapKind is missing when PeerTemporalDependency.overlap is present." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
     
    BIND(EXISTS{$this nc:PeerTemporalDependency.overlap ?op} AS ?hasop).  
    BIND(EXISTS{$this nc:PeerTemporalDependency.overlapKind ?opk} AS ?hasopk).
    
        FILTER (?hasop="true"^^xsd:boolean && ?hasopk="false"^^xsd:boolean).
      }""" .     

sisc:PeerTemporalDependency.startToStartLagKind-required
        a               sh:PropertyShape ;
        sh:description  "If PeerTemporalDependency.startToStartLag is present PeerTemporalDependency.startToStartLagKind is required." ;
        sh:sparql       sisc:PeerTemporalDependency.startToStartLagKind-requiredSparql ;
        sh:path         rdf:type ;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PeerTemporalDependency.startToStartLagKind:required" ;
        sh:order        10 ;
        sh:severity     sh:Violation .
        
sisc:PeerTemporalDependency.startToStartLagKind-requiredSparql
    a         sh:SPARQLConstraint ;  
    sh:message      "PeerTemporalDependency.startToStartLagKind is missing when PeerTemporalDependency.startToStartLag is present." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
     
    BIND(EXISTS{$this nc:PeerTemporalDependency.startToStartLag ?sts} AS ?hassts).  
    BIND(EXISTS{$this nc:PeerTemporalDependency.startToStartLagKind ?stsk} AS ?hasstsk).
    
        FILTER (?hassts="true"^^xsd:boolean && ?hasstsk="false"^^xsd:boolean).
      }""" .         
      
sisc:PeerTemporalDependency.constraintKind-exclusive
        a               sh:PropertyShape ;
        sh:description  "If PeerTemporalDependency.constraintKind is set to DependencyConstraintKind.exclusive, the following attributes shall not be defined: PeerTemporalDependency.overlap, PeerTemporalDependency.startToStartLag, PeerTemporalDependency.finishToStartLag, PeerTemporalDependency.finishToFinishLag." ;
        sh:sparql       sisc:PeerTemporalDependency.constraintKind-exclusiveSparql ;
        sh:path         rdf:type ;
        sh:group        sisc:SISCustomGroup ;
        sh:name         "C:NC:SIS:PeerTemporalDependency.constraintKind:exclusive" ;
        sh:order        11 ;
        sh:severity     sh:Violation .
        
sisc:PeerTemporalDependency.constraintKind-exclusiveSparql
    a         sh:SPARQLConstraint ;  
    sh:message      "Some of the following attributes are defined: PeerTemporalDependency.overlap, PeerTemporalDependency.startToStartLag, PeerTemporalDependency.finishToStartLag, PeerTemporalDependency.finishToFinishLag when PeerTemporalDependency.constraintKind is set to DependencyConstraintKind.exclusive." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
    $this nc:PeerTemporalDependency.constraintKind nc:DependencyConstraintKind.exclusive.
    
    BIND(EXISTS{$this nc:PeerTemporalDependency.overlap ?op} AS ?hasop).  
    BIND(EXISTS{$this nc:PeerTemporalDependency.startToStartLag ?sts} AS ?hassts).
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToStartLag ?fts} AS ?hasfts).
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToFinishLag ?ftf} AS ?hasftf).
    
        FILTER (?hasop="true"^^xsd:boolean || ?hassts="true"^^xsd:boolean || ?hasfts="true"^^xsd:boolean || ?hasftf="true"^^xsd:boolean).
      }""" .       