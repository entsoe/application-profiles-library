targetUdc nc:FrequencyControlFunction.frequencyBias cim17:EquivalentInjection.p nc:PowerShiftKeyStrategy.enabled nc:DCFiringAngleControlFunction.targetValue cim16:ACDCConverter.targetPpcc cim:Equipment.networkAnalysisEnabled cim17:ACDCConverter.targetUdc nc:GateInputPin.enabled nc:BiddingZoneBorder.netTransferCapacity cim17:RegulatingControl.discrete nc:AssessedElement.positiveVirtualMargin nc:DCEquivalentInjection.p nc:GridStateAlteration.participationFactor cim17:VsConverter.targetUpcc cim17:CsConverter.operatingMode cim17:ACDCTerminal.connected nc:InjectionController.mode cim:AsynchronousMachine.asynchronousMachineType cim16:ControlArea.pTolerance nc:ThyristorControlledSeriesCompensator.currentSection nc:SchedulingArea.participationFactor cim16:TapChanger.controlEnabled cim:Equipment.inService nc:PTCActivePowerSupport.value nc:GridPowerCapacity.netACInterchange cim17:ShuntCompensator.sections cim:EquivalentInjection.q cim16:EnergyConsumer.p cim:EquivalentInjection.regulationTarget cim:VsConverter.targetQpcc cim16:RegulatingControl.targetValueUnitMultiplier cim17:SynchronousMachine.operatingMode cim17:TapChanger.controlEnabled cim:RegulatingControl.maxAllowedTargetValue cim17:EnergySource.voltageMagnitude cim:ACDCConverter.uc cim16:SynchronousMachine.operatingMode nc:DCPole.q nc:EnergyResourceGroupCapacity.availableCapacityP cim16:TapChanger.step cim:GeneratingUnit.normalPF cim:VsConverter.pPccControl cim:VsConverter.targetPWMfactor nc:GeneratingUnit.warmStartupCost cim16:EquivalentInjection.regulationStatus cim:ACDCTerminal.connected cim16:ShuntCompensator.sections cim:ActivePowerLimit.value nc:DCSwitch.open nc:AssessedElement.maxFlow nc:EnergyBlockOrder.participationFactor nc:AssessedElement.maxMarginAdjustment nc:RemedialAction.available cim16:EquivalentInjection.p nc:BiddingZoneBorder.transmissionReliabilityMargin cim17:CsConverter.pPccControl cim16:VsConverter.targetQpcc cim17:VsConverter.targetQpcc cim:CsConverter.targetIdc cim17:ExternalNetworkInjection.p cim:RegulatingControl.enabled cim:EnergyConsumer.q nc:EnergyResourceGroupCapacity.p cim17:EquivalentInjection.regulationStatus nc:AssessedElement.targetRemainingAvailableMarginJustification nc:DCPole.maxEconomicP cim17:VsConverter.pPccControl cim:BatteryUnit.batteryState cim16:EnergySource.reactivePower nc:CurrentDroopControlFunction.targetValueCapacitive cim:ACDCConverter.idc cim17:BatteryUnit.storedE nc:CircuitShare.contributionFactor nc:RemedialActionScheme.armed cim17:ACDCConverter.idc cim16:CsConverter.targetIdc nc:ACEmulationControlFunction.referenceP cim16:VsConverter.pPccControl cim17:RotatingMachine.p nc:AreaReserveResource.contractedP nc:PowerFactorControlFunction.targetValue cim17:RegulatingControl.targetValueUnitMultiplier cim:PowerElectronicsConnection.p nc:BiddingZone.netPosition nc:DCExtinctionAngleControlFunction.targetValue nc:AssessedElement.appointedMargin nc:VoltageControlFunction.targetValue cim:Switch.open cim16:Switch.open nc:VoltageInjectionControlFunction.targetValue cim:TapChanger.step cim16:SynchronousMachine.referencePriority nc:ThyristorControlledSeriesCompensator.compensationZ cim17:CsConverter.targetIdc cim:VsConverter.qShare nc:InfeedLimit.valueW nc:StageTrigger.inService cim:VsConverter.qPccControl nc:FunctionBlock.enabled cim17:CsConverter.targetAlpha cim16:ACDCConverter.udc cim:ACDCConverter.targetUdc cim:TapChanger.controlEnabled cim:ExternalNetworkInjection.p cim17:VsConverter.droopCompensation cim:EnergySource.reactivePower nc:ACEmulationControlFunction.gain nc:GeneratingUnit.participationFactor cim16:VsConverter.droop nc:AssessedElement.enabled cim:CsConverter.targetGamma cim17:StaticVarCompensator.q cim17:RegulatingCondEq.controlEnabled cim16:RegulatingControl.targetValue cim:VsConverter.targetPhasePcc cim16:ExternalNetworkInjection.q nc:EnergyBlockOrder.p cim17:CsConverter.targetGamma nc:FuelStorage.energyStorage cim16:VsConverter.targetUpcc cim:Switch.locked cim:EnergySource.voltageMagnitude cim17:ACDCConverter.uc cim17:ACDCConverter.q cim16:EquivalentInjection.q cim16:AsynchronousMachine.asynchronousMachineType nc:GeneratingUnit.mustRunP cim:Contingency.mustStudy nc:SubstationController.mode cim17:ExternalNetworkInjection.q nc:AssessedElement.coordinatedValidationAdjustmentJustification cim16:ACDCConverter.p cim:GeneratingUnit.startupCost nc:Contingency.probability nc:Reservoir.energyStorage cim17:EquivalentInjection.q nc:DCPulseWidthModulationControlFunction.targetValue cim17:Equipment.networkAnalysisEnabled nc:RotatingMachineController.mode nc:AssessedElement.criticalElementJustification nc:LoadFrequencyControlArea.mFRRActivated cim16:RegulatingControl.enabled cim:CurrentLimit.value cim17:RegulatingControl.minAllowedTargetValue nc:EnergyConsumer.participationFactor nc:SSSCController.mode cim16:ExternalNetworkInjection.referencePriority cim17:VoltageLimit.value cim16:EnergyConsumer.q cim17:ControlArea.pTolerance nc:RemedialActionGroup.maxRegulatingDown cim:StaticVarCompensator.q cim:VsConverter.droop cim16:VsConverter.droopCompensation nc:ScheduleResource.participationFactor);
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:FunctionOutputVariable.PropertyReference:value" ;
        sh:order        5 ;
        sh:severity     sh:Violation .			
		
erc:EquivalentGeneratingUnit  a          sh:NodeShape ;
        sh:property      erc:RotatingMachine.GeneratingUnit-associationApplicability;
        sh:targetClass  nc:EquivalentGeneratingUnit .

erc:RotatingMachine.GeneratingUnit-associationApplicability
        a               sh:PropertyShape ;
        sh:description  "An EquivalentGeneratingUnit shall not be referenced by a RotatingMachine via the association end RotatingMachine.GeneratingUnit." ;
        sh:message      "A RotatingMachine is associated with a EquivalentGeneratingUnit" ;
		sh:maxCount		0;
		sh:path         [ sh:alternativePath  ( [ sh:inversePath  cim:RotatingMachine.GeneratingUnit ]
                                                [ sh:inversePath  cim17:RotatingMachine.GeneratingUnit ]
                                                [ sh:inversePath  cim16:RotatingMachine.GeneratingUnit ]
                                              )
                        ];
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:RotatingMachine.GeneratingUnit:associationApplicability" ;
        sh:order        6 ;
        sh:severity     sh:Violation .			

erc:InfeedLimit  a          sh:NodeShape ;
        sh:property     erc:InfeedLimit-requiredAttributes;
        sh:targetClass  nc:InfeedLimit .

erc:InfeedLimit-requiredAttributes
        a               sh:PropertyShape ;
        sh:description  "An InfeedLimit shall have either .normalValueA or .normalValueW." ;
        sh:sparql       erc:InfeedLimit-requiredAttributesSparql ;
        sh:path         rdf:type ;
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:InfeedLimit:requiredAttributes" ;
        sh:order        7 ;
        sh:severity     sh:Violation .
        
erc:InfeedLimit-requiredAttributesSparql
		a         sh:SPARQLConstraint ;  
		sh:message      "InfeedLimit does not have either .normalValueA or .normalValueW." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this  
			WHERE {      
       
		BIND(EXISTS{$this nc:InfeedLimit.normalValueA ?o1} AS ?hasNVA).
		BIND(EXISTS{$this nc:InfeedLimit.normalValueW ?o2} AS ?hasNVW).
        FILTER (?hasNVA="false"^^xsd:boolean && ?hasNVW="false"^^xsd:boolean).
			}""" . 			

erc:CrossZonalNetworkElement
    a sh:NodeShape ;
    sh:targetClass nc:CrossZonalLine, nc:CrossZonalPowerTransformer, nc:CrossZonalDCPole ;
    sh:property erc:CrossZonalNetworkElement.BiddingZoneBorder-usage.

erc:CrossZonalNetworkElement.BiddingZoneBorder-usage
    a sh:PropertyShape ;
	sh:name "C:NC:ER:CrossZonalNetworkElement.BiddingZoneBorder:usage" ;
	sh:description "A CrossZonalNetworkElement shall be associated with exactly two BiddingZoneBorder instances. The two associated BiddingZoneBorder instances shall represent the same pair of bidding zones, but in opposite directions. This means that the FromBiddingZone of one BiddingZoneBorder shall be equal to the ToBiddingZone of the other BiddingZoneBorder, and the ToBiddingZone of the first BiddingZoneBorder shall be equal to the FromBiddingZone of the other. The two bidding zones shall be different." ;
    sh:path nc:CrossZonalNetworkElement.BiddingZoneBorder ;
	sh:sparql erc:CrossZonalNetworkElement.BiddingZoneBorder-usageSparql ;
	sh:group        erc:ERgroup ;
	sh:order        8 ;
    sh:severity sh:Violation .

erc:CrossZonalNetworkElement.BiddingZoneBorder-usageSparql
    a sh:SPARQLConstraint ;
    sh:message "The two BiddingZoneBorder instances do not represent the same pair of different bidding zones in opposite directions." ;
    sh:prefixes cim: ;
    sh:select """
        SELECT DISTINCT $this
        WHERE {
            $this $PATH ?border1 .
            $this $PATH ?border2 .

            FILTER (?border1 != ?border2)

            ?border1
                nc:BiddingZoneBorder.FromBiddingZone ?from1 ;
                nc:BiddingZoneBorder.ToBiddingZone   ?to1 .

            ?border2
                nc:BiddingZoneBorder.FromBiddingZone ?from2 ;
                nc:BiddingZoneBorder.ToBiddingZone   ?to2 .

            FILTER (
                ?from1 = ?to1
                ||
                ?from1 != ?to2
                ||
                ?to1 != ?from2
            )
        }
    """ .	
	

erc:BoundaryPoint
    a sh:NodeShape ;
    sh:targetClass nc:BoundaryPoint ;
    sh:property erc:BoundaryPoint-requiredAssociation,
                erc:BoundaryPoint-naming .


erc:BoundaryPoint-requiredAssociation
    a sh:PropertyShape ;
    sh:name "C:NC:ER:BoundaryPoint:requiredAssociation" ;
    sh:description "A BoundaryPoint shall have association to BoundaryPointBorder or BoundaryPointBorderLink and not both." ;
    sh:path rdf:type ;
    sh:sparql erc:BoundaryPoint-requiredAssociationSparql ;
    sh:group erc:ERgroup ;
    sh:order 9 ;
    sh:severity sh:Violation .


erc:BoundaryPoint-requiredAssociationSparql
    a sh:SPARQLConstraint ;
    sh:message "BoundaryPoint is not associated with neither BoundaryPointBorder nor BoundaryPointBorderLink." ;
    sh:prefixes cim: ;
    sh:select """
        SELECT $this
        WHERE {
            BIND(EXISTS {
                $this nc:BoundaryPoint.BoundaryPointBorder ?border .
            } AS ?hasBorder)

            BIND(EXISTS {
                $this ^nc:BoundaryPointBorderLink.BoundaryPoint ?borderLink .
            } AS ?hasBorderLink)

            FILTER (
                (?hasBorder="true"^^xsd:boolean && ?hasBorderLink="true"^^xsd:boolean)
                ||
                (?hasBorder="false"^^xsd:boolean && ?hasBorderLink="false"^^xsd:boolean)
            )
        }
    """ .


erc:BoundaryPoint-naming
    a sh:PropertyShape ;
    sh:name "C:NC:ER:BoundaryPoint:naming" ;
    sh:description "If both partyOneResourceName and partyTwoResourceName are provided, IdentifiedObject.name shall be <partyOneResourceName>-<partyTwoResourceName>." ;
    sh:path cim:IdentifiedObject.name ;
    sh:sparql erc:BoundaryPoint-namingSparql ;
    sh:group erc:ERgroup ;
    sh:order 12 ;
    sh:severity sh:Violation .


erc:BoundaryPoint-namingSparql
    a sh:SPARQLConstraint ;
    sh:message "BoundaryPoint name is not consistent with partyOneResourceName and partyTwoResourceName." ;
    sh:prefixes cim: ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this nc:BoundaryPoint.partyOneResourceName ?partyOneResourceName ;
                  nc:BoundaryPoint.partyTwoResourceName ?partyTwoResourceName .

            OPTIONAL {
                $this $PATH ?value .
            }

            BIND(CONCAT(STR(?partyOneResourceName), "-", STR(?partyTwoResourceName)) AS ?expectedName)

            FILTER (
                !BOUND(?value)
                || STR(?value) != ?expectedName
            )
        }
    """ .


erc:CommonResponsibilityPoint
    a sh:NodeShape ;
    sh:targetClass nc:PointOfCommonCoupling, nc:BoundaryPoint, nc:GridConnectionPoint, nc:EnergyExchangePoint ;
    sh:property erc:CommonResponsibilityPoint-requiredAssociation .


erc:CommonResponsibilityPoint-requiredAssociation
    a sh:PropertyShape ;
    sh:name "C:NC:ER:CommonResponsibilityPoint:requiredAssociation" ;
    sh:description "CommonResponsibilityPoint shall have association to either DCNode or ConnectivityNode and not both." ;
    sh:path rdf:type ;
    sh:sparql erc:CommonResponsibilityPoint-requiredAssociationSparql ;
    sh:group erc:ERgroup ;
    sh:order 10 ;
    sh:severity sh:Violation .


erc:CommonResponsibilityPoint-requiredAssociationSparql
    a sh:SPARQLConstraint ;
    sh:message "CommonResponsibilityPoint in not associated with neither DCNode nor ConnectivityNode or it is associated with both." ;
    sh:prefixes cim: ;
    sh:select """
        SELECT $this
        WHERE {
            BIND(EXISTS {
                $this nc:CommonResponsibilityPoint.DCNode ?dcNode .
            } AS ?hasDCNode)

            BIND(EXISTS {
                $this nc:CommonResponsibilityPoint.ConnectivityNode ?connectivityNode .
            } AS ?hasConnectivityNode)

            FILTER (
                (?hasDCNode="true"^^xsd:boolean && ?hasConnectivityNode="true"^^xsd:boolean)
                ||
                (?hasDCNode="false"^^xsd:boolean && ?hasConnectivityNode="false"^^xsd:boolean)
            )
        }
    """ .


erc:BoundaryPointBorderLink
    a sh:NodeShape ;
    sh:targetClass nc:BoundaryPointBorderLink ;
    sh:property erc:BoundaryPointBorderLink-usage .


erc:BoundaryPointBorderLink-usage
    a sh:PropertyShape ;
    sh:name "C:NC:ER:BoundaryPointBorderLink:usage" ;
    sh:description "BoundaryPointBorderLink shall only be used when a BoundaryPoint is associated with more than one BoundaryPointBorder. If a BoundaryPoint is associated with exactly one BoundaryPointBorder, the BoundaryPointBorderLink class shall not be used." ;
    sh:path nc:BoundaryPointBorderLink.BoundaryPoint ;
    sh:sparql erc:BoundaryPointBorderLink-usageSparql ;
    sh:group erc:ERgroup ;
    sh:order 11 ;
    sh:severity sh:Violation .


erc:BoundaryPointBorderLink-usageSparql
    a sh:SPARQLConstraint ;
    sh:message "BoundaryPointBorderLink is used for a BoundaryPoint that is not associated with more than one BoundaryPointBorder." ;
    sh:prefixes cim: ;
    sh:select """
        SELECT DISTINCT $this
        WHERE {
            $this $PATH  ?boundaryPoint.

            FILTER NOT EXISTS {
                ?boundaryPoint ^nc:BoundaryPointBorderLink.BoundaryPoint ?link1, ?link2 .

                FILTER (?link1 != ?link2)

                ?link1 nc:BoundaryPointBorderLink.BoundaryPointBorder ?border1 .
                ?link2 nc:BoundaryPointBorderLink.BoundaryPointBorder ?border2 .

                FILTER (?border1 != ?border2)
            }
        }
    """ .


erc:BoundaryPointBorder
    a sh:NodeShape ;
    sh:targetClass nc:BoundaryPointBorder ;
    sh:property erc:BoundaryPointBorder-naming,
                erc:BoundaryPointBorder-requiredAssociation .


erc:BoundaryPointBorder-naming
    a sh:PropertyShape ;
    sh:name "C:NC:ER:BoundaryPointBorder:naming" ;
    sh:description "If both partyOneName and partyTwoName are provided, IdentifiedObject.name shall be <partyOneName>-<partyTwoName>." ;
    sh:path cim:IdentifiedObject.name ;
    sh:sparql erc:BoundaryPointBorder-namingSparql ;
    sh:group erc:ERgroup ;
    sh:order 13 ;
    sh:severity sh:Violation .


erc:BoundaryPointBorder-namingSparql
    a sh:SPARQLConstraint ;
    sh:message "BoundaryPointBorder name is not consistent with partyOneName and partyTwoName." ;
    sh:prefixes cim: ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this nc:BoundaryPointBorder.partyOneName ?partyOneName ;
                  nc:BoundaryPointBorder.partyTwoName ?partyTwoName .

            OPTIONAL {
                $this $PATH ?value .
            }

            BIND(CONCAT(STR(?partyOneName), "-", STR(?partyTwoName)) AS ?expectedName)

            FILTER (
                !BOUND(?value)
                || STR(?value) != ?expectedName
            )
        }
    """ .


erc:BoundaryPointBorder-requiredAssociation
    a sh:PropertyShape ;
    sh:name "C:NC:ER:BoundaryPointBorder:requiredAssociation" ;
    sh:description "A BoundaryPointBorder shall have minimum one BoundaryPoint or one BoundaryPointBorderLink." ;
    sh:path rdf:type ;
    sh:sparql erc:BoundaryPointBorder-requiredAssociationSparql ;
    sh:group erc:ERgroup ;
    sh:order 14 ;
    sh:severity sh:Violation .


erc:BoundaryPointBorder-requiredAssociationSparql
    a sh:SPARQLConstraint ;
    sh:message "BoundaryPointBorder is not associated with a BoundaryPoint or a BoundaryPointBorderLink." ;
    sh:prefixes cim: ;
    sh:select """
        SELECT $this
        WHERE {
            BIND(EXISTS {
                ?boundaryPoint nc:BoundaryPoint.BoundaryPointBorder $this .
            } AS ?hasBoundaryPoint)

            BIND(EXISTS {
                ?borderLink nc:BoundaryPointBorderLink.BoundaryPointBorder $this .
            } AS ?hasBoundaryPointBorderLink)

            FILTER (?hasBoundaryPoint="false"^^xsd:boolean && ?hasBoundaryPointBorderLink="false"^^xsd:boolean)
        }
    """ .
	
erc:ThermalGeneratingUnitDependency  a          sh:NodeShape ;
        sh:property      erc:PeerTemporalDependency.constraintKind-exclusive;
        sh:targetClass  nc:ThermalGeneratingUnitDependency .      

erc:PeerTemporalDependency.finishToFinishLagKind-required
        a                    sh:NodeShape ;
        sh:targetSubjectsOf  nc:PeerTemporalDependency.finishToFinishLag ;
        sh:property          [ sh:path      nc:PeerTemporalDependency.finishToFinishLagKind ;
                                sh:minCount  1 ;
                                sh:message   "PeerTemporalDependency.finishToFinishLagKind is missing when PeerTemporalDependency.finishToFinishLag is present." ;
                                sh:name      "C:NC:ER:PeerTemporalDependency.finishToFinishLagKind:required" ;
                                sh:group     erc:ERgroup ;
                                sh:order     7 ;
                                sh:severity  sh:Violation ] .

erc:PeerTemporalDependency.finishToStartLagKind-required
        a                    sh:NodeShape ;
        sh:targetSubjectsOf  nc:PeerTemporalDependency.finishToStartLag ;
        sh:property          [ sh:path      nc:PeerTemporalDependency.finishToStartLagKind ;
                                sh:minCount  1 ;
                                sh:message   "PeerTemporalDependency.finishToStartLagKind is missing when PeerTemporalDependency.finishToStartLag is present." ;
                                sh:name      "C:NC:ER:PeerTemporalDependency.finishToStartLagKind:required" ;
                                sh:group     erc:ERgroup ;
                                sh:order     8 ;
                                sh:severity  sh:Violation ] .

erc:PeerTemporalDependency.overlapKind-required
        a                    sh:NodeShape ;
        sh:targetSubjectsOf  nc:PeerTemporalDependency.overlap ;
        sh:property          [ sh:path      nc:PeerTemporalDependency.overlapKind ;
                                sh:minCount  1 ;
                                sh:message   "PeerTemporalDependency.overlapKind is missing when PeerTemporalDependency.overlap is present." ;
                                sh:name      "C:NC:ER:PeerTemporalDependency.overlapKind:required" ;
                                sh:group     erc:ERgroup ;
                                sh:order     9 ;
                                sh:severity  sh:Violation ] .

erc:PeerTemporalDependency.startToStartLagKind-required
        a                    sh:NodeShape ;
        sh:targetSubjectsOf  nc:PeerTemporalDependency.startToStartLag ;
        sh:property          [ sh:path      nc:PeerTemporalDependency.startToStartLagKind ;
                                sh:minCount  1 ;
                                sh:message   "PeerTemporalDependency.startToStartLagKind is missing when PeerTemporalDependency.startToStartLag is present." ;
                                sh:name      "C:NC:ER:PeerTemporalDependency.startToStartLagKind:required" ;
                                sh:group     erc:ERgroup ;
                                sh:order     10 ;
                                sh:severity  sh:Violation ] .

erc:PeerTemporalDependency.constraintKind-exclusive
        a               sh:PropertyShape ;
        sh:description  "If PeerTemporalDependency.constraintKind is set to DependencyConstraintKind.exclusive, the following attributes shall not be defined: PeerTemporalDependency.overlap, PeerTemporalDependency.startToStartLag, PeerTemporalDependency.finishToStartLag, PeerTemporalDependency.finishToFinishLag." ;
        sh:sparql       erc:PeerTemporalDependency.constraintKind-exclusiveSparql ;
        sh:path         rdf:type ;
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:PeerTemporalDependency.constraintKind:exclusive" ;
        sh:order        11 ;
        sh:severity     sh:Violation .
        
erc:PeerTemporalDependency.constraintKind-exclusiveSparql
    a         sh:SPARQLConstraint ;  
    sh:message      "Some of the following attributes are defined: PeerTemporalDependency.overlap, PeerTemporalDependency.startToStartLag, PeerTemporalDependency.finishToStartLag, PeerTemporalDependency.finishToFinishLag when PeerTemporalDependency.constraintKind is set to DependencyConstraintKind.exclusive." ;
    sh:prefixes cim: ;
    sh:select """
      SELECT  $this  
      WHERE {  
    $this nc:PeerTemporalDependency.constraintKind nc:DependencyConstraintKind.exclusive.
    
    BIND(EXISTS{$this nc:PeerTemporalDependency.overlap ?op} AS ?hasop).  
    BIND(EXISTS{$this nc:PeerTemporalDependency.startToStartLag ?sts} AS ?hassts).
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToStartLag ?fts} AS ?hasfts).
    BIND(EXISTS{$this nc:PeerTemporalDependency.finishToFinishLag ?ftf} AS ?hasftf).
    
        FILTER (?hasop="true"^^xsd:boolean || ?hassts="true"^^xsd:boolean || ?hasfts="true"^^xsd:boolean || ?hasftf="true"^^xsd:boolean).
      }""" .       	