@prefix erc:  <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#> .
@prefix cim:     <https://cim.ucaiug.io/ns#> .
@prefix cim16:   <http://iec.ch/TC57/2013/CIM-schema-cim16#> .
@prefix cim17:   <http://iec.ch/TC57/CIM100#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nc:      <https://cim4.eu/ns/nc#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


erc:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:std:iec:61970-501:draft:ed-2" , "urn:iso:std:iec:61970-600-2:ed-1" , "urn:iso:std:iec:61970-301:ed-7:amd1" , "file://iec61970cim17v40_iec61968cim13v13a_iec62325cim03v17a.eap" ;
        dcterms:creator           "ENTSO-E CIM EG"@en ;
        dcterms:description       "The custom constraints for the equipment reliability profile."@en ;
        dcterms:identifier        "49701907-292e-4a91-a853-eee08fb9f0d9" ;
        dcterms:issued            "2026-08-09T12:09:21Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:modified          "2026-08-09"^^xsd:date ;
        dcterms:publisher         "ENTSO-E"@en ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "ENTSO-E"@en ;
        dcterms:title             "Equipment Reliability profile custom constraints"@en ;
        owl:versionIRI        <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4> ;
		dcterms:license        "https://www.apache.org/licenses/LICENSE-2.0" ;
        owl:versionInfo       "2.4.2"@en ;
        dcat:landingPage      "https://www.entsoe.eu/digital/cim/cim-for-grid-models-exchange/" ;
        dcat:theme            "constraints"@en .


erc:ERgroup
        a           sh:PropertyGroup ;
        rdfs:label  "EquipmentReliabilityGroup" ;
        sh:order    0 .
		

erc:AreaReserveResource  a          sh:NodeShape ;
        sh:property      erc:AreaReserveResource-associations, erc:AreaReserveResource-interconnection;
        sh:targetClass  nc:AreaReserveResource .



erc:AreaReserveResource-associations
        a               sh:PropertyShape ;
        sh:description  "The AreaReserveResource shall be associated with either GeneratingUnit, PowerElecronicsUnit, ScheduleResource or HydroPump." ;
        sh:sparql       erc:AreaReserveResource-associationsSparql ;
        sh:path         rdf:type ;
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:AreaReserveResource:associations" ;
        sh:order        1 ;
        sh:severity     sh:Violation .
        
erc:AreaReserveResource-associationsSparql
		a         sh:SPARQLConstraint ;  
		sh:message      "AreaReserveResource is not associated with either GeneratingUnit, PowerElecronicsUnit, ScheduleResource or HydroPump." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this  
			WHERE {      
       
		BIND(EXISTS{$this nc:AreaReserveResource.GeneratingUnit ?o1} AS ?adugu).
		BIND(EXISTS{$this nc:AreaReserveResource.PowerElecronicsUnit ?o2} AS ?adupe).
		BIND(EXISTS{$this nc:AreaReserveResource.ScheduleResource ?o4} AS ?adusr).
		BIND(EXISTS{$this nc:AreaReserveResource.HydroPump ?o5} AS ?aduhp).
        FILTER (?adugu="false"^^xsd:boolean && ?adupe="false"^^xsd:boolean && ?adusr="false"^^xsd:boolean && ?aduhp="false"^^xsd:boolean).
			}""" . 

erc:AreaReserveResource-interconnection
        a               sh:PropertyShape ;
        sh:description  "An AreaReserveResource shall be associated with either a SchedulingArea or a TieCorridor, but not both." ;
        sh:sparql       erc:AreaReserveResource-interconnectionSparql ;
        sh:path         rdf:type ;
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:AreaReserveResource:interconnection" ;
        sh:order        1 ;
        sh:severity     sh:Violation .
        
erc:AreaReserveResource-interconnectionSparql
		a         sh:SPARQLConstraint ;  
		sh:message      "AreaReserveResource is not associated with either TieCorridor or SchedulingArea." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this  
			WHERE {      
       
		BIND(EXISTS{$this nc:AreaReserveResource.SchedulingArea ?o1} AS ?sa).
		BIND(EXISTS{$this nc:AreaReserveResource.TieCorridor ?o2} AS ?tc).

        FILTER (?sa="false"^^xsd:boolean && ?tc="false"^^xsd:boolean ).
			}""" .			
			
erc:EnergyComponent  a          sh:NodeShape ;
        sh:property      erc:EnergyComponent-associations;
        sh:targetClass  nc:EnergyComponent .



erc:EnergyComponent-associations
        a               sh:PropertyShape ;
        sh:description  "The EnergyComponent shall be associated with either GeneratingUnit, PowerElecronicsUnit, EnergyConsumer or HydroPump." ;
        sh:sparql       erc:EnergyComponent-associationsSparql ;
        sh:path         rdf:type ;
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:EnergyComponent:associations" ;
        sh:order        2 ;
        sh:severity     sh:Violation .
        
erc:EnergyComponent-associationsSparql
		a         sh:SPARQLConstraint ;  
		sh:message      "EnergyComponent is not associated with either GeneratingUnit, PowerElecronicsUnit, EnergyConsumer or HydroPump." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this  
			WHERE {      
       
		BIND(EXISTS{$this nc:EnergyComponent.GeneratingUnit ?o1} AS ?adugu).
		BIND(EXISTS{$this nc:EnergyComponent.PowerElecronicsUnit ?o2} AS ?adupe).
		BIND(EXISTS{$this nc:EnergyComponent.EnergyConsumer ?o2} AS ?aduec).
		BIND(EXISTS{$this nc:EnergyComponent.HydroPump ?o2} AS ?aduhp).
        FILTER (?adugu="false"^^xsd:boolean && ?adupe="false"^^xsd:boolean && ?aduec="false"^^xsd:boolean && ?aduhp="false"^^xsd:boolean).
			}""" . 			
			
			
erc:HydroPowerPlant  a          sh:NodeShape ;
        sh:property      erc:HydroPowerPlant-operatingMode;
        sh:targetClass  cim:HydroPowerPlant, cim16:HydroPowerPlant, cim17:HydroPowerPlant .			
		
erc:HydroPowerPlant-operatingMode
        a               sh:PropertyShape ;
        sh:description  "The SynchronousMachine.operatingMode of all SynchronousMachine objects part of a HydroPowerPlant shall be consistent." ;
        sh:sparql       erc:HydroPowerPlant-operatingModeSparql ;
        sh:path         rdf:type ;
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:HydroPowerPlant:operatingMode" ;
        sh:order        3 ;
        sh:severity     sh:Violation .
        
erc:HydroPowerPlant-operatingModeSparql
		a         sh:SPARQLConstraint ;  
		sh:message      "The SynchronousMachine.operatingMode is not consistent for all SynchronousMachine objects part of a HydroPowerPlant." ;
		sh:prefixes cim: ;
		sh:select """
	      SELECT $this (COUNT(?value) AS ?countv)
        WHERE {
        $this ^cim16:HydroGeneratingUnit.HydroPowerPlant/^cim16:RotatingMachine.GeneratingUnit/cim16:SynchronousMachine.operatingMode|^cim17:HydroGeneratingUnit.HydroPowerPlant/^cim17:RotatingMachine.GeneratingUnit/cim17:SynchronousMachine.operatingMode|^cim:HydroGeneratingUnit.HydroPowerPlant/^cim:RotatingMachine.GeneratingUnit/cim:SynchronousMachine.operatingMode|^cim16:HydroPump.HydroPowerPlant/cim16:HydroPump.RotatingMachine/cim16:SynchronousMachine.operatingMode|^cim17:HydroPump.HydroPowerPlant/cim17:HydroPump.RotatingMachine/cim17:SynchronousMachine.operatingMode|^cim:HydroPump.HydroPowerPlant/cim:HydroPump.RotatingMachine/cim:SynchronousMachine.operatingMode ?value .
        }
        GROUP BY $this ?value
        HAVING(?countv>1)
      """ .    

erc:Circuit  a          sh:NodeShape ;
        sh:property      erc:Circuit-associations;
        sh:targetClass  nc:LineCircuit, nc:PowerTransformerCircuit .



erc:Circuit-associations
        a               sh:PropertyShape ;
        sh:description  "The Circuit shall be associated with either Equipment or Terminal." ;
        sh:sparql       erc:Circuit-associationsSparql ;
        sh:path         rdf:type ;
        sh:group        erc:ERgroup ;
        sh:name         "C:NC:ER:Circuit:associations" ;
        sh:order        4 ;
        sh:severity     sh:Violation .
        
erc:Circuit-associationsSparql
		a         sh:SPARQLConstraint ;  
		sh:message      "Circuit is not associated with either Equipment or Terminal." ;
		sh:prefixes cim: ;
		sh:select """
			SELECT  $this  
			WHERE {      
       
		BIND(EXISTS{$this nc:Equipment.Circuit ?o1} AS ?ce).
		BIND(EXISTS{$this nc:Circuit.IdentifyingTerminal ?o2} AS ?ct).
        FILTER (?ce="false"^^xsd:boolean && ?ct="false"^^xsd:boolean).
			}""" . 		
			
erc:FunctionOutputVariable  a          sh:NodeShape ;
        sh:property      erc:FunctionOutputVariable.PropertyReference-value;
        sh:targetClass  nc:FunctionOutputVariable .



erc:FunctionOutputVariable.PropertyReference-value
        a               sh:PropertyShape ;
        sh:description  "The value of the association end FunctionOutputVariable.PropertyReference shall be one of the values published in the PropertyReference collection." ;
        sh:message      "The value of the PropertyReference is not part of the reference data." ;
        sh:path         nc:FunctionOutputVariable.PropertyReference ;
		sh:in			(nc:PowerElectronicsUnit.participationFactor cim17:VsConverter.droop cim:SynchronousMachine.referencePriority cim17:EnergySource.activePower nc:EnergyResourceGroupCapacity.participationFactor nc:ReactivePowerControlFunction.targetValue nc:AssessedElementWithRemedialAction.enabled cim:ACDCConverter.p cim17:ExternalNetworkInjection.referencePriority nc:TCSCController.mode cim17:ControlArea.netInterchange cim17:RegulatingControl.targetDeadband nc:DCPole.minEconomicP nc:GeneratingUnit.costCurrency nc:DCPole.participationFactor cim:ShuntCompensator.sections cim16:CsConverter.targetAlpha nc:AreaReserveResource.availableP cim:CsConverter.targetAlpha nc:AreaReserveResource.enabled cim:EquivalentInjection.regulationStatus nc:AssessedElementWithContingency.enabled cim:SynchronousMachine.operatingMode nc:AssessedElement.individualValidationAdjustmentJustification nc:AssessedElement.scannedThresholdMargin nc:LoadFrequencyControlArea.mFRRContracted nc:StageTrigger.armed nc:BaseCaseCurrentLimit.value nc:GridPowerCapacity.minInterchange nc:CurrentDroopOverride.enabled cim:RotatingMachine.p nc:DCActivePowerControlFunction.targetValue cim17:EnergyConsumer.p nc:LoadFrequencyControlArea.aFRRContracted cim17:PowerElectronicsConnection.p cim17:Switch.open cim16:RegulatingControl.targetDeadband cim17:BatteryUnit.batteryState cim:EnergySource.voltageAngle cim16:VsConverter.qShare nc:CompensatorController.mode cim16:RotatingMachine.p nc:GridPowerCapacity.netACInterchangeTolerance nc:VoltageAngleLimit.value cim16:ACDCConverter.q nc:ACEmulationControlFunction.timeConstant cim16:RegulatingCondEq.controlEnabled cim17:RotatingMachine.q nc:DirectCurrentEquipmentController.mode cim:RegulatingControl.targetDeadband nc:CurrentDroopOverride.targetValueInductiveI cim:PowerElectronicsConnection.q cim17:ACDCConverter.udc cim16:ACDCTerminal.connected nc:RemedialActionScheme.inService nc:GridPowerCapacity.minImportP cim17:ActivePowerLimit.value cim17:ACDCConverter.targetPpcc cim16:CsConverter.pPccControl cim16:ControlArea.netInterchange nc:InfeedLimit.valueA nc:GridPowerCapacity.regulatingDownAllocation cim:ACDCConverter.targetPpcc nc:LoadFrequencyControlArea.aFRRAvailable cim:RegulatingCondEq.controlEnabled cim17:VsConverter.targetPWMfactor nc:BiddingZoneBorder.alreadyAllocatedCapacity nc:GeneratingUnit.isRamping cim16:ACDCConverter.idc cim:VoltageLimit.value nc:AutomationFunction.enabled nc:FACTSEquipment.q cim:ExternalNetworkInjection.q nc:BiddingZoneBorder.availableTransferCapacity cim:VsConverter.droopCompensation nc:GridPowerCapacity.regulatingUpAllocation cim17:EnergySource.reactivePower cim:ACDCConverter.q cim16:EnergySource.activePower nc:RemedialActionGroup.maxRegulatingUp cim16:CsConverter.targetGamma cim17:CurrentLimit.value nc:PhaseControlFunction.targetValue nc:SchedulingArea.p cim17:VsConverter.qPccControl nc:DCVoltageSource.voltageSetpoint cim16:GeneratingUnit.normalPF cim17:ApparentPowerLimit.value nc:HydroPump.participationFactor nc:BiddingZoneBorder.totalTransferCapacity nc:EnergyResourceGroupCapacity.availabilityFactor nc:GeneratingUnit.mustRunQ nc:GeneratingUnit.mustRun cim:ACDCConverter.udc nc:AreaReserveResource.activatedP cim:RotatingMachine.q nc:GridPowerCapacity.netDCInterchange nc:DCVoltageControlFunction.targetValue cim17:EnergyConsumer.q cim17:RegulatingControl.maxAllowedTargetValue nc:RangeConstraint.value cim16:CsConverter.operatingMode cim17:PowerElectronicsConnection.q nc:LoadFrequencyControlArea.fcrContracted nc:PowerElectronicsUnit.p cim:EnergyConsumer.p cim16:RotatingMachine.q nc:AssessedElement.individualValidationAdjustmentShare nc:BiddingZoneBorder.alreadyAllocatedFlow nc:EnergyResourceGroupCapacity.installedCapacityP nc:VoltageAngleControlFunction.targetValue cim17:Switch.locked nc:DCCurrentControlFunction.targetValue cim:RegulatingControl.targetValueUnitMultiplier nc:LoadFrequencyControlArea.aFRRActivated nc:AreaReserveResource.kind cim17:VsConverter.targetPowerFactorPcc nc:AssessedElement.coordinatedValidationAdju