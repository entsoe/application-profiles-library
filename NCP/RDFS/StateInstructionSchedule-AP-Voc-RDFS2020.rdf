  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerRemedialAction">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Energy remedial action describes actions to rearrange power schedules.</rdfs:comment>
    <rdfs:label xml:lang="en">PowerRemedialAction</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
