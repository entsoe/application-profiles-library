  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCPole">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The direct current (DC) system pole (IEC 60633) is part of a DC system consisting of all the equipment in the DC substations and the interconnecting transmission lines, if any, which during normal operation exhibit a common direct voltage polarity with respect to earth.
It includes active power, reactive power and participation factor to be able to schedule top down (using DCTieCorridor and participation factor to provide schedule on the DCPole) and bottom up (aggregation of DCPole to DCTieCorridor). Only one approach can be used at a time.</rdfs:comment>
    <rdfs:label xml:lang="en">DCPole</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCPulseWidthModulationControlFunction">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Direct current pulse width modulation control function is a function block that calculates operating point of the controlled equipment to achieve the target pulse width modulation.</rdfs:comment>
    <rdfs:label xml:lang="en">DCPulseWidthModulationControlFunction</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCPulseWidthModulationControlFunctionSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for DCPulseWidthModulationControlFunction.</rdfs:comment>
    <rdfs:label xml:lang="en">DCPulseWidthModulationControlFunctionSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCPulseWidthModulationControlFunctionTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Direct current pulse width modulation control function value for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">DCPulseWidthModulationControlFunctionTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCVoltageControlFunction">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>DC voltage control function is a function block that calculate the operating point of the controlled equipment to achieve the target voltage.</rdfs:comment>
    <rdfs:label xml:lang="en">DCVoltageControlFunction</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCVoltageControlFunctionSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for DCVoltageControlFunction.</rdfs:comment>
    <rdfs:label xml:lang="en">DCVoltageControlFunctionSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCVoltageControlFunctionTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>DC voltage control function value for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">DCVoltageControlFunctionTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Date">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#DocStateInstructionScheduleProfile"/>
    <rdfs:comment>Date as "yyyy-mm-dd", which conforms with ISO 8601. UTC time zone is specified as "yyyy-mm-ddZ". A local timezone relative UTC is specified as "yyyy-mm-dd(+/-)hh:mm".</rdfs:comment>
    <rdfs:label xml:lang="en">Date</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#DateTime">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Date and time as "yyyy-mm-ddThh:mm:ss.sss", which conforms with ISO 8601. UTC time zone is specified as "yyyy-mm-ddThh:mm:ss.sssZ". A local timezone relative UTC is specified as "yyyy-mm-ddThh:mm:ss.sss-hh:mm". The second component (shown here as "ss.sss") could have any number of digits in its fractional part to allow any kind of precision beyond seconds.</rdfs:comment>
    <rdfs:label xml:lang="en">DateTime</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DayOfWeekKind">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The kind of day to be included in a regular schedule.</rdfs:comment>
    <rdfs:label xml:lang="en">DayOfWeekKind</rdfs:label>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#enumeration"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Decimal">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Decimal is the base-10 notational system for representing real numbers.</rdfs:comment>
    <rdfs:label xml:lang="en">Decimal</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DependencyConstraintKind">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The kind of dependency constraint defined between the dependee and dependent peer objects.
Note: The dependee is the peer object upon which another peer object depends. The dependent is the peer object whose temporal or operational behaviour is constrained by the dependee. Although dependee is not a commonly used English term, it is used here to distinguish this relationship from a parent-child hierarchy, as both objects are peer instances of the same class.</rdfs:comment>
    <rdfs:label xml:lang="en">DependencyConstraintKind</rdfs:label>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#enumeration"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Duration">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Duration as "PnYnMnDTnHnMnS" which conforms to ISO 8601, where nY expresses a number of years, nM a number of months, nD a number of days. The letter T separates the date expression from the time expression and, after it, nH identifies a number of hours, nM a number of minutes and nS a number of seconds. The number of seconds could be expressed as a decimal number, but all other numbers are integers.</rdfs:comment>
    <rdfs:label xml:lang="en">Duration</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnablingTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Enabling instruction value at a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">EnablingTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyBlockOrder">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The energy block order is a block (an amount) of energy that forms the sequence of orders that are going to be distributed to an energy block component.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyBlockOrder</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#EnergyConnection">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>A connection of energy generation or consumption on the power system model.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyConnection</rdfs:label>
    <rdfs:subClassOf rdf:resource="#ConductingEquipment"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#EnergyConsumer">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Generic user of energy - a  point of consumption on the power system model.
EnergyConsumer.pfixed, .qfixed, .pfixedPct and .qfixedPct have meaning only if there is no LoadResponseCharacteristic associated with EnergyConsumer or if LoadResponseCharacteristic.exponentModel is set to False.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyConsumer</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>An aggregation of energy resources having common energy characteristics for which installed, available, or effective capacity is represented.

Note: EnergyResourceGroupCapacity groups energy resources for capacity modelling, forecasting, scenario analysis and aggregation. The group may be characterised by an energy kind, energy source, technology, location, scenario, weather condition or other modelling context.
The aggregated capacity may be represented by static values or by time-series values describing forecast, scheduled, actual or hindcast conditions. An EnergyComponent represents the part of an aggregated value associated with a particular underlying unit or resource. The aggregated value of the EnergyResourceGroupCapacity may therefore be distributed among its associated EnergyComponents, for example in proportion to the capability of the corresponding units or according to an ordered block-based allocation.
Weather or other environmental information may be referenced where it is relevant to the capacity or availability of the grouped resources/</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyResourceGroupCapacity</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacityRegularSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Regular schedule for EnergyResourceGroupCapacity.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyResourceGroupCapacityRegularSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseRegularIntervalSchedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacitySchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The irregular schedule for the energy resource capacity group.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyResourceGroupCapacitySchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacityTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Energy resource group capacity value at a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyResourceGroupCapacityTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyScenarioKind">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Kind of energy scenario.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergyScenarioKind</rdfs:label>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#enumeration"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#EnergySource">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>A generic equivalent for an energy supplier on a transmission or distribution voltage level.</rdfs:comment>
    <rdfs:label xml:lang="en">EnergySource</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Equipment">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The parts of a power system that are physical devices, electronic or mechanical.</rdfs:comment>
    <rdfs:label xml:lang="en">Equipment</rdfs:label>
    <rdfs:subClassOf rdf:resource="#PowerSystemResource"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#EquivalentInjection">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>This class represents equivalent injections (generation or load).  Voltage regulation is allowed only at the point of connection.</rdfs:comment>
    <rdfs:label xml:lang="en">EquivalentInjection</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ExternalNetworkInjection">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>This class represents the external network and it is used for IEC 60909 calculations.</rdfs:comment>
    <rdfs:label xml:lang="en">ExternalNetworkInjection</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Float">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>A floating point number. The range is unspecified and not limited.</rdfs:comment>
    <rdfs:label xml:lang="en">Float</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Frequency">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Cycles per second.</rdfs:comment>
    <rdfs:label xml:lang="en">Frequency</rdfs:label>
    <cims:stereotype>CIMDatatype</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FrequencyControlFunction">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Frequency control function is a function block that calculate the operating point of the controlled equipment to achieve the target frequency.</rdfs:comment>
    <rdfs:label xml:lang="en">FrequencyControlFunction</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FrequencyControlFunctionSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for FrequencyControlFunction.</rdfs:comment>
    <rdfs:label xml:lang="en">FrequencyControlFunctionSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FrequencyControlFunctionTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Frequency control function value for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">FrequencyControlFunctionTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FuelStorage">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Fuel storage. e.g. pile of coal that can be shared between multiple thermal generating units.</rdfs:comment>
    <rdfs:label xml:lang="en">FuelStorage</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FuelStorageSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Fuel storage schedule for elements.</rdfs:comment>
    <rdfs:label xml:lang="en">FuelStorageSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FuelStorageTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Fuel storage values for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">FuelStorageTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FunctionBlock">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Function block is a function described as a set of elementary blocks. The blocks describe the function between input variables and output variables.</rdfs:comment>
    <rdfs:label xml:lang="en">FunctionBlock</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GateInputPin">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Input pin for a logical gate. The condition described in the input pin gives a logical true or false. The result from measurement and calculation are converted to a true or false.</rdfs:comment>
    <rdfs:label xml:lang="en">GateInputPin</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#GeneratingUnit">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>A single or set of synchronous machines for converting mechanical power into alternating-current power. For example, individual machines within a set may be defined for scheduling purposes while a single control signal is derived for the set. In this case there would be a GeneratingUnit for each member of the set and an additional GeneratingUnit corresponding to the set.</rdfs:comment>
    <rdfs:label xml:lang="en">GeneratingUnit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GenericAvailableSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for the availability of elements.</rdfs:comment>
    <rdfs:label xml:lang="en">GenericAvailableSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GenericEnablingSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for the enabling of elements.</rdfs:comment>
    <rdfs:label xml:lang="en">GenericEnablingSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GenericSequenceSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Schedule for sequence.</rdfs:comment>
    <rdfs:label xml:lang="en">GenericSequenceSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GenericValueSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Time series represent irregular generic value at given points in time. The type of value is given by the reference association.  </rdfs:comment>
    <rdfs:label xml:lang="en">GenericValueSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GenericValueTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Generic value for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">GenericValueTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacity">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Grid power capacity defines the active power capacity that can be imported, exported, generated, consumed, or transferred within a defined power system area, or a combination of multiple areas (e.g. a bidding zone), considering relevant grid constraints required for secure and reliable operation.

Note: Grid power capacity represents a power system or network-constrained capacity, not the technical installed capacity of individual resources or groups of resources. It may describe limits on generation, consumption, import, export, or power transfer resulting from operational security limits, network constraints, capacity allocation, forecasted grid availability, planned outages, remedial actions, or market-relevant transmission limitations.</rdfs:comment>
    <rdfs:label xml:lang="en">GridPowerCapacity</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Regular schedule for GridPowerCapacity.</rdfs:comment>
    <rdfs:label xml:lang="en">GridPowerCapacityRegularSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseRegularIntervalSchedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacitySchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The irregular schedule for the capacity.</rdfs:comment>
    <rdfs:label xml:lang="en">GridPowerCapacitySchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Capacity instruction value at a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">GridPowerCapacityTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridStateAlteration">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Grid state alteration is a change of values describing state (operating point) of one element in the grid model compared to the base case.</rdfs:comment>
    <rdfs:label xml:lang="en">GridStateAlteration</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridStateAlterationSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Schedule for a grid state alteration.</rdfs:comment>
    <rdfs:label xml:lang="en">GridStateAlterationSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridStateAlterationTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Grid state alteration at a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">GridStateAlterationTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridStateIntensitySchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Defines the intensity applied for a given grid state alteration. It is primarily used in exchanges related to the remedial action schedule. The value provided by the schedule replaces the value of the attribute to which the schedule refers to.</rdfs:comment>
    <rdfs:label xml:lang="en">GridStateIntensitySchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#GenericValueSchedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#HourPattern">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Pattern of hourly period in a day with the same kind of intensity.</rdfs:comment>
    <rdfs:label xml:lang="en">HourPattern</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="#IdentifiedObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#HourPeriod">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Period of hours in a day.</rdfs:comment>
    <rdfs:label xml:lang="en">HourPeriod</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Hours">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Time specified in hours.</rdfs:comment>
    <rdfs:label xml:lang="en">Hours</rdfs:label>
    <cims:stereotype>CIMDatatype</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#HydroPump">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>A synchronous motor-driven pump, typically associated with a pumped storage plant.</rdfs:comment>
    <rdfs:label xml:lang="en">HydroPump</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim.ucaiug.io/ns/prof-cim#IRI">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#DocStateInstructionScheduleProfile"/>
    <rdfs:comment>An IRI (Internationalized Resource Identifier) within an RDF graph is a Unicode string that conforms to the syntax defined in RFC 3987.
The primitive is serialized as rdf:resource in RDFXML.
IRIs in the RDF abstract syntax must be absolute, and may contain a fragment identifier.
IRI equality: Two IRIs are equal if and only if they are equivalent under Simple String Comparison according to section 5.1 of [RFC3987]. Further normalization must not be performed when comparing IRIs for equality.
IRIs are a generalization of URIs [RFC3986] that permits a wider range of Unicode characters. Every absolute URI and URL is an IRI, but not every IRI is an URI. When IRIs are used in operations that are only defined for URIs, they must first be converted according to the mapping defined in section 3.1 of [RFC3987]. A notable example is retrieval over the HTTP protocol. The mapping involves UTF-8 encoding of non-ASCII characters, %-encoding of octets not allowed in URIs, and Punycode-encoding of domain names.</rdfs:comment>
    <rdfs:label xml:lang="en">IRI</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <cims:stereotype>profcim</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#IdentifiedObject">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>This is a root class to provide common identification for all classes needing identification and naming attributes.</rdfs:comment>
    <rdfs:label xml:lang="en">IdentifiedObject</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Impedance">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Ratio of voltage to current.</rdfs:comment>
    <rdfs:label xml:lang="en">Impedance</rdfs:label>
    <cims:stereotype>CIMDatatype</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ImpedanceControlFunction">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Impedance control function is a function block that calculates the operating point of the controlled equipment to achieve the target impedance.</rdfs:comment>
    <rdfs:label xml:lang="en">ImpedanceControlFunction</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ImpedanceControlFunctionSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for ImpedanceControlFunction.</rdfs:comment>
    <rdfs:label xml:lang="en">ImpedanceControlFunctionSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ImpedanceControlFunctionTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Impedance control function value for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">ImpedanceControlFunctionTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#InfeedLimit">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Infeed limit set constraints fed in to the network by two or more terminals.</rdfs:comment>
    <rdfs:label xml:lang="en">InfeedLimit</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#InfeedLimitSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for an infeed limit.</rdfs:comment>
    <rdfs:label xml:lang="en">InfeedLimitSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#InfeedLimitTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Infeed limit at a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">InfeedLimitTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Integer">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>An integer number. The range is unspecified and not limited.</rdfs:comment>
    <rdfs:label xml:lang="en">Integer</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#Irradiance">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Power carried by electromagnetic radiation incident on a surface per unit area.

Note: Intended for solar irradiance values such as global, direct and diffuse solar irradiance.</rdfs:comment>
    <rdfs:label xml:lang="en">Irradiance</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype>CIMDatatype</cims:stereotype>
    <cims:stereotype>new</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Length">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Unit of length. It shall be a positive value or zero.</rdfs:comment>
    <rdfs:label xml:lang="en">Length</rdfs:label>
    <cims:stereotype>CIMDatatype</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#MarketRegulationDirectionKind">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Identifies the direction of activation or reserve provision for a market regulation product or instrument (e.g., aFRR, mFRR, FCR). It expresses how the service affects the system balance — by increasing or decreasing net generation or consumption.</rdfs:comment>
    <rdfs:label xml:lang="en">MarketRegulationDirectionKind</rdfs:label>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#enumeration"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#MonthDay">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>MonthDay format as "--mm-dd", which conforms with XSD data type gMonthDay.</rdfs:comment>
    <rdfs:label xml:lang="en">MonthDay</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#PU">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Per Unit - a positive or negative value referred to a defined base. Values typically range from -10 to +10.</rdfs:comment>
    <rdfs:label xml:lang="en">PU</rdfs:label>
    <cims:stereotype>CIMDatatype</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ParticipationFactorTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Participation factor for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">ParticipationFactorTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PeakKind">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Kind of time period with similar intensity.</rdfs:comment>
    <rdfs:label xml:lang="en">PeakKind</rdfs:label>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#enumeration"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PeerTemporalDependency">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>An abstract directed dependency between two peer instances of the same domain class that defines temporal and operational constraints governing their relative execution or operation.
Note: Temporal lag constraints relate the next applicable transition of the dependent to the latest applicable transition of the dependee. A dependee transition remains applicable while the dependee remains in the state resulting from that transition. If the dependee subsequently changes state before the corresponding transition of the dependent occurs, the previous transition is superseded and the constraint is evaluated from the next applicable transition. Once the corresponding transition of the dependent has occurred, the lag constraint is satisfied for that operating cycle.
Each lag is qualified by its corresponding ReferenceValueKind, which specifies whether the lag represents an exact, minimum, or maximum temporal constraint.</rdfs:comment>
    <rdfs:label xml:lang="en">PeerTemporalDependency</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="#PerCent">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Percentage on a defined base.   For example, specify as 100 to indicate at the defined base.</rdfs:comment>
    <rdfs:label xml:lang="en">PerCent</rdfs:label>
    <cims:stereotype>CIMDatatype</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PhaseControlFunction">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Phase control function is a function block that calculate the operating point of the controlled equipment to achieve the target voltage.</rdfs:comment>
    <rdfs:label xml:lang="en">PhaseControlFunction</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PhaseControlFunctionSchedule">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>The schedule for PhaseControlFunction.</rdfs:comment>
    <rdfs:label xml:lang="en">PhaseControlFunctionSchedule</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
    <rdfs:subClassOf rdf:resource="https://cim4.eu/ns/nc#BaseIrregularTimeSeries"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PhaseControlFunctionTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Phase control function value for a given point in time.</rdfs:comment>
    <rdfs:label xml:lang="en">PhaseControlFunctionTimePoint</rdfs:label>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
