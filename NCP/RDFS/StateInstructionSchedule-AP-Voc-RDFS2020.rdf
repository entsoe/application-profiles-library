  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBidSchedule.PowerRemedialAction">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>Power remedial action for which the bid is given.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#PowerBidSchedule"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#PowerRemedialAction.PowerBidSchedule"/>
    <rdfs:label xml:lang="en">PowerRemedialAction</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#PowerRemedialAction"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBidSchedule.PowerShiftKeyDistribution">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>Distribution of the power bid amongst the power shift keys.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#PowerBidSchedule"/>
