    <rdfs:comment>The kind of secured exclusion reason.</rdfs:comment>
    <rdfs:label xml:lang="en">SecuredExclusionReasonKind</rdfs:label>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#enumeration"/>
