  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#AssessedElementTimePoint.coordinatedValidationAdjustmentJustification">
    <rdfs:comment>A text description provided by the coordinated capacity calculator (CCC) for justifying the reduction of Remaining Available Margin (RAM) by means of Coordinated Validation Adjustment (CVA). This justification is not intended for any application processing purpose, it should only be used for reporting.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#AssessedElementTimePoint"/>
