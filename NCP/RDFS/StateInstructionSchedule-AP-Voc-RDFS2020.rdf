  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#AssessedElementTimePoint.coordinatedValidationAdjustment">
    <rdfs:comment>A positive value expressed in MW, calculated and provided by the coordinated capacity calculator (CCC) for the reduction of Remaining Available Margin (RAM) in order to ensure grid security.</rdfs:comment>
