    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule.minImportP">
    <rdfs:comment>Minimum imported active power requirement.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule"/>
    <rdfs:label xml:lang="en">minImportP</rdfs:label>
