  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule.maxInterchange">
    <rdfs:comment>Maximum total active power (AC and DC)  that the net position for the bidding zone can have to maintain operational security. Positive sign means flow into the bidding zone.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule"/>
    <rdfs:label xml:lang="en">maxInterchange</rdfs:label>
