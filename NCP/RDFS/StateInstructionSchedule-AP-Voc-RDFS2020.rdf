  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#AssessedElementTimePoint.criticalElementJustification">
    <rdfs:comment>Justification indicating the kind of critical element contingency. This justification is not intended for any application processing purpose, it should only be used for reporting.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#AssessedElementTimePoint"/>
