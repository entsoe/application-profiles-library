    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule.minInterchange">
    <rdfs:comment>Minimum total active power (AC and DC)  that the net position for the bidding zone can have to maintain operational security. Negative sign means flow out of the bidding zone.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule"/>
    <rdfs:label xml:lang="en">minInterchange</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule.netACInterchange">
    <rdfs:comment>The netted aggregation of all AC external schedules of an area. Positive sign means flow into the area (Import).</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule"/>
    <rdfs:label xml:lang="en">netACInterchange</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule.netACInterchangeTolerance">
    <rdfs:comment>The area AC Net Position tolerance.</rdfs:comment>
    <cims:dataType rdf:resource="#Float"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GridPowerCapacityRegularSchedule"/>
    <rdfs:label xml:lang="en">netACInterchangeTolerance</rdfs:label>
