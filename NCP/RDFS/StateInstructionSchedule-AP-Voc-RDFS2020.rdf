    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBidSchedule.DependencyAsDependee">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The power bid dependency in which this power bid schedule is the dependee.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#PowerBidSchedule"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#PowerBidDependency.DependeePowerBidSchedule"/>
