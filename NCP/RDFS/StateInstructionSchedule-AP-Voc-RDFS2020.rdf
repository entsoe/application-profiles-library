    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#PowerBidDependency"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBidSchedule.DependencyAsDependent">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The power bid dependency in which this power bid schedule is the dependent.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#PowerBidSchedule"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#PowerBidDependency.DependentPowerBidSchedule"/>
    <rdfs:label xml:lang="en">DependencyAsDependent</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#PowerBidDependency"/>
