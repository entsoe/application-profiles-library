    <cims:stereotype>CIMDatatype</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#StageTrigger">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Stage that is triggered either by TriggerCondition or by gate condition within a stage.</rdfs:comment>
