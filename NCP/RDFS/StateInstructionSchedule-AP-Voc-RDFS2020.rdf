  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GridPowerCapacityTimePoint.minInterchange">
    <rdfs:comment>Minimum total active power (AC and DC)  that the net position for the bidding zone can have to maintain operational security. Negative sign means flow out of the bidding zone.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GridPowerCapacityTimePoint"/>
    <rdfs:label xml:lang="en">minInterchange</rdfs:label>
