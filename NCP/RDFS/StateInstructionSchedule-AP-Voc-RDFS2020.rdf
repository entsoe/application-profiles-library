    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The assessed element schedule that has this time point.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#AssessedElementTimePoint"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#AssessedElementSchedule.AssessedElementTimePoint"/>
