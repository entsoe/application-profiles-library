  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GenericValueTimePoint.value">
    <rdfs:comment>The value at the time. The meaning of the value is defined by the derived type of the associated schedule. The value can be integer, float or boolean. In case of boolean 1.0 equals true and 0.0 equals false. In case of integer the 0 should be included as a decimal, e.g. 2.0.</rdfs:comment>
    <cims:dataType rdf:resource="#Float"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GenericValueTimePoint"/>
