    <rdfs:comment>Tuesday as the day of the week.</rdfs:comment>
    <rdfs:label xml:lang="en">tuesday</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#DayOfWeekKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DayOfWeekKind.wednesday">
    <rdfs:comment>Wednesday as the day of the week.</rdfs:comment>
    <rdfs:label xml:lang="en">wednesday</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
