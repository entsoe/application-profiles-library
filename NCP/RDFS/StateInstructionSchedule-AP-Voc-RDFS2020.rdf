    <rdfs:comment>Value of the range constraint is replacing the attribute value referenced by the PropertyReference in a determined operational scenario.</rdfs:comment>
    <rdfs:label xml:lang="en">absolute</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ValueOffsetKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ValueOffsetKind.incremental">
    <rdfs:comment>Value of the range constraint is incrementing the attribute value referenced by the PropertyReference in a determined operational scenario.</rdfs:comment>
    <rdfs:label xml:lang="en">incremental</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ValueOffsetKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ValueOffsetKind.incrementalPercentage">
    <rdfs:comment>Value of the range constraint is incrementing in percentage the attribute value referenced by the PropertyReference in a determined operational scenario. </rdfs:comment>
    <rdfs:label xml:lang="en">incrementalPercentage</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ValueOffsetKind"/>
  </rdf:Description>
</rdf:RDF>
