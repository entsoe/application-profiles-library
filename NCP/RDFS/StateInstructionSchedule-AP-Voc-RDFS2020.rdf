    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBidDependency.DependentPowerBidSchedule">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The power bid schedule whose activation, deactivation, or execution is constrained by the dependee power bid schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#PowerBidDependency"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#PowerBidSchedule.DependencyAsDependent"/>
