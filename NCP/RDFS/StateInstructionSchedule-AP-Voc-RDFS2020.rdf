  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBidSchedule.PowerBidScheduleTimePoint">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>Power bid schedule time points which belong to a power bid schedule.</rdfs:comment>
