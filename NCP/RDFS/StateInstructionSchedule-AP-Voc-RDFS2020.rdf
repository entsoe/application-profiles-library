  <rdf:Description rdf:about="https://cim4.eu/ns/nc#SequenceTimePoint">
    <cims:belongsToCategory rdf:resource="https://ap-voc.cim4.eu/StateInstructionSchedule#StateInstructionScheduleProfile"/>
    <rdfs:comment>Sequence at a given point in time.</rdfs:comment>
