  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#AssessedElementTimePoint.exclusionReason">
    <rdfs:comment>Reason for not associating this assessed element with a secured region.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#AssessedElementTimePoint"/>
    <rdfs:label xml:lang="en">exclusionReason</rdfs:label>
