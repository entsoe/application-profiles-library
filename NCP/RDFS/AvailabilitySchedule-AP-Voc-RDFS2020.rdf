    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#OutageRequestVersion"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#OutageResponse.comment">
    <rdfs:comment>Free-text explanation, justification or additional information provided with the response to the outage request version.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#OutageResponse"/>
