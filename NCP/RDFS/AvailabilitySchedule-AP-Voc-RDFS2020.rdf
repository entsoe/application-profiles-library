  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RecordStatusKind.approved">
    <rdfs:comment>Indicates that the record version has been reviewed and formally accepted by the responsible entity.</rdfs:comment>
    <rdfs:label xml:lang="en">approved</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RecordStatusKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RecordStatusKind.cancelled">
    <rdfs:comment>Indicates that the record version has been withdrawn and is no longer valid for coordination. A cancelled record is retained only for audit and traceability.</rdfs:comment>
    <rdfs:label xml:lang="en">cancelled</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RecordStatusKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RecordStatusKind.closed">
    <rdfs:comment>Indicates that the record version has completed its lifecycle and no further action is required. The record remains available for reference but is not active in any process.</rdfs:comment>
    <rdfs:label xml:lang="en">closed</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RecordStatusKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RecordStatusKind.inProgress">
    <rdfs:comment>Indicates that the record version is actively being processed, updated, or evaluated as part of any coordination workflow.</rdfs:comment>
    <rdfs:label xml:lang="en">inProgress</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RecordStatusKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RecordStatusKind.new">
    <rdfs:comment>Indicates that the record version has been created but not yet submitted for review or coordination. It represents an initial draft state.</rdfs:comment>
    <rdfs:label xml:lang="en">new</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RecordStatusKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RecordStatusKind.pending">
    <rdfs:comment>Indicates that the record version has been submitted and is awaiting responses or decisions from assigned agents.</rdfs:comment>
    <rdfs:label xml:lang="en">pending</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RecordStatusKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RecordStatusKind.result">
    <rdfs:comment>Indicates that the record version represents a final outcome or result of any coordination process, typically summarising the consolidated decision or approved plan.</rdfs:comment>
    <rdfs:label xml:lang="en">result</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RecordStatusKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ReferenceValueKind.exact">
    <rdfs:comment>The referenced value is to be met exactly.</rdfs:comment>
    <rdfs:label xml:lang="en">exact</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ReferenceValueKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ReferenceValueKind.maximum">
    <rdfs:comment>The referenced value establishes a upper bound.</rdfs:comment>
    <rdfs:label xml:lang="en">maximum</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ReferenceValueKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ReferenceValueKind.minimum">
    <rdfs:comment>The referenced value establishes a lower bound.</rdfs:comment>
    <rdfs:label xml:lang="en">minimum</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ReferenceValueKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RequestResponseKind.accepted">
    <rdfs:comment>Indicates that the responding agent agrees and accept the request version as submitted.</rdfs:comment>
    <rdfs:label xml:lang="en">accepted</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RequestResponseKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RequestResponseKind.acceptedWithConditions">
    <rdfs:comment>Indicates that the responding agent can accept the request version only if specific conditions, modifications, or mitigations are met.</rdfs:comment>
    <rdfs:label xml:lang="en">acceptedWithConditions</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RequestResponseKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RequestResponseKind.acknowledged">
    <rdfs:comment>Indicates that the responding agent has received and reviewed the request version, but has not yet provided an approval or objection.</rdfs:comment>
    <rdfs:label xml:lang="en">acknowledged</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RequestResponseKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RequestResponseKind.alternativeProposal">
    <rdfs:comment>Indicates that the responding agent proposes alternative timing, duration, scope, or other adjustments to the request version.</rdfs:comment>
    <rdfs:label xml:lang="en">alternativeProposal</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RequestResponseKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RequestResponseKind.noResponseTimeout">
    <rdfs:comment>Indicates that the responding agent did not provide a response within the required timeframe, and the coordination process proceeded using a timeout rule.</rdfs:comment>
    <rdfs:label xml:lang="en">noResponseTimeout</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RequestResponseKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#RequestResponseKind.refused">
    <rdfs:comment>Indicates that the responding agent does not accept the request version due to operational, technical, or regulatory constraints.</rdfs:comment>
    <rdfs:label xml:lang="en">refused</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#RequestResponseKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#TimeSeriesInterpolationKind.previous">
    <rdfs:comment>The value between two time points is set to previous value.</rdfs:comment>
    <rdfs:label xml:lang="en">previous</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#TimeSeriesInterpolationKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="#UnitMultiplier.none">
    <rdfs:comment>No multiplier or equivalently multiply by 1.</rdfs:comment>
    <rdfs:label xml:lang="en">none</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="#UnitMultiplier"/>
  </rdf:Description>
  <rdf:Description rdf:about="#UnitSymbol.s">
    <rdfs:comment>Time in seconds.</rdfs:comment>
    <rdfs:label xml:lang="en">s</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="#UnitSymbol"/>
  </rdf:Description>
</rdf:RDF>
