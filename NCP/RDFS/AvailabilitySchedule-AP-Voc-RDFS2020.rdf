    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#DependencyConstraintKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DependencyConstraintKind.inclusive">
    <rdfs:comment>The dependent shall only be active or effective while the dependee is active or effective.</rdfs:comment>
    <rdfs:label xml:lang="en">inclusive</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#DependencyConstraintKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DependencyConstraintKind.restrictive">
    <rdfs:comment>The dependee constrains the dependent without requiring the dependent to become active or effective.
Note: A restrictive dependency defines temporal or operational constraints on the behaviour of the dependent while leaving its activation or operation optional.</rdfs:comment>
    <rdfs:label xml:lang="en">restrictive</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#DependencyConstraintKind"/>
  </rdf:Description>
