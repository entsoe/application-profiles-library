    <dcterms:description xml:lang="en">This vocabulary is describing the availability schedule profile.</dcterms:description>
    <dcterms:identifier>14c6b492-885e-4444-8123-2f649178d06c</dcterms:identifier>
    <dcat:keyword>AS</dcat:keyword>
    <dcterms:language>en-GB</dcterms:language>
    <dcterms:license xml:lang="en">https://www.apache.org/licenses/LICENSE-2.0</dcterms:license>
