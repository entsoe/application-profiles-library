    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.AreaInterchangeController">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>Area interchange controller for this control area.</rdfs:comment>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#AreaInterchangeController.ControlArea"/>
    <rdfs:label xml:lang="en">AreaInterchangeController</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#AreaInterchangeController"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.HasPart">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The control area that has these control area parts.</rdfs:comment>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#ControlArea.PartOf"/>
    <rdfs:label xml:lang="en">HasPart</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="#ControlArea"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.OutageCoordinationRegion">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The outage coordination region that has this control area.</rdfs:comment>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#OutageCoordinationRegion.ControlArea"/>
    <rdfs:label xml:lang="en">OutageCoordinationRegion</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
