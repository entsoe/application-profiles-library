  <rdf:Description rdf:about="https://cim4.eu/ns/nc#GateInputPin.absoluteValue">
    <rdfs:comment>Indicates if the absolute value is used for comparison. If true, use the absolute value. If false, use the complex value (vector). </rdfs:comment>
    <cims:dataType rdf:resource="#Boolean"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#GateInputPin"/>
    <rdfs:label xml:lang="en">absoluteValue</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
