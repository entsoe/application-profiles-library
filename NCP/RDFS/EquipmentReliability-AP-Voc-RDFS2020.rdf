    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#SSSCController.minInjectionU">
    <rdfs:comment>Minimum voltage that the device can inject.</rdfs:comment>
    <cims:dataType rdf:resource="#Voltage"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#SSSCController"/>
    <rdfs:label xml:lang="en">minInjectionU</rdfs:label>
