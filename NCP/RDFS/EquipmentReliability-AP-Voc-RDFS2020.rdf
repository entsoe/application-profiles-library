    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FrequencyMonitoringTerminal.PowerFrequencyController">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>Power frequency controller that has this frequency monitoring terminal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#FrequencyMonitoringTerminal"/>
