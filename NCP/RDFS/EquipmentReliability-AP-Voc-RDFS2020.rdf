    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#SSSCController.minLimitI">
    <rdfs:comment>Minimum operating current limit applied for the controller and used by any of the available control functions.</rdfs:comment>
    <cims:dataType rdf:resource="#CurrentFlow"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#SSSCController"/>
    <rdfs:label xml:lang="en">minLimitI</rdfs:label>
