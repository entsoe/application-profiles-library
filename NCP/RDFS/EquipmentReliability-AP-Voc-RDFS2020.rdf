  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinDCTerminal.DCTerminal">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The DC terminal that has this pin DC terminal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#PinDCTerminal"/>
