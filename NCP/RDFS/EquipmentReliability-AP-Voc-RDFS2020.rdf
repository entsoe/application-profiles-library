  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BiddingZone.isTradeEnabled">
    <rdfs:comment>Identifies the mechanism for determining the energy price for a given bidding zone. If true, the bid and the offer is expected to be provided for the bidding zone to create the market price. If false,  other mechanism determines the price of energy for a given bidding zone, e.g. virtual bidding zone.</rdfs:comment>
    <cims:dataType rdf:resource="#Boolean"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BiddingZone"/>
    <rdfs:label xml:lang="en">isTradeEnabled</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BiddingZoneBorder.AreaInterchangeController">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>Area interchange controller that relates to this bidding zone border.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#AreaInterchangeController.BiddingZoneBorder"/>
    <rdfs:label xml:lang="en">AreaInterchangeController</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#AreaInterchangeController"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BiddingZoneBorder.CapacityCalculationRegion">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The capacity calculation region for which the capacity is derived from.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#CapacityCalculationRegion.BiddingZoneBorder"/>
    <rdfs:label xml:lang="en">CapacityCalculationRegion</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#CapacityCalculationRegion"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BiddingZoneBorder.CrossZonalNetworkElement">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>A network element participating in the transfer of electrical power between two bidding zones and associated with the two opposite directional BiddingZoneBorder instances representing that bidding zone pair.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#CrossZonalNetworkElement.BiddingZoneBorder"/>
    <rdfs:label xml:lang="en">CrossZonalNetworkElement</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#CrossZonalNetworkElement"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BiddingZoneBorder.FromBiddingZone">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The bidding zone for the from side.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BiddingZone.FromBiddingZoneBorder"/>
    <rdfs:label xml:lang="en">FromBiddingZone</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BiddingZone"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BiddingZoneBorder.TieCorridor">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>Tie corridor for a given bidding zone border.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#TieCorridor.BiddingZoneBorder"/>
    <rdfs:label xml:lang="en">TieCorridor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#TieCorridor"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BiddingZoneBorder.ToBiddingZone">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The bidding zone for the to side.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BiddingZone.ToBiddingZoneBorder"/>
    <rdfs:label xml:lang="en">ToBiddingZone</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BiddingZone"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BipolarDCSystem.DCBiPole">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>DC bipole that belongs to a bipolar DC system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BipolarDCSystem"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#DCBiPole.BipolarDCSystem"/>
    <rdfs:label xml:lang="en">DCBiPole</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#DCBiPole"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BipolarDCSystem.isRigid">
    <rdfs:comment>If true, the bipolar DC system is a rigid DC current bipolar system (IEC 60633). It is a bipolar DC system without neutral connection between both converter stations. Since only two (pole) conductors exist, no unbalance current between both poles is possible. In case of interruption of power transfer of one converter pole, the current of the other pole has to be interrupted as well (at least for a limited time to allow reconfiguration of the DC circuit).</rdfs:comment>
    <cims:dataType rdf:resource="#Boolean"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BipolarDCSystem"/>
    <rdfs:label xml:lang="en">isRigid</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPoint.BoundaryPointBorder">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The BoundaryPointBorder that identifies the bilateral border relationship between the two parties responsible for this BoundaryPoint.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder.BoundaryPoint"/>
    <rdfs:label xml:lang="en">BoundaryPointBorder</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPoint.BoundaryPointBorderLink">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>BoundaryPointBorderLink instances that relate this BoundaryPoint to multiple bilateral BoundaryPointBorder relationships.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorderLink.BoundaryPoint"/>
    <rdfs:label xml:lang="en">BoundaryPointBorderLink</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorderLink"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPoint.partyOneResourceName">
    <rdfs:comment>Name used by the first party to refer to the shared or connected resource associated with the BoundaryPoint.
Note: This attribute records the name used in the model maintained by the first party for the resource or connection associated with the BoundaryPoint.
It shall only be used when exactly two parties share modelling responsibility at the BoundaryPoint.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint"/>
    <rdfs:label xml:lang="en">partyOneResourceName</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPoint.partyTwoResourceName">
    <rdfs:comment>Name used by the second party to refer to the shared or connected resource associated with the BoundaryPoint.
Note: This attribute records the name used in the model maintained by the second party for the resource or connection associated with the BoundaryPoint.
It shall only be used when exactly two parties share modelling responsibility at the BoundaryPoint.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint"/>
    <rdfs:label xml:lang="en">partyTwoResourceName</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.BoundaryPoint">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>BoundaryPoint that is part of a BoundaryPointBorder.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint.BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">BoundaryPoint</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.BoundaryPointBorderLink">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The BoundaryPointBorderLink instances that identify the BoundaryPoints participating in this bilateral BoundaryPointBorder relationship.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorderLink.BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">BoundaryPointBorderLink</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorderLink"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.partyOneDesignatorRef">
    <rdfs:comment>Globally unique reference to the designator associated with the first party, expressed as a URI.
Note: The reference may be a web URL identifying the designator or another persistent identifier expressed in URI form. When resolvable, the URI may provide additional linked data describing the designator.
The designator typically represents a jurisdictional or organisational designation that has empowered the party with the authority to provide the normative power system reference model.
This may refer to a country or to a specific regulatory or governing organisation.
Example: "https://vocabulary.uncefact.org/unlocode-countries#NO", "https://www.nve.no/reguleringsmyndigheten/"</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">partyOneDesignatorRef</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.partyOneName">
    <rdfs:comment>Human-readable name of the first party participating in the border relationship.
Note: This name shall be suitable for unambiguous identification of the party within the exchange context.
If partyOneRef is provided, partyOneName shall be aligned with the party identified by partyOneRef.
Example: "Statnett"</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">partyOneName</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.partyOneRef">
    <rdfs:comment>Globally unique reference to the first party participating in the border relationship, expressed as a URI.
Note: The reference may be a web URL identifying the party or another persistent identifier expressed in URI form. When resolvable, the URI may provide additional linked data describing the party.
Example: "https://energy.referencedata.eu/party/statnett", "urn:uuid:6f3e3a4e-3d4e-4b1a-a1e4-2b2c3f1a9a8d", "https://virksomhet.brreg.no/nb/oppslag/enheter/962986633"</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">partyOneRef</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.partyTwoDesignatorRef">
    <rdfs:comment>Globally unique reference to the designator associated with the second party, expressed as a URI.
Note: The reference may be a web URL identifying the designator or another persistent identifier expressed in URI form. When resolvable, the URI may provide additional linked data describing the designator.
The designator typically represents a jurisdictional or organisational designation that has empowered the party with the authority to provide the normative power system reference model.
This may refer to a country or to a specific regulatory or governing organisation.
Example: "https://vocabulary.uncefact.org/unlocode-countries#SE", "https://ei.se/"</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">partyTwoDesignatorRef</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.partyTwoName">
    <rdfs:comment>Human-readable name of the second party participating in the border relationship.
Note: This name shall be suitable for unambiguous identification of the party within the exchange context.
If partyTwoRef is provided, partyTwoName shall be aligned with the party identified by partyTwoRef.
Example: "SvenskaKraftnet"</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">partyTwoName</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorder.partyTwoRef">
    <rdfs:comment>Globally unique reference to the second party participating in the border relationship, expressed as a URI.
Note: The reference may be a web URL identifying the party or another persistent identifier expressed in URI form. When resolvable, the URI may provide additional linked data describing the party.
Example: "https://energy.referencedata.eu/party/svk", "urn:uuid:0d4c7c30-cc7e-4f8f-bb6c-6d6b8c6f7f62", "https://www.allabolag.se/foretag/svenska-kraftn%C3%A4t/sundbyberg/energif%C3%B6rs%C3%B6rjning/XF94VWI5YE1K"</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <rdfs:label xml:lang="en">partyTwoRef</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorderLink.BoundaryPoint">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>BoundaryPoint that is linked to multiple BoundaryPointBorder through the BoundaryPointBorderLink.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorderLink"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint.BoundaryPointBorderLink"/>
    <rdfs:label xml:lang="en">BoundaryPoint</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BoundaryPoint"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorderLink.BoundaryPointBorder">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The BoundaryPointBorder that is given by the BoundaryPointBorderLink.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorderLink"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder.BoundaryPointBorderLink"/>
    <rdfs:label xml:lang="en">BoundaryPointBorder</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorder"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#BoundaryPointBorderLink.mRID">
    <rdfs:comment>Master resource identifier issued by a model authority. The mRID is unique within an exchange context. Global uniqueness is easily achieved by using a UUID, as specified in RFC 4122, for the mRID. The use of UUID is strongly recommended.
For CIMXML data files in RDF syntax conforming to IEC 61970-552, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#BoundaryPointBorderLink"/>
    <rdfs:label xml:lang="en">mRID</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CapacityCalculationRegion.BiddingZone">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The bidding zone for this capacity calculation region.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CapacityCalculationRegion"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BiddingZone.CapacityCalculationRegion"/>
    <rdfs:label xml:lang="en">BiddingZone</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BiddingZone"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CapacityCalculationRegion.BiddingZoneBorder">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The bidding zone border on which the capacity is calculated. </rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CapacityCalculationRegion"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder.CapacityCalculationRegion"/>
    <rdfs:label xml:lang="en">BiddingZoneBorder</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#BiddingZoneBorder"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CapacityCalculationRegion.CoordinatedCapacityCalculator">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>Coordinated capacity calculator responsible for the capacity calculation of the region.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CapacityCalculationRegion"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#CoordinatedCapacityCalculator.CapacityCalculationRegion"/>
    <rdfs:label xml:lang="en">CoordinatedCapacityCalculator</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#CoordinatedCapacityCalculator"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CapacityCalculationRegion.SecurityCoordinator">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The security coordinator responsible for the capacity calculation region.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CapacityCalculationRegion"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#SecurityCoordinator.CapacityCalculationRegion"/>
    <rdfs:label xml:lang="en">SecurityCoordinator</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#SecurityCoordinator"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#Circuit.CircuitShare">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The circuit share of the given power transfer corridor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#Circuit"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#CircuitShare.Circuit"/>
    <rdfs:label xml:lang="en">CircuitShare</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#CircuitShare"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#Circuit.Equipment">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The equipment which is part of the circuit. This includes all equipment related to the circuit (e.g. If the circuit is a transformer, the equipment could be all switching and auxiliary equipments related to the transformer). A BusbarSection shall not be part of the circuit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#Circuit"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#Equipment.Circuit"/>
    <rdfs:label xml:lang="en">Equipment</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="#Equipment"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#Circuit.IdentifyingTerminal">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>Terminal that identifies the circuit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#Circuit"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#Terminal.Circuit"/>
    <rdfs:label xml:lang="en">IdentifyingTerminal</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="#Terminal"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#Circuit.positiveFlowIn">
    <rdfs:comment>True, if the positive value on the terminal shall be considered flow into the circuit. False, if the positive value on the terminal shall be considered flow out of the circuit.</rdfs:comment>
    <cims:dataType rdf:resource="#Boolean"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#Circuit"/>
    <rdfs:label xml:lang="en">positiveFlowIn</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CircuitShare.Circuit">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The circuit that has a share of the power system corridor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CircuitShare"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#Circuit.CircuitShare"/>
    <rdfs:label xml:lang="en">Circuit</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#Circuit"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CircuitShare.PowerTransferCorridor">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The power transfer corridor that has this circuit share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CircuitShare"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#PowerTransferCorridor.CircuitShare"/>
    <rdfs:label xml:lang="en">PowerTransferCorridor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#PowerTransferCorridor"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CircuitShare.normalContributionFactor">
    <rdfs:comment>Normal contribution factor for the circuit which is part of a power transfer corridor.
The allowed value range is [0,100].</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CircuitShare"/>
    <rdfs:label xml:lang="en">normalContributionFactor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.EnergyResourceGroupCapacity">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The Energy Resource Group Capacity that has this climate zone.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.ClimateZone"/>
    <rdfs:label xml:lang="en">EnergyResourceGroupCapacity</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.classificationKind">
    <rdfs:comment>The kind of climate classification scheme according to which the ClimateZone is defined.
Note: The attribute identifies the classification scheme and not the code or identifier of the ClimateZone within that scheme. When the classification scheme is not explicitly represented by ClimateZoneClassificationKind, classificationKind shall be set to other and otherClassification shall identify the scheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">classificationKind</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#ClimateZoneClassificationKind"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.code">
    <rdfs:comment>The code or identifier assigned to the ClimateZone by the selected climate classification scheme.
Note: The interpretation of the code depends on ClimateZone.classificationKind. The code should conform to the identification or naming convention defined by the corresponding classification scheme.
Example: "Dfb" or "Cfb" for K&amp;#246;ppen-Geiger, or a zone code defined by PECD or a national classification.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">code</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualDiffuseSolarIrradiation">
    <rdfs:comment>The climatological normal total diffuse solar energy received per unit area during an annual period.
Note: The orientation of the applicable reference surface is defined by the data specification or provenance information.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim4.eu/ns/nc#Irradiation"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualDiffuseSolarIrradiation</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualDirectSolarIrradiation">
    <rdfs:comment>The climatological normal total direct solar energy received per unit area during an annual period.
Note: The orientation of the applicable reference surface is defined by the data specification or provenance information.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim4.eu/ns/nc#Irradiation"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualDirectSolarIrradiation</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualEvaporation">
    <rdfs:comment>The climatological normal amount of water returned to the atmosphere through evaporation and evapotranspiration during an annual period, expressed as an equivalent depth of water.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualEvaporation</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualExtremeFireDangerDays">
    <rdfs:comment>The climatological normal number of days during an annual period classified as having extreme fire danger.
Note: The criterion for extreme fire danger is determined by the applicable wildfire index and classification identified through the data provenance. The CIM model does not prescribe a specific threshold.
Example: When the European Forest Fire Information System (EFFIS) classification is applied, extreme fire danger corresponds to an Canadian Fire Weather Index (FWI) of 50 or greater. A value of "18.5" therefore indicates a climatological normal of 18.5 days per year with FWI greater than or equal to 50.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualExtremeFireDangerDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualFreezingPrecipitationDays">
    <rdfs:comment>The climatological normal number of days during an annual period with freezing precipitation.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualFreezingPrecipitationDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualFrostDays">
    <rdfs:comment>The climatological normal number of frost days during an annual period.
Note: The threshold used to define a frost day is determined by the applicable meteorological specification, normally using minimum air temperature.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualFrostDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualGlobalSolarIrradiation">
    <rdfs:comment>The climatological normal total global solar energy received per unit area during an annual period.
Note: Global solar irradiation includes direct and diffuse solar radiation incident on the applicable reference surface. For a horizontal reference surface it corresponds to global horizontal irradiation.
Example: A value may be expressed as annual solar energy per square metre, such as MJ/m2 or an equivalent unit.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim4.eu/ns/nc#Irradiation"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualGlobalSolarIrradiation</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualHailDays">
    <rdfs:comment>The climatological normal number of days during an annual period on which hail occurs.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualHailDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualHeatwaveDays">
    <rdfs:comment>The climatological normal number of days during an annual period occurring as part of a heatwave.
Note: A heatwave represents unusually high temperature persisting for a defined minimum duration. The temperature criteria and minimum duration are specified by the applicable climate dataset or scenario.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualHeatwaveDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualHighAvalancheDangerDays">
    <rdfs:comment>The climatological normal number of days during an annual period classified as having high avalanche danger.
Note: The criterion for high avalanche danger is determined by the applicable avalanche methodology and classification identified through data provenance. The CIM model does not prescribe a particular threshold.
Example: "8.5" when high avalanche danger is defined as EAWS danger level 4 or 5.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualHighAvalancheDangerDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualHotDays">
    <rdfs:comment>The climatological normal number of hot days during an annual period.
Note: A hot day is defined using the threshold specified by the applicable climate dataset or scenario. The threshold may be an absolute temperature or a percentile relative to the local climatology.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualHotDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualHydroInflow">
    <rdfs:comment>The climatological normal energy equivalent of natural hydro inflow associated with hydro resources in the ClimateZone during an annual period.
Note: The value represents the potential energy associated with natural inflow and not generated electrical energy. This representation is intended for aggregated power-system and adequacy studies where hydro inflow is expressed as an energy quantity.
Example: The value may represent the annual energy equivalent of natural inflow to reservoir hydropower resources within the ClimateZone.</rdfs:comment>
    <cims:dataType rdf:resource="#RealEnergy"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualHydroInflow</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualIcingDays">
    <rdfs:comment>The climatological normal number of days during an annual period with meteorological conditions producing significant icing.
Note: The criteria defining an icing day are provided by the applicable data specification or provenance information. The attribute may be used to characterise climate-related availability risk for overhead lines, wind turbines and other exposed equipment.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualIcingDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualLightningDensity">
    <rdfs:comment>The climatological normal number of lightning events per unit area during an annual period.
Note: The definition of a lightning event, for example a flash or ground strike, is determined by the applicable data specification.
Example: 1.5 flashes/km2 indicates that an average of 1.5 lightning flashes per square kilometre occurs during a normal year.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim4.eu/ns/nc#CountPerArea"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualLightningDensity</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualMaxDailyPrecipitation">
    <rdfs:comment>The climatological normal of the maximum precipitation accumulated during a single day within an annual period.
Note: This value provides an indication of exposure to extreme precipitation that is not represented by normalAnnualPrecipitation alone.
Example: A value of 85 mm indicates that the normal annual maximum one-day precipitation is approximately 85 mm.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualMaxDailyPrecipitation</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualMaxSignificantWaveHeight">
    <rdfs:comment>The climatological normal of the maximum significant wave height occurring during an annual period.
Note: This value characterises exposure to severe sea states relevant to accessibility, equipment loading and availability of offshore resources.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualMaxSignificantWaveHeight</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualMaxTempAt2m">
    <rdfs:comment>The climatological normal of the maximum air temperature at 2 metres above ground level occurring during an annual period.
Note: This represents an annual extreme maximum rather than the normal mean of daily maximum temperatures.</rdfs:comment>
    <cims:dataType rdf:resource="#Temperature"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualMaxTempAt2m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualMaxWindGustAt10m">
    <rdfs:comment>The climatological normal of the maximum wind gust at 10 metres above ground level occurring during an annual period.
Note: This value characterises exposure to strong short-duration wind events rather than the normal wind resource.
Example: A value of 31 m/s indicates that the climatological normal annual maximum gust is approximately 31 m/s.</rdfs:comment>
    <cims:dataType rdf:resource="#Speed"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualMaxWindGustAt10m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualMinTempAt2m">
    <rdfs:comment>The climatological normal of the minimum air temperature at 2 metres above ground level occurring during an annual period.
Note: This represents an annual extreme minimum rather than the normal mean of daily minimum temperatures.</rdfs:comment>
    <cims:dataType rdf:resource="#Temperature"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualMinTempAt2m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualPotentialEvaporation">
    <rdfs:comment>The climatological normal potential amount of water that could be returned to the atmosphere by evaporation during an annual period, expressed as an equivalent depth of water.
Note: Potential evaporation represents atmospheric evaporative demand and is not limited by actual water availability.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualPotentialEvaporation</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualPrecipitation">
    <rdfs:comment>The climatological normal total precipitation received during an annual period.
Note: Precipitation includes liquid and solid precipitation and is expressed as an equivalent depth of water over the area.
Example: 1100 mm represents an annual precipitation volume equivalent to 1100 litres of water per square metre.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualPrecipitation</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualRainfall">
    <rdfs:comment>The climatological normal amount of liquid precipitation received during an annual period.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualRainfall</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualRunoff">
    <rdfs:comment>The climatological normal runoff during an annual period, expressed as an equivalent depth of water over the area.
Note: Runoff represents water leaving the land surface and subsurface drainage system after precipitation, snowmelt, evaporation, infiltration and storage effects.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualRunoff</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualSeaIceDays">
    <rdfs:comment>The climatological normal number of days during an annual period for which sea ice is present within the ClimateZone.
Note: The minimum ice concentration or other criterion used to determine sea-ice presence is defined by the applicable data specification.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualSeaIceDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualSnowfall">
    <rdfs:comment>The climatological normal amount of solid precipitation received during an annual period, expressed as its equivalent amount of liquid water.
Note: The value represents water input from snowfall rather than physical snow depth.
Example: 500 mm means that the annual snowfall normally contains an amount of water equivalent to a 500 mm layer of liquid water.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualSnowfall</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualSnowmelt">
    <rdfs:comment>The climatological normal amount of water released by melting snow during an annual period.
Note: Snowmelt is expressed as the equivalent depth of liquid water produced from the snowpack.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualSnowmelt</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualSunshineDuration">
    <rdfs:comment>The climatological normal total duration of sunshine during an annual period.
Example: 1650 h represents approximately 1650 hours of sunshine during a normal year.</rdfs:comment>
    <cims:dataType rdf:resource="#Hours"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualSunshineDuration</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualThunderDays">
    <rdfs:comment>The climatological normal number of days during an annual period on which thunder is observed.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualThunderDays</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalAnnualTropicalNights">
    <rdfs:comment>The climatological normal number of tropical nights during an annual period.
Note: A tropical night is a night for which the minimum air temperature remains above the applicable threshold. A threshold of 20 degC is commonly used in European climate indicators, but the applicable threshold is defined by the dataset or scenario.</rdfs:comment>
    <cims:dataType rdf:resource="#Decimal"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalAnnualTropicalNights</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalCloudCover">
    <rdfs:comment>The climatological normal proportion of the sky covered by cloud.</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalCloudCover</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalDewPointTempAt2m">
    <rdfs:comment>The climatological normal dew-point temperature at 2 metres above ground level.
Note: Dew-point temperature indicates atmospheric moisture content and may be used together with air temperature to derive relative humidity and icing conditions.</rdfs:comment>
    <cims:dataType rdf:resource="#Temperature"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalDewPointTempAt2m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalMaxSeaCurrentSpeed">
    <rdfs:comment>The climatological normal maximum sea-current speed within the ClimateZone.
Note: The value characterises strong current conditions relevant to marine-energy resource potential and equipment loading. The applicable depth and method for determining the maximum are defined by the source dataset or provenance information.</rdfs:comment>
    <cims:dataType rdf:resource="#Speed"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalMaxSeaCurrentSpeed</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalMaxSeaIceThickness">
    <rdfs:comment>The climatological normal maximum sea-ice thickness during the seasonal cycle within a marine ClimateZone.
Note: This attribute is primarily relevant for high-latitude offshore areas and may be used when assessing accessibility and availability of offshore resources.
Example: 0.8 m indicates that the normal seasonal maximum sea-ice thickness is approximately 0.8 metres.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalMaxSeaIceThickness</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalMaxSnowWater">
    <rdfs:comment>The climatological normal of the maximum amount of water stored in the snowpack during the seasonal cycle.
Note: Snow water represents the water content of the snowpack expressed as an equivalent depth of liquid water. The value characterises seasonal snow storage and is more hydrologically meaningful than physical snow depth.
Example: 450 mm indicates that the normal seasonal maximum snowpack contains an amount of water equivalent to a 450 mm layer of liquid water.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalMaxSnowWater</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalPopulationWeightedTempAt2m">
    <rdfs:comment>The climatological normal population-weighted air temperature at 2 metres above ground level.
Note: Population-weighted temperature is a spatially aggregated temperature in which locations with a higher population are given greater weight. It provides a representative temperature for the conditions experienced by the population and is particularly relevant for energy-demand modelling. The population dataset, weighting method and other provenance information are represented separately.</rdfs:comment>
    <cims:dataType rdf:resource="#Temperature"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalPopulationWeightedTempAt2m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalRelativeHumidityAt2m">
    <rdfs:comment>The climatological normal relative humidity at 2 metres above ground level.</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalRelativeHumidityAt2m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalSeaCurrentSpeed">
    <rdfs:comment>The climatological normal speed of the sea-water current within the ClimateZone.
Note: Sea-current speed depends on depth. The applicable depth or vertical reference is defined by the source dataset or provenance information.</rdfs:comment>
    <cims:dataType rdf:resource="#Speed"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalSeaCurrentSpeed</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalSeaSurfaceTemp">
    <rdfs:comment>The climatological normal sea-surface temperature within a marine ClimateZone.</rdfs:comment>
    <cims:dataType rdf:resource="#Temperature"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalSeaSurfaceTemp</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalSignificantWaveHeight">
    <rdfs:comment>The climatological normal significant wave height within a marine ClimateZone.
Note: Significant wave height is a statistical representation of sea state commonly approximated as the mean height of the highest one-third of waves.
Example: A value of 2.1 m represents a climate where the normal significant wave height is approximately 2.1 metres.</rdfs:comment>
    <cims:dataType rdf:resource="#Length"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalSignificantWaveHeight</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalSurfacePressure">
    <rdfs:comment>The climatological normal atmospheric pressure at the surface.</rdfs:comment>
    <cims:dataType rdf:resource="#Pressure"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalSurfacePressure</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalTempAt2m">
    <rdfs:comment>The climatological normal air temperature at 2 metres above ground level.
Note: Two metres above ground is the standard reference height for near-surface air temperature.</rdfs:comment>
    <cims:dataType rdf:resource="#Temperature"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalTempAt2m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalWavePeriod">
    <rdfs:comment>The climatological normal representative wave period within a marine ClimateZone.
Note: The precise wave-period statistic, such as mean or peak period, is determined by the applicable data specification.</rdfs:comment>
    <cims:dataType rdf:resource="#Seconds"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalWavePeriod</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalWindSpeedAt100m">
    <rdfs:comment>The climatological normal wind speed at 100 metres above ground level.
Note: Wind speed at 100 metres is commonly available in meteorological and energy datasets and provides a useful indication of the wind resource for electricity generation.</rdfs:comment>
    <cims:dataType rdf:resource="#Speed"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalWindSpeedAt100m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.normalWindSpeedAt10m">
    <rdfs:comment>The climatological normal wind speed at 10 metres above ground level.
Note: Ten metres above ground is the conventional reference height for near-surface meteorological wind observations.</rdfs:comment>
    <cims:dataType rdf:resource="#Speed"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">normalWindSpeedAt10m</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.otherClassification">
    <rdfs:comment>The name or identifier of the climate classification scheme when ClimateZone.classificationKind equals other.
Note: This attribute shall only be used when ClimateZone.classificationKind is set to other. It identifies the classification scheme that is not explicitly represented by ClimateZoneClassificationKind. The value should be sufficiently descriptive to identify the scheme.
Example: "Trewartha Climate Classification", "Holdridge Life Zones", "Thornthwaite Climate Classification", "Company Internal Climate Zones".</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">otherClassification</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ClimateZone.ref">
    <rdfs:comment>A URI identifying the ClimateZone within the applicable climate classification scheme.
Note: The URI identifies the classified zone or concept rather than the classification scheme itself. It may be used as an alternative to code when the classification is published as linked data or another URI-based controlled vocabulary. Both code and ref may be provided when the classification defines both representations.
Example: "https://example.org/climate/pecd/zone-12" as an illustrative URI identifying a climate zone within a PECD classification.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <rdfs:label xml:lang="en">ref</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CombinedCyclePlant.kind">
    <rdfs:comment>The configuration used to arrange and coordinate the thermal generating units of the combined cycle plant.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CombinedCyclePlant"/>
    <rdfs:label xml:lang="en">kind</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#CombinedCycleConfigurationKind"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CommonResponsibilityPoint.ConnectivityNode">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The ConnectivityNode that anchors this CommonResponsiblityPoint in the AC grid model.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CommonResponsibilityPoint"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#ConnectivityNode.CommonResponsibilityPoint"/>
    <rdfs:label xml:lang="en">ConnectivityNode</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="#ConnectivityNode"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CommonResponsibilityPoint.DCNode">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The DCNode that anchors this CommonResponsibilityPoint in the DC grid model.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CommonResponsibilityPoint"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#DCNode.CommonResponsibilityPoint"/>
    <rdfs:label xml:lang="en">DCNode</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="#DCNode"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CommonResponsibilityPoint.isDirectCurrent">
    <rdfs:comment>Indicates whether the CommonResponsibilityPoint is anchored to a DC grid node.
If isDirectCurrent is true, the CommonResponsibilityPoint shall be associated to a DCNode and shall not be associated to a ConnectivityNode.
If isDirectCurrent is false, the CommonResponsibilityPoint shall be associated to a ConnectivityNode and shall not be associated to a DCNode.</rdfs:comment>
    <cims:dataType rdf:resource="#Boolean"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#CommonResponsibilityPoint"/>
    <rdfs:label xml:lang="en">isDirectCurrent</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CompressedAirEnergyStoragePlant.ThermalGeneratingUnit">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The thermal generating unit that is a member of this compressed air energy storage plant.</rdfs:comment>
