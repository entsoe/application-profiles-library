    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ConnectivityNode.CommonResponsibilityPoint">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>CommonResponsibilityPoints anchored to this ConnectivityNode, representing one or more responsibility or agreement contexts that apply at the same AC grid location.</rdfs:comment>
