    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#LogicalOperatorsKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#LogicalOperatorsKind.greaterThanOrEquals">
    <rdfs:comment>Greater than or equals comparison operation.</rdfs:comment>
    <rdfs:label xml:lang="en">greaterThanOrEquals</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#LogicalOperatorsKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#LogicalOperatorsKind.lessThan">
    <rdfs:comment>Less than comparison operation.</rdfs:comment>
    <rdfs:label xml:lang="en">lessThan</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#LogicalOperatorsKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#LogicalOperatorsKind.lessThanOrEquals">
    <rdfs:comment>Less than or equals comparison operation.</rdfs:comment>
    <rdfs:label xml:lang="en">lessThanOrEquals</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#LogicalOperatorsKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#LogicalOperatorsKind.notEqual">
    <rdfs:comment>Not equal (unlike) comparison operation.</rdfs:comment>
    <rdfs:label xml:lang="en">notEqual</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#LogicalOperatorsKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#MarineUnitKind.currents">
    <rdfs:comment>Capture energy from ocean current which are caused by forces like breaking waves, wind, coriolis effect etc.</rdfs:comment>
    <rdfs:label xml:lang="en">currents</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#MarineUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#MarineUnitKind.other">
    <rdfs:comment>Other way of capture energy from marine elements.</rdfs:comment>
    <rdfs:label xml:lang="en">other</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#MarineUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#MarineUnitKind.pressure">
    <rdfs:comment>Capture energy from pressure.</rdfs:comment>
    <rdfs:label xml:lang="en">pressure</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#MarineUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#MarineUnitKind.tidal">
    <rdfs:comment>Capture energy from tidal power, which captures the energy of the current caused by the gravitational pull of the Sun and Moon.</rdfs:comment>
    <rdfs:label xml:lang="en">tidal</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#MarineUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#MarineUnitKind.wave">
    <rdfs:comment>Capture energy from wind waves.</rdfs:comment>
    <rdfs:label xml:lang="en">wave</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#MarineUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ModularMultilevelConverterValveKind.fullBridge">
    <rdfs:comment>MMC valve based on a full-bridge submodule topology capable of bipolar voltage generation and DC fault blocking.</rdfs:comment>
    <rdfs:label xml:lang="en">fullBridge</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ModularMultilevelConverterValveKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ModularMultilevelConverterValveKind.halfBridge">
    <rdfs:comment>MMC valve based on a half-bridge submodule topology typically used for efficient voltage source converter operation.</rdfs:comment>
    <rdfs:label xml:lang="en">halfBridge</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#ModularMultilevelConverterValveKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#NuclearReactorKind.breeder">
    <rdfs:comment>Reactor whose heat source is a nuclear reactor that generates more fissile material than it consumes.</rdfs:comment>
    <rdfs:label xml:lang="en">breeder</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#NuclearReactorKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#NuclearReactorKind.graphite">
    <rdfs:comment>Reactor whose heat source is a graphite-moderated reactor that is a nuclear reactor that uses carbon as a neutron moderator, which allows natural uranium to be used as nuclear fuel.</rdfs:comment>
    <rdfs:label xml:lang="en">graphite</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#NuclearReactorKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#NuclearReactorKind.heavyWater">
    <rdfs:comment>Reactor whose heat source is a pressurized heavy-water reactor (PHWR) that uses heavy water (deuterium oxide D2O) as its coolant and neutron moderator.</rdfs:comment>
    <rdfs:label xml:lang="en">heavyWater</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#NuclearReactorKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#NuclearReactorKind.lightWater">
    <rdfs:comment>Reactor whose heat source is a light-water reactor (LWR) that is a type of thermal-neutron reactor that uses normal water, as both its coolant and neutron moderator – furthermore a solid form of fissile elements is used as fuel. </rdfs:comment>
    <rdfs:label xml:lang="en">lightWater</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#NuclearReactorKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#NuclearReactorKind.liquidMetal">
    <rdfs:comment>Reactor whose liquid metal cooled nuclear reactor, liquid metal fast reactor or LMFR is an advanced type of nuclear reactor where the primary coolant is a liquid metal.</rdfs:comment>
    <rdfs:label xml:lang="en">liquidMetal</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#NuclearReactorKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#NuclearReactorKind.other">
    <rdfs:comment>Other type of nuclear reactors.</rdfs:comment>
    <rdfs:label xml:lang="en">other</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#NuclearReactorKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="#OperationalLimitDirectionKind.absoluteValue">
    <rdfs:comment>An absoluteValue limit means that a monitored absolute value above the limit value is a violation.</rdfs:comment>
    <rdfs:label xml:lang="en">absoluteValue</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="#OperationalLimitDirectionKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="#OperationalLimitDirectionKind.high">
    <rdfs:comment>High means that a monitored value above the limit value is a violation.   If applied to a terminal flow, the positive direction is into the terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">high</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="#OperationalLimitDirectionKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="#OperationalLimitDirectionKind.low">
    <rdfs:comment>Low means a monitored value below the limit is a violation.  If applied to a terminal flow, the positive direction is into the terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">low</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="#OperationalLimitDirectionKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinDCTerminalKind.current">
    <rdfs:comment>Direct current in the DCTerminal.</rdfs:comment>
    <rdfs:label xml:lang="en">current</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinDCTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinDCTerminalKind.voltage">
    <rdfs:comment>Direct current voltage in the DCTerminal.</rdfs:comment>
    <rdfs:label xml:lang="en">voltage</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinDCTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinTerminalKind.activePower">
    <rdfs:comment>Active power on the Terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">activePower</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinTerminalKind.apparentPower">
    <rdfs:comment>Apparent power on the Terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">apparentPower</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinTerminalKind.current">
    <rdfs:comment>Current on the Terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">current</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinTerminalKind.frequency">
    <rdfs:comment>Frequency on the Terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">frequency</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinTerminalKind.reactivePower">
    <rdfs:comment>Reactive power on the Terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">reactivePower</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinTerminalKind.voltageAngle">
    <rdfs:comment>Voltage angle on the Terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">voltageAngle</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PinTerminalKind.voltageMagnitude">
    <rdfs:comment>Voltage magnitude on the Terminal.</rdfs:comment>
    <rdfs:label xml:lang="en">voltageMagnitude</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PinTerminalKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBlockKind.powerDecrease">
    <rdfs:comment>Decrease in the power. The block represents action for decreased power.</rdfs:comment>
    <rdfs:label xml:lang="en">powerDecrease</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerBlockKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBlockKind.powerIncrease">
    <rdfs:comment>Increase in the power. The block represents action for increased power.</rdfs:comment>
    <rdfs:label xml:lang="en">powerIncrease</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerBlockKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerBlockKind.powerIncreaseAndDecrease">
    <rdfs:comment>Increase and decrease in the power. The block represents action for increased and decreased power.</rdfs:comment>
    <rdfs:label xml:lang="en">powerIncreaseAndDecrease</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerBlockKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerElectricalChemicalUnitKind.electrolyticCell">
    <rdfs:comment>An electrolytic cell is an electrochemical cell that drives a non-spontaneous redox reaction through the application of electrical energy. Example are the decomposition of water into hydrogen and oxygen. </rdfs:comment>
    <rdfs:label xml:lang="en">electrolyticCell</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerElectricalChemicalUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerElectricalChemicalUnitKind.fuelCell">
    <rdfs:comment>A fuel cell is an electrochemical cell that converts the chemical energy from a fuel into electricity through an electrochemical reaction of hydrogen fuel with oxygen or another oxidizing agent.</rdfs:comment>
    <rdfs:label xml:lang="en">fuelCell</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerElectricalChemicalUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerElectricalChemicalUnitKind.other">
    <rdfs:comment>Other type of cell used in chemical reactions.</rdfs:comment>
    <rdfs:label xml:lang="en">other</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerElectricalChemicalUnitKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerFrequencyControlKind.activePower">
    <rdfs:comment>Active power control mode.</rdfs:comment>
    <rdfs:label xml:lang="en">activePower</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerFrequencyControlKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerFrequencyControlKind.activePowerAndFrequency">
    <rdfs:comment>Active power and frequency control mode.</rdfs:comment>
    <rdfs:label xml:lang="en">activePowerAndFrequency</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerFrequencyControlKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerFrequencyControlKind.frequency">
    <rdfs:comment>Frequency control mode.</rdfs:comment>
    <rdfs:label xml:lang="en">frequency</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerFrequencyControlKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.consumptionsFlat">
    <rdfs:comment>Flat adjustment, equal amount of power, on all active consumption units (Energy Consumers and Power Electronics like FlexibleEnergyUnit). e.g. 100 MW decrease adjustment on 4 loads, it means that each of them get reduced 25 MW, as long as no other constraints are violated.</rdfs:comment>
    <rdfs:label xml:lang="en">consumptionsFlat</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.consumptionsP">
    <rdfs:comment>The distribution is based on the consumptions active power in the given case.</rdfs:comment>
    <rdfs:label xml:lang="en">consumptionsP</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.explicitDistribution">
    <rdfs:comment>The distribution is explicitly done according to the power shift key  distribution in the power bid Schedule.</rdfs:comment>
    <rdfs:label xml:lang="en">explicitDistribution</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.explicitInstruction">
    <rdfs:comment>The distribution is done according to the individual participation factor on the unit.</rdfs:comment>
    <rdfs:label xml:lang="en">explicitInstruction</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.generatorsAndConsumptionsP">
    <rdfs:comment>The distribution is based on the generator and consumption active power in the given case.</rdfs:comment>
    <rdfs:label xml:lang="en">generatorsAndConsumptionsP</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.generatorsFlat">
    <rdfs:comment>Flat adjustment, equal amount of power, on all active generators. e.g. 100 MW increase adjustment on 4 generators, it means that each of them get increased 25 MW, as long as no other constraints are violated.</rdfs:comment>
    <rdfs:label xml:lang="en">generatorsFlat</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.generatorsP">
    <rdfs:comment>The distribution is based on the generators active power in the given case.</rdfs:comment>
    <rdfs:label xml:lang="en">generatorsP</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.generatorsPmax">
    <rdfs:comment>The distribution is relative to the maximum p of the generator.</rdfs:comment>
    <rdfs:label xml:lang="en">generatorsPmax</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.generatorsPmin">
    <rdfs:comment>The distribution is relative to the minimum p of the generator.</rdfs:comment>
    <rdfs:label xml:lang="en">generatorsPmin</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.generatorsRemainingCapacity">
    <rdfs:comment>The distribution is based on the remaining capacity for generators in the given case.</rdfs:comment>
    <rdfs:label xml:lang="en">generatorsRemainingCapacity</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.generatorsUsedCapacity">
    <rdfs:comment>The distribution is based on the used capacity, the difference between the minimum operation and operating p (GeneratingUnit.minOperatingP)</rdfs:comment>
    <rdfs:label xml:lang="en">generatorsUsedCapacity</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.nonConformLoadP">
    <rdfs:comment>The distribution is based on the non conform load active power in the given case.</rdfs:comment>
    <rdfs:label xml:lang="en">nonConformLoadP</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.storageFlat">
    <rdfs:comment>Flat adjustment, equal amount of power, on all the batteries and any operating hydro pumps. e.g. 100 MW increase or decrease adjustment on 4 batteries, it means that each of them get increased or reduced 25 MW, as long as no other constraints are violated.</rdfs:comment>
    <rdfs:label xml:lang="en">storageFlat</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#PowerShiftKeyKind.storageP">
    <rdfs:comment>The distribution is based on the batteries and any operating hydro pumps active power in the given case.</rdfs:comment>
    <rdfs:label xml:lang="en">storageP</rdfs:label>
    <cims:stereotype>enum</cims:stereotype>
    <rdf:type rdf:resource="https://cim4.eu/ns/nc#PowerShiftKeyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ACDCConverter.ACDCConverterController">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>Direct current controller which controls the ACDC converter.</rdfs:comment>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#ACDCConverterController.ACDCConverter"/>
    <rdfs:label xml:lang="en">ACDCConverterController</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#ACDCConverterController"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ACDCConverter.ExternalDCTerminal">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The external terminal of the ACDCConverter.</rdfs:comment>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#DCTerminal.ACDCConverter"/>
    <rdfs:label xml:lang="en">ExternalDCTerminal</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..3"/>
    <rdfs:range rdf:resource="#DCTerminal"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ACDCConverter.baseS">
    <rdfs:comment>Base apparent power of the converter pole. The attribute shall be a positive value.</rdfs:comment>
    <cims:dataType rdf:resource="#ApparentPower"/>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <rdfs:label xml:lang="en">baseS</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ACDCConverter.maxP">
    <rdfs:comment>Maximum active power limit. The value is overwritten by values of VsCapabilityCurve, if present.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <rdfs:label xml:lang="en">maxP</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ACDCConverter.maxUdc">
    <rdfs:comment>The maximum voltage on the DC side at which the converter should operate. It is converter’s configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
    <cims:dataType rdf:resource="#Voltage"/>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <rdfs:label xml:lang="en">maxUdc</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ACDCConverter.minP">
    <rdfs:comment>Minimum active power limit. The value is overwritten by values of VsCapabilityCurve, if present.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <rdfs:label xml:lang="en">minP</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ACDCConverter.minUdc">
    <rdfs:comment>The minimum voltage on the DC side at which the converter should operate. It is converter’s configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
    <cims:dataType rdf:resource="#Voltage"/>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <rdfs:label xml:lang="en">minUdc</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ACDCConverter.ratedUdc">
    <rdfs:comment>Rated converter DC voltage, also called UdN. The attribute shall be a positive value. It is converter’s configuration data used in power flow. For instance a bipolar HVDC link with value  200 kV has a 400kV difference between the dc lines.</rdfs:comment>
    <cims:dataType rdf:resource="#Voltage"/>
    <rdfs:domain rdf:resource="#ACDCConverter"/>
    <rdfs:label xml:lang="en">ratedUdc</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ACDCConverterController.ACDCConverter">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
