  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FrequencyMonitoringTerminal.Terminal">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The terminal for this frequency monitoring terminal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#FrequencyMonitoringTerminal"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#Terminal.FrequencyMonitoringTerminal"/>
