    <rdfs:domain rdf:resource="#EnergyConsumer"/>
    <rdfs:label xml:lang="en">minEconomicP</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype>deprecated</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyConsumer.normalParticipationFactor">
    <rdfs:comment>Participation factor describing the entity part of the active power provided by a collection of entities (e.g. an active power forecast to a collection of entities is divided to each of the member entity according to the participation factor). Must be a positive value.
In the case of a sharing strategy, the distribution is following entities value (V) equals aggregated value (T) divided by sum of participation factors (PF), i.e. V=T/sum(PF). 
In the case of priority strategy, the item with the lowest number gets allocated energy first.</rdfs:comment>
    <cims:dataType rdf:resource="#Float"/>
    <rdfs:domain rdf:resource="#EnergyConsumer"/>
    <rdfs:label xml:lang="en">normalParticipationFactor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <cims:stereotype>deprecated</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyCoordinationRegion.EnergyAlignmentCoordinator">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The energy alignment coordinator that operates this energy coordination region.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyCoordinationRegion"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#EnergyAlignmentCoordinator.EnergyCoordinationRegion"/>
    <rdfs:label xml:lang="en">EnergyAlignmentCoordinator</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#EnergyAlignmentCoordinator"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyCoordinationRegion.SchedulingArea">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The scheduling area that is part of this energy coordination region.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyCoordinationRegion"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#SchedulingArea.EnergyCoordinationRegion"/>
    <rdfs:label xml:lang="en">SchedulingArea</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#SchedulingArea"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyExchangePoint.SchedulingAreaExchangePoint">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The scheduling area exchange point that is part of the scheduling area.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyExchangePoint"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#SchedulingAreaExchangePoint.EnergyExchangePoint"/>
    <rdfs:label xml:lang="en">SchedulingAreaExchangePoint</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#SchedulingAreaExchangePoint"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.ClimateZone">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The climate zone for the energy group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#ClimateZone.EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">ClimateZone</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#ClimateZone"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.EnergyComponent">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The energy component that is part of this energy group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#EnergyComponent.EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">EnergyComponent</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#EnergyComponent"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.EnergyResourceType">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The energy resource type represented by the aggregated capacity group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType.EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">EnergyResourceType</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.SchedulingArea">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The scheduling area that has this energy group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#SchedulingArea.EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">SchedulingArea</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#SchedulingArea"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.normalAavailabilityFactor">
    <rdfs:comment>The normal ratio (in percent) between the effective available capacity and the installed capacity over a defined time interval. For weather-dependent resources, the value reflects climate-driven availability as derived from meteorological or hydrological conditions.</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">normalAavailabilityFactor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.normalAvailableCapacityP">
    <rdfs:comment>The weather or condition-dependent active power capacity that is realistically available for operation at a given time. This value reflects normal reduction due to climatic, hydrological, or operational constraints.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">normalAvailableCapacityP</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.normalCapacityAllocationFactor">
    <rdfs:comment>The normal relative weighting used to allocate an aggregate capacity requirement to this energy resource group.

Note: The value provides the default weighting for top-down capacity allocation when a more specific `capacityAllocationFactor` is not provided. The factor is relative to the factors of other applicable energy resource groups and is not required to represent a percentage or to sum to 1 across the groups. The allocation algorithm may normalize the applicable factors and take account of availability, existing capacity and other modelling constraints.</rdfs:comment>
    <cims:dataType rdf:resource="#Float"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">normalCapacityAllocationFactor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.normalInstalledCapacityP">
    <rdfs:comment>The nominal installed active power capacity of the energy type, independent of weather or normal operating conditions. This is the maximum technical power rating under standard design assumptions and optimum operation condition.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">normalInstalledCapacityP</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.normalParticipationFactor">
    <rdfs:comment>Normal participation factor for the power group in relation to scheduling area. Must be a positive value.</rdfs:comment>
    <cims:dataType rdf:resource="#Float"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">normalParticipationFactor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.powerDuration">
    <rdfs:comment>Duration for the active power.</rdfs:comment>
    <cims:dataType rdf:resource="#Duration"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">powerDuration</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.scenarioCode">
    <rdfs:comment>Code identifying the study, scenario, or modelling configuration from which the capacity or availability values are derived. Examples include TYNDP scenario identifiers, national estimates, or dataset versions.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">scenarioCode</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.scenarioRef">
    <rdfs:comment>Reference to the study, scenario, or modelling configuration from which the capacity or availability values are derived. Examples include TYNDP scenario identifiers, national estimates, or dataset versions.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">scenarioRef</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.weatherDatasetCode">
    <rdfs:comment>Code identifying the external weather or climate dataset used to determine availability or effective capacity for weather-dependent resources. Examples include datasets from the Pan-European Climate Database (PECD) or similar climate data services.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">weatherDatasetCode</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.weatherDatasetRef">
    <rdfs:comment>Reference to the external weather or climate dataset used to determine availability or effective capacity for weather-dependent resources. Examples include datasets from the Pan-European Climate Database (PECD) or similar climate data services.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <rdfs:label xml:lang="en">weatherDatasetRef</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.EnergyResourceGroupCapacity">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The capacity groups classified by this energy resource type.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity.EnergyResourceType"/>
    <rdfs:label xml:lang="en">EnergyResourceGroupCapacity</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#EnergyResourceGroupCapacity"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.ScheduleResource">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The schedule resources whose primary energy resource type is this energy resource type.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#ScheduleResource.PrimaryEnergyResourceType"/>
    <rdfs:label xml:lang="en">ScheduleResource</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#ScheduleResource"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.co2EmissionFactor">
    <rdfs:comment>The reference carbon dioxide emission factor of the energy resource type.
Note: The value represents a default factor used for modelling or reporting rather than measured emissions from an individual resource.</rdfs:comment>
    <cims:dataType rdf:resource="#Emission"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <rdfs:label xml:lang="en">co2EmissionFactor</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.electricalEfficiency">
    <rdfs:comment>The reference ratio of electrical energy output to energy input for the energy resource type.
Note: The value represents a default or reference efficiency used for modelling and reporting. It is not necessarily the measured efficiency of an individual resource.
Example: An energy resource type representing a combined-cycle gas turbine may have a reference electrical efficiency of 60 %.</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <rdfs:label xml:lang="en">electricalEfficiency</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.energySourceCode">
    <rdfs:comment>Code identifying the primary energy source.
Note: The code is assigned by a controlled vocabulary. The identified energy source need not be a combustible fuel; it may represent solar radiation, wind, hydro, ambient heat, biomass or another primary energy source.
Example: F01010300 identifies Renewable–Solid–Wood–Unspecified in the European Energy Certificate System (EECS) energy source classification.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <rdfs:label xml:lang="en">energySourceCode</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.energySourceRef">
    <rdfs:comment>URI or URN identifying the same primary energy source classification as energySourceCode.
Note:URI or URN identifying the same primary energy source as energySourceCode. The URI may be resolvable (HTTP) or non-resolvable (URN). CIM does not mandate any identification scheme.
Example: https://www.aib-net.org/eecs/F01010300 to point to Renewable–Solid–Wood–Unspecified.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <rdfs:label xml:lang="en">energySourceRef</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.kind">
    <rdfs:comment>The general kind of energy resource.
Note: The value provides a broad functional classification suitable for aggregation and forecasting. More detailed classifications of the energy input and technology are provided by fuelCode, fuelRef, technologyCode and technologyRef.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <rdfs:label xml:lang="en">kind</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#EnergyKind"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.technologyCode">
    <rdfs:comment>Code identifying the production, conversion, storage or consumption technology.
Note: The code is assigned by an external controlled vocabulary. For electricity production, the code may identify a technology defined by the European Energy Certificate System (EECS) technology classification.
Example: T010102 identifies Solar–Photovoltaic–Thin Film in the European Energy Certificate System (EECS) technology classification.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <rdfs:label xml:lang="en">technologyCode</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#EnergyResourceType.technologyRef">
    <rdfs:comment>URI or URN identifying the same technology classification as technologyCode.
Note: URI or URN identifying the same technology as technologyCode. The URI may be resolvable (HTTP) or non-resolvable (URN). CIM does not mandate any identification scheme.
Example: https://www.aib-net.org/eecs/T010102 to point to Solar–Photovoltaic–Thin Film.</rdfs:comment>
    <cims:dataType rdf:resource="https://cim.ucaiug.io/ns/eu#URI"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#EnergyResourceType"/>
    <rdfs:label xml:lang="en">technologyRef</rdfs:label>
