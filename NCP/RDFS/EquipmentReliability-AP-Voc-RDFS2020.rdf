  <rdf:Description rdf:about="https://cim4.eu/ns/nc#DCValve.valveU0">
    <rdfs:comment>Represents the threshold or on-state voltage across the valve during conduction. The value is used in conduction loss calculations for converter valves. Approximate valve conduction losses may be calculated using: P_loss ˜ U0 &amp;#215; I
where:
U0 = valve forward voltage (valveU0)
I = valve current
Converter-level losses may be approximated from the combined contribution of associated valves, for example:
P_converter_loss ˜ N &amp;#215; U0 &amp;#215; I
where:
N = number of conducting valves
U0 = valve forward voltage
I = valve current.</rdfs:comment>
    <cims:dataType rdf:resource="#Voltage"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#DCValve"/>
    <rdfs:label xml:lang="en">valveU0</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
