    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#HydroPump.maxOperatingP">
    <rdfs:comment>This is the maximum operating active power limit the dispatcher can enter for this unit.</rdfs:comment>
    <cims:dataType rdf:resource="#ActivePower"/>
    <rdfs:domain rdf:resource="#HydroPump"/>
    <rdfs:label xml:lang="en">maxOperatingP</rdfs:label>
