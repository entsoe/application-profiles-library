    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.PartOf">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The control area that is part of this control area.</rdfs:comment>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#ControlArea.HasPart"/>
    <rdfs:label xml:lang="en">PartOf</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="#ControlArea"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.PowerFrequencyController">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>Power frequency controller for this control area.</rdfs:comment>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#PowerFrequencyController.ControlArea"/>
    <rdfs:label xml:lang="en">PowerFrequencyController</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#PowerFrequencyController"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.SchedulingArea">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>The scheduling area related to a control area.</rdfs:comment>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#SchedulingArea.ControlArea"/>
    <rdfs:label xml:lang="en">SchedulingArea</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..n"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#SchedulingArea"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.SystemOperator">
    <cims:AssociationUsed>Yes</cims:AssociationUsed>
    <rdfs:comment>The system operator that operates this control area.</rdfs:comment>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <cims:inverseRoleName rdf:resource="https://cim4.eu/ns/nc#SystemOperator.ControlArea"/>
    <rdfs:label xml:lang="en">SystemOperator</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#SystemOperator"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlArea.areaType">
    <rdfs:comment>Type of control area.</rdfs:comment>
    <cims:dataType rdf:resource="#String"/>
    <rdfs:domain rdf:resource="#ControlArea"/>
    <rdfs:label xml:lang="en">areaType</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlFunctionBlock.isDiscrete">
    <rdfs:comment>True, if the control function is discrete. This applies to equipment with discrete controls, e.g. tap changers and shunt compensators.</rdfs:comment>
    <cims:dataType rdf:resource="#Boolean"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ControlFunctionBlock"/>
    <rdfs:label xml:lang="en">isDiscrete</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:1..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlFunctionBlock.maxAllowedTargetValue">
    <rdfs:comment>Maximum allowed target value given by the percent of target value.
The allowed value range is [0,100].</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ControlFunctionBlock"/>
    <rdfs:label xml:lang="en">maxAllowedTargetValue</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlFunctionBlock.minAllowedTargetValue">
    <rdfs:comment>Minimum allowed target value given by the percent of target value.
The allowed value range is [0,100].</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ControlFunctionBlock"/>
    <rdfs:label xml:lang="en">minAllowedTargetValue</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#ControlFunctionBlock.targetValueDeadband">
    <rdfs:comment>The deadband related to the targetValue of the control function. It is used with discrete control to avoid excessive update of controls like tap changers and shunt compensator banks while regulating.  The attribute shall be a positive value or zero. If isDiscrete is set to "false", the targetDeadband is to be ignored.
Note that for instance, if the targetValue is 100 kV and the targetValueDeadband is 2 percent the range is from 99 to 101 kV.</rdfs:comment>
    <cims:dataType rdf:resource="#PerCent"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#ControlFunctionBlock"/>
    <rdfs:label xml:lang="en">targetValueDeadband</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <cims:stereotype>NC</cims:stereotype>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#CoordinatedCapacityCalculator.CapacityCalculationRegion">
    <cims:AssociationUsed>No</cims:AssociationUsed>
