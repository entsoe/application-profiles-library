  <rdf:Description rdf:about="https://cim4.eu/ns/nc#MonopolarDCSystem.DCPole">
    <cims:AssociationUsed>No</cims:AssociationUsed>
    <rdfs:comment>DC pole part of the asymmetric DC system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#MonopolarDCSystem"/>
