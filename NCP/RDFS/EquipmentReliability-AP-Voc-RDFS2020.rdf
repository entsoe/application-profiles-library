    <rdfs:label xml:lang="en">DCPole</rdfs:label>
    <cims:multiplicity rdf:resource="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#M:0..1"/>
    <rdfs:range rdf:resource="https://cim4.eu/ns/nc#DCPole"/>
