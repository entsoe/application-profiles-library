  </rdf:Description>
  <rdf:Description rdf:about="https://cim4.eu/ns/nc#FunctionBlock.normalEnabled">
    <rdfs:comment>True, if the function block is normally enabled (active). Otherwise false.</rdfs:comment>
    <cims:dataType rdf:resource="#Boolean"/>
    <rdfs:domain rdf:resource="https://cim4.eu/ns/nc#FunctionBlock"/>
    <rdfs:label xml:lang="en">normalEnabled</rdfs:label>
