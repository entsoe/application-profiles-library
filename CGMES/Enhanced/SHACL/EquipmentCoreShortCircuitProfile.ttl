cc:     rdf:type     owl:Ontology;
        owl:imports  sh:;
        sh:declare   [ rdf:type      sh:PrefixDeclaration;
                       sh:namespace  "http://www.w3.org/1999/02/22-rdf-syntax-ns#";
                       sh:prefix     "rdf"
                     ] .

cc:ClassCount-propertySparql
        rdf:type     sh:SPARQLConstraint;
        sh:message   "The class {?class} appears {?value} times in the data graph.";
        sh:prefixes  cc:;
        sh:select    """ 
            SELECT $this ?class (COUNT(?instance) AS ?value)
            WHERE {
                    ?instance rdf:type ?class .
                   }
            GROUP BY $this ?class
             """ .

cc:ClassCount-property
        rdf:type        sh:PropertyShape;
        sh:description  "Counts instance of classes present in the data graph.";
        sh:group        cc:ClassesCountGroup;
        sh:name         "ClassCount";
        sh:order        1;
        sh:path         rdf:type;
        sh:severity     sh:Info;
        sh:sparql       cc:ClassCount-propertySparql .

cc:ClassCount-node  rdf:type  sh:NodeShape;
        sh:property     cc:ClassCount-property;
        sh:targetClass  md:FullModel , dcat:Dataset .

cc:ClassesCountGroup  rdf:type  sh:PropertyGroup;
        rdfs:label  "ClassesCount";
        sh:order    1 .

eqcs:AllowedClasses-property
        rdf:type        sh:PropertyShape;
        sh:description  "Checks if the dataset contains classes which are not defined in the profile to which this dataset conforms to.";
        sh:group        eqcs:ProfileClassesGroup;
        sh:in           ( cim:DCLineSegment cim:Switch cim:EnergySource cim:FossilFuel cim:AsynchronousMachine cim:GeographicalRegion cim:DCDisconnector cim:PowerTransformerEnd cim:TapChangerControl cim:RegulatingControl cim:Breaker cim:LoadResponseCharacteristic cim:WindGeneratingUnit cim:DCTerminal cim:NuclearGeneratingUnit cim:ControlAreaGeneratingUnit cim:Line cim:RatioTapChanger cim:ACLineSegment cim:DCSeriesDevice cim:DCShunt cim:EnergyConsumer cim:ConformLoad cim:StaticVarCompensator cim:DCLine cim:PhaseTapChangerAsymmetrical cim:HydroPowerPlant cim:LinearShuntCompensator cim:BusbarSection cim:SolarGeneratingUnit cim:ControlArea cim:RatioTapChangerTablePoint cim:BaseVoltage cim:DCNode cim:SubGeographicalRegion cim:PowerTransformer cim:Terminal cim:PhaseTapChangerLinear entsoe:EnergySchedulingType cim:SeriesCompensator cim:VsCapabilityCurve cim:VoltageLevel cim:MutualCoupling cim:EquivalentNetwork cim:ConformLoadSchedule cim:CsConverter cim:HydroGeneratingUnit cim:DCBreaker cim:DCSwitch cim:RatioTapChangerTable cim:NonlinearShuntCompensatorPoint cim:ExternalNetworkInjection cim:PhaseTapChangerTable cim:PerLengthDCLineParameter cim:EquivalentBranch cim:TapChangerTablePoint cim:SynchronousMachine cim:Junction cim:DCChopper cim:ConformLoadGroup cim:PhaseTapChangerTablePoint cim:CurveData cim:GeneratingUnit cim:EquivalentShunt cim:NonConformLoadGroup cim:GroundDisconnector cim:NonConformLoadSchedule cim:DCBusbar cim:CurrentLimit cim:PhaseTapChangerSymmetrical cim:OperationalLimitSet cim:ACDCConverterDCTerminal cim:VoltageLimit cim:VsConverter cim:PhaseTapChangerTabular cim:Disconnector cim:EquivalentInjection cim:BusNameMarker cim:NonlinearShuntCompensator cim:Substation cim:ReportingGroup cim:TieFlow cim:HydroPump cim:OperationalLimitType cim:ReactiveCapabilityCurve cim:ThermalGeneratingUnit cim:GroundingImpedance cim:DCGround cim:DCEquipmentContainer cim:Ground cim:NonConformLoad cim:DCConverterUnit cim:LoadBreakSwitch cim:PetersenCoil md:FullModel dm:DifferenceModel dcat:Dataset );
        sh:message      "This class is not part of the profile to which this dataset conforms to.";
        sh:name         "ClassNotInProfile";
        sh:order        1;
        sh:path         rdf:type;
        sh:severity     sh:Info .

eqcs:AllowedClasses-node
        rdf:type             sh:NodeShape;
        sh:property          eqcs:AllowedClasses-property;
        sh:targetSubjectsOf  rdf:type .

eqcs:ProfilePropertiesGroup
        rdf:type    sh:PropertyGroup;
        rdfs:label  "ProfileProperties";
        sh:order    1 .

eqcs:AssociationsGroup  rdf:type  sh:PropertyGroup;
        rdfs:label  "Associations";
        sh:order    2 .

